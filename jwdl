# Resolved once at startup by main() -> _jwkit_common.resolve_color_enabled.
COLOR = _jwkit_common.Colorizer(False)

# Resolved once at startup by main()/run_periodicals/run_video, from the
# shared jwkit config plus this run's --on-exists/--on-exists-unattended/
# --overwrite-timeout overrides if any - download_track/download_periodical_file/
# download_video read this directly rather than threading it through every
# call site (they can run concurrently across a ThreadPoolExecutor).
JWKIT_CONFIG = None


def _apply_overwrite_overrides(args):
    config = _jwkit_common.load_jwkit_config()
    for arg_name, config_key in (("on_exists", "on_output_exists"), ("on_exists_unattended", "on_output_exists_unattended"), ("overwrite_timeout", "overwrite_prompt_timeout")):
        value = getattr(args, arg_name, None)
        if value is not None:
            config[config_key] = value
    return config


def _add_overwrite_args(parser):
    parser.add_argument("--on-exists", choices=["ask", "overwrite", "rename", "trash", "fail"], help="Override on_output_exists for this run")
    parser.add_argument("--on-exists-unattended", choices=["overwrite", "rename", "trash", "fail"], help="Override on_output_exists_unattended for this run")
    parser.add_argument("--overwrite-timeout", type=float, help="Seconds to wait for an 'ask' answer before falling back")


def migrate_legacy_config_dir():
    """One-time move from the pre-unification ~/.config/maj-scripts/jwdl
    location to ~/.config/jwkit/jwdl now that all jwkit tools share one
    config namespace."""
    if _LEGACY_CONFIG_DIR.exists() and not CONFIG_DIR.exists():
        CONFIG_DIR.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(_LEGACY_CONFIG_DIR), str(CONFIG_DIR))
        print(f"Moved your existing settings from {_LEGACY_CONFIG_DIR} to {CONFIG_DIR}.")

DEFAULT_BASE_DIR = Path.home() / "Music" / "Watchtower Music"
DEFAULT_PERIODICALS_BASE_DIR = Path.home() / "Documents" / "JW Periodicals"
DEFAULT_VIDEO_BASE_DIR = Path.home() / "Videos" / "JW Videos"
AUDIO_DESC_SUFFIX = "(With Audio Descriptions)"
API_URL = "https://b.jw-cdn.org/apis/pub-media/GETPUBMEDIALINKS"
VIDEO_CATEGORY_API_URL = "https://data.jw-api.org/mediator/v1/categories"
USER_AGENT = "jwdl (jwkit; https://github.com/majal/jwkit)"
REQUEST_TIMEOUT = 30
MAX_ATTEMPTS = 3
RETRY_BACKOFF = 2
DEFAULT_VIDEO_RESOLUTION = "720p"

# periodical pub code -> folder name. Absorbed from the old standalone
# jwget script. Only 'w' (Watchtower Study Edition) and 'mwb' (meeting
# workbook) are included - jwget also carried 'wp' (Watchtower Public
# Edition) and 'g' (Awake!), but jw.org's own pub-media API 404s on both
# of those regardless of issue: jw.org discontinued them as separate
# monthly periodicals years ago, so there's nothing left to port for them.
PERIODICALS = {
    "w": "Watchtower (Study Edition)",
    "mwb": "Life and Ministry Meeting Workbook",
}

# pub code -> folder name under the base music dir.
# Folder names intentionally match years of prior downloads byte-for-byte
# (curly quotes, em dashes) so re-running against an existing library never
# creates a second, differently-named copy of the same collection.
PUBS = {
    "osg": "Original Songs",
    "pkon": "Become Jehovah’s Friend—Songs",
    "sjjm": "“Sing out Joyfully”—Meetings",
    "sjjc": "“Sing out Joyfully”—Vocals",
    "sjji": "“Sing out Joyfully”—Instrumentals",
    "pksjj": "“Sing out Joyfully”—Children",
    "cywst": "“Commit Your Way to Jehovah”—Soundtrack",
    "gnjst1": "The Good News According to Jesus—Soundtrack 1",
    "gnjst2": "The Good News According to Jesus—Soundtrack 2",
    "gnjst3": "The Good News According to Jesus—Soundtrack 3",
    "imc": "International Music",
}

ILLEGAL_CHARS_RE = re.compile(r'[<>:"/\\|?*]')
LEADING_DOT_RE = re.compile(r"^[^.]+")


def echo_y(msg):
    print(COLOR.yellow(msg))


def echo_g(msg):
    print(COLOR.green(msg))


def echo_r(msg):
    print(COLOR.red(msg))


def load_config():
    config = {"base_dir": str(DEFAULT_BASE_DIR), "pubs": {}, "workers": 4}
    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE) as f:
                user_config = json.load(f)
            config.update({k: v for k, v in user_config.items() if k != "pubs"})
            config["pubs"] = user_config.get("pubs", {})
        except (json.JSONDecodeError, OSError) as e:
            echo_r(f"Warning: could not read {CONFIG_FILE}: {e}")
    return config


def resolve_pubs(config):
    """Built-in pubs plus any extra {pub_code: folder_name} from config,
    so a newly-released JW music group can be added without a code change."""
    pubs = dict(PUBS)
    pubs.update(config.get("pubs", {}))
    return pubs


def format_title(title):
    # Mirror the original bash sed pipeline exactly, so filenames for
    # already-downloaded tracks keep matching (straight quotes -> curly).
    title = title.replace("'", "’")
    if title.startswith('"'):
        title = "“" + title[1:]
    title = title.replace('. "', '. “')
    if title.endswith('"'):
        title = title[:-1] + "”"
    return title


def sanitize(name):
    return ILLEGAL_CHARS_RE.sub("_", name)


def build_filename(url, title):
    base_match = LEADING_DOT_RE.match(os.path.basename(url))
    base = base_match.group(0) if base_match else os.path.basename(url)
    raw = f"{base} ({format_title(title)}).mp3"
    return sanitize(raw)


def is_audio_description(title):
    return title.endswith(AUDIO_DESC_SUFFIX)


def fetch_pub_media(pub, lang):
    url = f"{API_URL}?output=json&pub={pub}&fileformat=MP3%2CAAC&alllangs=0&langwritten={lang}"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    last_err = None
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
                data = json.load(resp)
            if isinstance(data, list):
                reason = data[0].get("title", "unknown error") if data else "empty response"
                raise ValueError(f"pub '{pub}' not found ({reason})")
            files = data.get("files", {}).get(lang, {}).get("MP3", [])
            return files
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
            last_err = e
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    raise RuntimeError(f"Failed to fetch media list for pub '{pub}': {last_err}")


DOWNLOAD_CHUNK_SIZE = 1024 * 1024

def download_with_retry(url, dest_path, expected_checksum=None):
    """Stream `url` to `dest_path` via a `.part` temp file (atomically
    renamed on success), retrying up to MAX_ATTEMPTS times with backoff.
    Hashes incrementally while streaming rather than writing the whole
    response then re-reading the whole file to checksum it - jwdl video
    downloads can run several hundred MB to multi-GB, and this used to
    peak near 2x the file size in memory (once for the write, again for
    the checksum) on the same host that runs 'jwdl all' unattended weekly.
    Returns None on success, or an error message string on final failure."""
    tmp_path = dest_path.with_suffix(dest_path.suffix + ".part")
    last_error = None
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            digest = hashlib.md5() if expected_checksum else None
            req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
            with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp, open(tmp_path, "wb") as f:
                while True:
                    chunk = resp.read(DOWNLOAD_CHUNK_SIZE)
                    if not chunk:
                        break
                    f.write(chunk)
                    if digest is not None:
                        digest.update(chunk)
            if digest is not None and digest.hexdigest() != expected_checksum:
                raise ValueError(f"checksum mismatch (got {digest.hexdigest()}, expected {expected_checksum})")
            os.replace(tmp_path, dest_path)
            return None
        except Exception as e:
            tmp_path.unlink(missing_ok=True)
            last_error = e
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    return str(last_error)


def _resolve_existing_download(dest_path, expected_size, dry_run):
    """Shared by download_track/download_periodical_file/download_video, all
    of which repeat this same check: a same-sized existing file needs no
    work at all (not an overwrite scenario); a differently-sized one is
    about to be silently clobbered by a fresh download, so it goes through
    the shared on_output_exists policy instead. Returns ("skip", status) to
    short-circuit the caller with that status, or ("proceed", dest_path)
    with dest_path possibly updated by a rename policy. Note: these
    downloads can run concurrently across a ThreadPoolExecutor, so an
    on_output_exists=ask policy may show interleaved prompts for the rare
    case of multiple mismatched files in one run - a real but acceptable
    rough edge given how uncommon a size mismatch actually is."""
    if dest_path.exists():
        if expected_size is None or dest_path.stat().st_size == expected_size:
            return "skip", "skipped-exists"
        if not dry_run:
            resolved = _jwkit_common.resolve_output_conflict(dest_path, JWKIT_CONFIG or _jwkit_common.load_jwkit_config())
            if resolved is None:
                return "skip", "skipped-exists"
            dest_path = resolved
    if dry_run:
        return "skip", "would-download"
    return "proceed", dest_path


def download_track(entry, dest_dir, dry_run, include_audio_descriptions):
    title = entry.get("title", "")
    if not include_audio_descriptions and is_audio_description(title):
        return "skipped-ad", title

    file_info = entry.get("file", {})
    url = file_info.get("url", "")
    if not url.lower().endswith(".mp3"):
        return "skipped-format", title

    filename = build_filename(url, title)
    dest_path = dest_dir / filename
    expected_size = entry.get("filesize")

    action, result = _resolve_existing_download(dest_path, expected_size, dry_run)
    if action == "skip":
        return result, filename
    dest_path = result
    filename = dest_path.name  # may have changed under an on_output_exists=rename policy

    expected_checksum = file_info.get("checksum")
    error = download_with_retry(url, dest_path, expected_checksum)
    if error:
        return "error", f"{filename}: {error}"
    return "downloaded", filename


def download_pub(pub, dest_dir, lang, dry_run, include_audio_descriptions, workers):
    echo_y(f"Processing pub: {pub}, lang: {lang} ...")
    entries = fetch_pub_media(pub, lang)
    dest_dir.mkdir(parents=True, exist_ok=True)

    counts = {}
    errors = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = [
            pool.submit(download_track, entry, dest_dir, dry_run, include_audio_descriptions)
            for entry in entries
        ]
        for future in concurrent.futures.as_completed(futures):
            status, detail = future.result()
            counts[status] = counts.get(status, 0) + 1
            if status == "downloaded":
                echo_g(f"  downloaded: {detail}")
            elif status == "would-download":
                print(f"  would download: {detail}")
            elif status == "error":
                errors.append(detail)
                echo_r(f"  error: {detail}")

    summary = ", ".join(f"{v} {k}" for k, v in sorted(counts.items()))
    print(f"  {pub}: {summary or 'nothing to do'}")
    return errors


def cmd_list(pubs):
    print("Available pub codes:\n")
    for code, folder in pubs.items():
        print(f"  {code:<8} {folder}")
    print("\n  all      download all of the above")
    print("\nLooking for periodicals (Watchtower, meeting workbook)? See 'jwdl periodicals list'.")
    print("Looking for videos? See 'jwdl video'.")


# --- Periodicals (jwdl periodicals ...) ---
def issue_range(months):
    """Current month plus (months - 1) months ahead, as YYYYMM strings -
    matches the old jwget's "current + next 4" default (months=5)."""
    today = date.today()
    issues = []
    for i in range(months):
        total = today.month - 1 + i
        year = today.year + total // 12
        month = total % 12 + 1
        issues.append(f"{year:04d}{month:02d}")
    return issues


def fetch_periodical_media(pub, lang, issue):
    """Returns (files, None) on success, or (None, reason) when this issue
    isn't published (e.g. a future issue not out yet) - not an error."""
    url = f"{API_URL}?output=json&pub={pub}&fileformat=PDF&alllangs=0&langwritten={lang}&issue={issue}"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    last_err = None
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
                data = json.load(resp)
            if isinstance(data, list):
                reason = data[0].get("title", "unknown error") if data else "empty response"
                return None, reason
            return data.get("files", {}).get(lang, {}).get("PDF", []), None
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
            last_err = e
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    raise RuntimeError(f"Failed to fetch '{pub}' issue {issue}: {last_err}")


def download_periodical_file(entry, dest_dir, dry_run, include_large_print):
    if not include_large_print and entry.get("format") == "lp":
        return "skipped-lp", entry.get("editionDescr", "Large Print")

    file_info = entry.get("file", {})
    url = file_info.get("url", "")
    filename = sanitize(os.path.basename(url))
    dest_path = dest_dir / filename
    expected_size = entry.get("filesize")

    action, result = _resolve_existing_download(dest_path, expected_size, dry_run)
    if action == "skip":
        return result, filename
    dest_path = result
    filename = dest_path.name  # may have changed under an on_output_exists=rename policy

    expected_checksum = file_info.get("checksum")
    error = download_with_retry(url, dest_path, expected_checksum)
    if error:
        return "error", f"{filename}: {error}"
    return "downloaded", filename


def download_periodical(pub, dest_dir, lang, months, dry_run, include_large_print):
    name = PERIODICALS[pub]
    echo_y(f"Processing periodical: {pub} ({name}), lang: {lang} ...")
    dest_dir.mkdir(parents=True, exist_ok=True)

    counts = {}
    errors = []
    for issue in issue_range(months):
        files, not_published = fetch_periodical_media(pub, lang, issue)
        if files is None:
            counts["not-yet-published"] = counts.get("not-yet-published", 0) + 1
            continue
        for entry in files:
            status, detail = download_periodical_file(entry, dest_dir, dry_run, include_large_print)
            counts[status] = counts.get(status, 0) + 1
            if status == "downloaded":
                echo_g(f"  downloaded: {detail}")
            elif status == "would-download":
                print(f"  would download: {detail}")
            elif status == "error":
                errors.append(detail)
                echo_r(f"  error: {detail}")

    summary = ", ".join(f"{v} {k}" for k, v in sorted(counts.items()))
    print(f"  {pub}: {summary or 'nothing to do'}")
    return errors


def cmd_periodicals_list():
    print("Available periodical codes:\n")
    for code, name in PERIODICALS.items():
        print(f"  {code:<8} {name}")
    print("\n  all      download all of the above")


def run_periodicals(argv, config):
    parser = argparse.ArgumentParser(
        prog="jwdl periodicals",
        description="Download JW periodicals (PDF): the Watchtower Study Edition and the meeting workbook",
    )
    parser.add_argument("code", nargs="?", help="periodical code (see 'jwdl periodicals list'), or 'all'")
    parser.add_argument("lang", nargs="?", default="E", help="language code (default: E)")
    parser.add_argument("--months", type=int, default=5, help="how many issues to fetch starting this month (default: 5)")
    parser.add_argument("--include-large-print", action="store_true", help="also download the large-print edition where available")
    parser.add_argument("--dir", type=Path, help="override the destination directory for a single periodical")
    parser.add_argument("--base-dir", type=Path, help="override the base periodicals directory")
    parser.add_argument("--dry-run", action="store_true", help="show what would be downloaded without downloading")
    _add_overwrite_args(parser)
    args = parser.parse_args(argv)
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)

    global JWKIT_CONFIG
    JWKIT_CONFIG = _apply_overwrite_overrides(args)

    base_dir = args.base_dir or Path(config.get("periodicals_base_dir", str(DEFAULT_PERIODICALS_BASE_DIR)))

    if not args.code or args.code == "list":
        cmd_periodicals_list()
        return 0

    if args.code != "all" and args.code not in PERIODICALS:
        echo_r(f"Unknown periodical code: {args.code}\n")
        cmd_periodicals_list()
        return 2

    targets = list(PERIODICALS.items()) if args.code == "all" else [(args.code, PERIODICALS[args.code])]

    all_errors = []
    for pub, name in targets:
        dest_dir = args.dir if (args.dir and len(targets) == 1) else base_dir / name
        errors = download_periodical(pub, dest_dir, args.lang, args.months, args.dry_run, args.include_large_print)
        all_errors.extend(errors)
        print()

    if all_errors:
        echo_r(f"Finished with {len(all_errors)} error(s).")
        return 1

    echo_g("Done.")
    return 0


# --- Video (jwdl video ...) ---
def fetch_video_category(category, lang):
    """Returns the category dict (with 'media' and/or 'subcategories') on
    success, or None if the category key doesn't exist. jw.org's video
    catalog is a tree: some categories hold videos directly (e.g.
    LatestVideos), others are just folders of subcategories (e.g.
    VideoOnDemand itself) - the caller decides what to do with an empty
    'media' list based on whether 'subcategories' has anything."""
    url = f"{VIDEO_CATEGORY_API_URL}/{lang}/{category}?detailed=1&mediaLimit=0&clientType=www"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    last_err = None
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
                data = json.load(resp)
            if isinstance(data, list):
                return None  # e.g. [{"title": "Not Found", "status": 404}]
            return data.get("category", {})
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None  # unlike pub-media, this API 404s for real instead of returning an error-shaped 200
            last_err = e
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
        except (urllib.error.URLError, json.JSONDecodeError, TimeoutError) as e:
            last_err = e
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    raise RuntimeError(f"Failed to fetch video category '{category}': {last_err}")


def pick_video_rendition(files, resolution):
    """Picks the file matching `resolution` (e.g. '720p') if available,
    else the closest one at or below it, else the smallest available -
    not every video has every rendition, and jw.org's own labels
    ('144p'..'1080p') aren't guaranteed present across all of them."""
    video_files = [f for f in files if f.get("mimetype", "").startswith("video/")]
    if not video_files:
        return None

    def height(f):
        try:
            return int(str(f.get("label", "0p")).rstrip("p"))
        except ValueError:
            return 0

    exact = [f for f in video_files if f.get("label") == resolution]
    if exact:
        return exact[0]

    try:
        target = int(str(resolution).rstrip("p"))
    except ValueError:
        target = 720
    video_files.sort(key=height)
    at_or_below = [f for f in video_files if height(f) <= target]
    return at_or_below[-1] if at_or_below else video_files[0]


def download_video(entry, dest_dir, resolution, dry_run):
    title = entry.get("title", "")
    file_entry = pick_video_rendition(entry.get("files", []), resolution)
    if not file_entry:
        return "skipped-no-file", title

    url = file_entry.get("progressiveDownloadURL", "")
    filename = sanitize(os.path.basename(url))
    dest_path = dest_dir / filename
    expected_size = file_entry.get("filesize")

    action, result = _resolve_existing_download(dest_path, expected_size, dry_run)
    if action == "skip":
        return result, filename
    dest_path = result
    filename = dest_path.name  # may have changed under an on_output_exists=rename policy

    expected_checksum = file_entry.get("checksum")
    error = download_with_retry(url, dest_path, expected_checksum)
    if error:
        return "error", f"{filename}: {error}"
    return "downloaded", filename


def run_video(argv, config):
    parser = argparse.ArgumentParser(
        prog="jwdl video",
        description="Browse and download JW videos by category from jw.org",
    )
    parser.add_argument(
        "category", nargs="?", default="VideoOnDemand",
        help="Category key (default: VideoOnDemand, the top-level browser). "
             "If the category holds videos, downloads them; if it's just a folder "
             "of subcategories (like VideoOnDemand itself), lists them instead.",
    )
    parser.add_argument("lang", nargs="?", default="E", help="language code (default: E)")
    parser.add_argument("--resolution", default=DEFAULT_VIDEO_RESOLUTION, help=f"target resolution: 144p/240p/360p/480p/720p/1080p when available (default: {DEFAULT_VIDEO_RESOLUTION}; falls back to the closest available)")
    parser.add_argument("--dir", type=Path, help="override the destination directory")
    parser.add_argument("--base-dir", type=Path, help="override the base video directory")
    parser.add_argument("--dry-run", action="store_true", help="show what would be downloaded without downloading")
    _add_overwrite_args(parser)
    args = parser.parse_args(argv)
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)

    global JWKIT_CONFIG
    JWKIT_CONFIG = _apply_overwrite_overrides(args)

    base_dir = args.base_dir or Path(config.get("video_base_dir", str(DEFAULT_VIDEO_BASE_DIR)))

    cat = fetch_video_category(args.category, args.lang)
    if cat is None:
        echo_r(f"Unknown video category: {args.category}\n")
        print("Run 'jwdl video' with no category to browse from the top (VideoOnDemand).")
        return 2

    name = cat.get("name", args.category)
    media = cat.get("media", [])
    subcategories = cat.get("subcategories", [])

    if not media:
        # A container category (or a genuinely empty one) - browse instead
        # of trying to download nothing.
        print(f"{name} ({args.category}):\n")
        if subcategories:
            print("Subcategories:")
            for sub in subcategories:
                print(f"  {sub['key']:<24} {sub['name']}")
            print(f"\nRun 'jwdl video <key>' to go into one of these.")
        else:
            print("(no videos or subcategories found here)")
        return 0

    dest_dir = args.dir or (base_dir / name)
    echo_y(f"Processing video category: {args.category} ({name}), lang: {args.lang} ...")
    dest_dir.mkdir(parents=True, exist_ok=True)

    counts = {}
    errors = []
    for entry in media:
        status, detail = download_video(entry, dest_dir, args.resolution, args.dry_run)
        counts[status] = counts.get(status, 0) + 1
        if status == "downloaded":
            echo_g(f"  downloaded: {detail}")
        elif status == "would-download":
            print(f"  would download: {detail}")
        elif status == "error":
            errors.append(detail)
            echo_r(f"  error: {detail}")

    summary = ", ".join(f"{v} {k}" for k, v in sorted(counts.items()))
    print(f"  {args.category}: {summary or 'nothing to do'}")

    if errors:
        echo_r(f"Finished with {len(errors)} error(s).")
        return 1

    echo_g("Done.")
    return 0


def main():
    global COLOR
    # Filtered out of sys.argv (rather than registered on a parser) since
    # 'periodicals'/'video' below dispatch to their own sub-parsers off raw
    # sys.argv slices before any single top-level parser ever sees them -
    # this way both flags work regardless of which command family runs.
    color_override = None
    if "--no-color" in sys.argv:
        sys.argv.remove("--no-color")
        color_override = False
    elif "--color" in sys.argv:
        sys.argv.remove("--color")
        color_override = True
    COLOR = _jwkit_common.Colorizer(_jwkit_common.resolve_color_enabled(_jwkit_common.load_jwkit_config(), cli_override=color_override))

    migrate_legacy_config_dir()
    config = load_config()

    # 'periodicals' and 'video' are separate command families (different
    # content types/API shapes) rather than being folded into the same
    # 'pub'/'all' positional, so plain 'jwdl all' (the one emeth4's weekly
    # systemd timer calls) keeps meaning exactly what it always has: all
    # configured music.
    if len(sys.argv) > 1 and sys.argv[1] == "periodicals":
        sys.exit(run_periodicals(sys.argv[2:], config))
    if len(sys.argv) > 1 and sys.argv[1] == "video":
        sys.exit(run_video(sys.argv[2:], config))

    parser = argparse.ArgumentParser(description="jwdl - download JW music (MP3), periodicals (PDF), and videos to a local library")
    parser.add_argument("pub", nargs="?", help="pub code (see 'jwdl list'), or 'all' - or 'periodicals'/'video' for other content types")
    parser.add_argument("lang", nargs="?", default="E", help="language code (default: E)")
    parser.add_argument("--dir", type=Path, help="override the destination directory for a single pub")
    parser.add_argument("--base-dir", type=Path, help="override the base Watchtower Music directory")
    parser.add_argument(
        "--include-audio-descriptions",
        action="store_true",
        help="also download the audio-description ('for the blind') variants, excluded by default",
    )
    parser.add_argument("--dry-run", action="store_true", help="show what would be downloaded without downloading")
    parser.add_argument("--workers", type=int, help="parallel downloads per pub (default: 4)")
    parser.add_argument("--color", action="store_true", help="force colored output for this run (works with 'periodicals'/'video' too - already applied before this parser runs)")
    parser.add_argument("--no-color", action="store_true", help="disable colored output for this run (works with 'periodicals'/'video' too - already applied before this parser runs)")
    _add_overwrite_args(parser)
    args = parser.parse_args()
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)

    global JWKIT_CONFIG
    JWKIT_CONFIG = _apply_overwrite_overrides(args)

    pubs = resolve_pubs(config)
    base_dir = args.base_dir or Path(config["base_dir"])
    workers = args.workers or config.get("workers", 4)

    if not args.pub or args.pub == "list":
        cmd_list(pubs)
        return 0

    if args.pub != "all" and args.pub not in pubs:
        echo_r(f"Unknown pub code: {args.pub}\n")
        cmd_list(pubs)
        return 2

    targets = list(pubs.items()) if args.pub == "all" else [(args.pub, pubs[args.pub])]

    all_errors = []
    for pub, folder in targets:
        dest_dir = args.dir if (args.dir and len(targets) == 1) else base_dir / folder
        errors = download_pub(pub, dest_dir, args.lang, args.dry_run, args.include_audio_descriptions, workers)
        all_errors.extend(errors)
        print()

    if all_errors:
        echo_r(f"Finished with {len(all_errors)} error(s).")
        return 1

    echo_g("Done.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
