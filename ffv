#!/usr/bin/env python3
"""Compact launcher for slverse.

All verse lookup, playback, encoding, and configuration stays in slverse.
"""
from __future__ import annotations

import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _jwkit_common


USAGE = """usage: ffv <lang|any> <Bible reference> [slverse extract options]
       ffv all <Bible reference> [--list-only|-l] [--verbose|-v]

Examples:
  ffv FSL Rev 21:1-3
  ffv BVL,FSL 1 Peter 2:23 -fi
  ffv any 1 Sa-mu-en 2:12-17
  ffv all Ge 10:2               (lists matches and previews each one)
  ffv all Ge 10:2 -l            (lists matches only)

Run 'slverse extract --help' and
'slverse find --help' for the complete option set.
"""

PASSTHROUGH_COMMANDS = {"setup", "config", "langs", "sync", "extract", "find", "cache", "inspect", "benchmark", "bulk"}


def slverse_path() -> str:
    sibling = Path(__file__).resolve().with_name("slverse")
    if sibling.is_file():
        return str(sibling)
    found = shutil.which("slverse")
    if found and Path(found).resolve() != Path(__file__).resolve():
        return found
    raise SystemExit("ffv: cannot find slverse beside ffv or on PATH")


def split_all_reference(tokens: list[str]) -> tuple[list[str], list[str]]:
    """Split only at the first option and pass the entire option tail on.

    This deliberately does not maintain a second copy of slverse's option
    schema: options may take values now or in the future, and ffv must not
    mistake those values for words in the Bible reference.
    """
    split = next((i for i, token in enumerate(tokens) if token.startswith("-") and token != "-"), len(tokens))
    words, flags = tokens[:split], tokens[split:]
    match = re.fullmatch(r"(.+?)\s+(\d+):(.+)", " ".join(words).strip())
    if not match:
        raise SystemExit("ffv all: use a reference such as 'Ge 10:2' or '1 Sa-mu-en 2:12-17'")
    return [match.group(1), match.group(2), match.group(3)], flags


def main(argv: list[str]) -> None:
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)
    if not argv or argv[0] in {"-h", "--help"}:
        print(USAGE)
        return
    if argv[0] in PASSTHROUGH_COMMANDS:
        raise SystemExit(subprocess.call([sys.executable, slverse_path(), *argv]))
    if argv[0].casefold() == "all":
        reference, flags = split_all_reference(argv[1:])
        raise SystemExit(subprocess.call([sys.executable, slverse_path(), "find", *reference, *flags]))
    raise SystemExit(subprocess.call([sys.executable, slverse_path(), "extract", *argv]))


if __name__ == "__main__":
    main(sys.argv[1:])
