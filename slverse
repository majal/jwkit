# --- Config Management ---
def load_config():
    config = DEFAULT_CONFIG.copy()
    if not CONFIG_FILE.exists():
        return config
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or line.startswith("["):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("'").strip('"')
                    config[k] = v
    except Exception as e:
        print(f"Warning: could not parse config: {e}")
    return config

def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        for k, v in config.items():
            f.write(f'{k} = "{v}"\n')

def get_state():
    """Small, fast-loading state: sync timestamps, cache-access bookkeeping,
    and cached book-name metadata. Per-language verse/marker indexes live in
    INDEX_DIR instead (see load_index/save_index) so state.json doesn't grow
    to tens of megabytes as more languages get synced."""
    if not STATE_FILE.exists():
        return {}
    try:
        with open(STATE_FILE, "r") as f:
            state = json.load(f)
    except Exception:
        return {}

    legacy_langs = [k for k in state if not k.startswith("_")]
    if legacy_langs:
        print(f"One-time migration: moving {len(legacy_langs)} language index(es) out of state.json into {INDEX_DIR}/")
        for lang in legacy_langs:
            entries = state.pop(lang)
            existing = load_index(lang)
            existing.update(entries)
            save_index(lang, existing)
        save_state(state)

    return state

def save_state(state):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

def load_index(lang):
    path = INDEX_DIR / f"{lang}.json"
    if not path.exists():
        return {}
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def save_index(lang, entries):
    INDEX_DIR.mkdir(parents=True, exist_ok=True)
    with open(INDEX_DIR / f"{lang}.json", "w") as f:
        json.dump(entries, f, indent=2)

def synced_languages():
    """Languages with an on-disk index, for commands like 'find' that search
    across everything already synced rather than just the configured list."""
    if not INDEX_DIR.exists():
        return []
    return sorted(p.stem for p in INDEX_DIR.glob("*.json"))

def load_jwlangs():
    try:
        with open(JWLANGS_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def lang_display(code, jwlangs=None):
    jwlangs = jwlangs if jwlangs is not None else load_jwlangs()
    entry = jwlangs.get(code.upper())
    return f"{code.upper()} ({entry[1]})" if entry else code.upper()

def parse_kv_config(value):
    """'KEY=VAL,KEY2=VAL2' -> {KEY: val, KEY2: val2} (keys upper-cased,
    values lower-cased) - the small-table shape used by config values like
    sign_lang_ref_language. Blank/malformed pairs are skipped rather than
    raising, since this reads straight from a hand-edited config file."""
    result = {}
    for pair in (value or "").split(","):
        pair = pair.strip()
        if not pair or "=" not in pair:
            continue
        k, v = pair.split("=", 1)
        k = k.strip().upper()
        if k:
            result[k] = v.strip().lower()
    return result

def get_lang_list(config, lang_arg=None):
    """Resolve a language argument to a list of codes.
    'all' or None uses the configured language list; a comma list is split;
    anything else is a single code."""
    if lang_arg and lang_arg.lower() != "all":
        parts = lang_arg.split(",")
    else:
        parts = config.get("languages", DEFAULT_CONFIG["languages"]).split(",")
    return [p.strip().upper() for p in parts if p.strip()]

# --- System Check & Setup ---
def command_exists(cmd):
    return shutil.which(cmd) is not None

def focus_process(pid):
    """macOS-only: activate a just-launched GUI process by pid via System
    Events. mpv and ffplay are both bare CLI binaries there (no signed
    .app bundle), so launching either from a background terminal process
    doesn't get the NSApplication activation a Dock/Finder launch would.
    A short retry loop covers the moment between process start and the
    window registering with the WindowServer - the very first attempt
    typically fails simply because the window doesn't exist yet."""
    if platform.system() != "Darwin":
        return
    script = f'tell application "System Events" to set frontmost of (first process whose unix id is {pid}) to true'
    for attempt in range(5):
        if attempt:
            time.sleep(0.3)
        result = subprocess.run(["osascript", "-e", script], capture_output=True)
        if result.returncode == 0:
            return

def launch_mpv(args, wait=True, fullscreen=True, keep_open=True, paused=False, geometry=None, autofit=None, config=None):
    """Spawn mpv with `args` and try to bring it to the front on every OS.
    --force-window=immediate plus mpv's own --focus-on=open default (mpv
    0.34+) cover Linux/Windows window managers reasonably well; see
    focus_process for the macOS-specific piece.

    keep_open=True (the default) means the window sits on the last frame
    instead of closing itself once playback ends, so you can seek back and
    review it - matches mpv's own factory default; the old --no-keep-open
    here was old ffv's choice, not something we need to keep. fullscreen/
    paused/geometry/autofit are the extra knobs cmd_find's multi-language
    --play uses to open several matches windowed, paused, sized, and
    cascaded instead of each one grabbing the whole screen in turn.
    autofit is an mpv --autofit value (e.g. "65%") - a percentage of the
    screen, aspect-ratio preserved, so we don't need to know the actual
    screen resolution ourselves; geometry positions the window and is
    offset-only here (e.g. "+40+40"), leaving sizing to autofit.

    --no-config above means a personal mpv.conf (e.g. one that already
    disables the mouse-hover on-screen controller) never applies to windows
    slverse opens - pass `config` so the mpv_show_osc setting (default true,
    matching stock mpv) can add --osc=no back in per-user, without changing
    the default for anyone who hasn't set it."""
    cmd = ["mpv", "--no-config", "--force-window=immediate"]
    cmd.append("--fullscreen=yes" if fullscreen else "--fullscreen=no")
    cmd.append("--keep-open=yes" if keep_open else "--no-keep-open")
    if config is not None and str(config.get("mpv_show_osc", DEFAULT_CONFIG["mpv_show_osc"])).strip().lower() == "false":
        cmd.append("--osc=no")
    if paused:
        cmd.append("--pause")
    if autofit:
        cmd.append(f"--autofit={autofit}")
    if geometry:
        cmd.append(f"--geometry={geometry}")
    cmd += list(args)
    proc = subprocess.Popen(cmd)
    focus_process(proc.pid)
    if wait:
        proc.wait()
    return proc

def launch_ffplay(args, wait=True):
    """Same idea as launch_mpv but for ffplay, used by the default preview
    path (see preview_verse) - ffplay is SDL-based and usually grabs focus
    fine on its own, but macOS's bare-CLI-binary activation gap applies to
    it exactly the same way it does to mpv. No -autoexit: the window sits
    on the last frame instead of closing itself, so you can seek back
    (left/right arrow, etc - ffplay's own default keys) and review it;
    close the window yourself (q, or the window close button) when done."""
    cmd = [FFPLAY_BIN, "-hide_banner", "-loglevel", "error"] + list(args)
    proc = subprocess.Popen(cmd)
    focus_process(proc.pid)
    if wait:
        proc.wait()
    return proc

def detect_hardware_encoder():
    """Defaults to 'cpu' (libx264) everywhere. Measured directly on this
    machine's Apple Silicon GPU for a 31s 720p verse clip: videotoolbox at
    the quality setting matching crf 20 produced an 8.0MB file (SSIM
    0.99786 against the source), while libx264 crf 20 preset slow produced
    a 3.1MB file - close to the 2.9MB source itself - at SSIM 0.99752,
    a difference too small to see. Encode time was nearly identical either
    way (3.6s vs 3.0s for that clip) - GPU's speed advantage isn't
    meaningful at these short clip lengths, so there's no real tradeoff:
    CPU gets a ~2.6x smaller file for immeasurably different quality.
    Matching bitrate explicitly (700kbps VBR) instead of crf made GPU
    *worse* than CPU at the same size (SSIM 0.99633 vs 0.99723) - x264's
    rate-distortion efficiency beats videotoolbox's at a fixed bitrate too.
    videotoolbox/nvenc remain available via 'slverse config set
    hardware_encoder videotoolbox' for anyone who wants GPU speed for bulk
    processing many chapters, where CPU's per-clip cost adds up."""
    return "cpu"

def ffmpeg_has_filter(ffmpeg_bin, filter_name):
    try:
        result = subprocess.run([ffmpeg_bin, "-hide_banner", "-filters"], capture_output=True, text=True, timeout=10)
        return filter_name in result.stdout
    except Exception:
        return False

def resolve_ffmpeg_binary(config):
    override = config.get("ffmpeg_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffmpeg-full"),
        *[p for p in FFMPEG_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffmpeg"),
    ] if c]
    for c in candidates:
        if ffmpeg_has_filter(c, "drawtext"):
            return c
    return candidates[0] if candidates else "ffmpeg"

def resolve_ffplay_binary(config):
    override = config.get("ffplay_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [shutil.which("ffplay-full"), shutil.which("ffplay")] if c]
    return candidates[0] if candidates else "ffplay"

def resolve_ffprobe_binary(config):
    override = config.get("ffprobe_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffprobe-full"),
        *[p for p in FFPROBE_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffprobe"),
    ] if c]
    return candidates[0] if candidates else "ffprobe"

_FFRIFE_MODULE = None

def load_ffrife():
    """Import the sibling `ffrife` script as a module (same pattern
    tests/support.py uses to load slverse itself). RIFE interpolation isn't
    Bible/JW-specific, so it lives in its own standalone, reusable tool
    (ffrife) instead of being duplicated here - other tools (ffslow's --ai
    flag) share the exact same RIFE install/interpolation logic this way.
    Cached at module level so repeated extract calls (e.g. multi-language
    ThreadPoolExecutor runs) don't re-parse/re-exec the script each time."""
    global _FFRIFE_MODULE
    if _FFRIFE_MODULE is None:
        script_path = Path(__file__).resolve().parent / "ffrife"
        loader = SourceFileLoader("ffrife", str(script_path))
        spec = importlib.util.spec_from_loader("ffrife", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        module.FFMPEG_BIN = FFMPEG_BIN
        module.FFPROBE_BIN = FFPROBE_BIN
        _FFRIFE_MODULE = module
    return _FFRIFE_MODULE

def ffrife_config_for(config):
    """Bridges slverse's own encode-quality settings into ffrife's config
    shape for one interpolate() call. ffrife's own config file only holds
    what's genuinely ffrife-specific (rife_binary_path, rife_fallback_engine);
    encode quality (hardware_encoder/video_crf/etc.) stays a single source
    of truth in slverse's config rather than needing to be kept in sync across
    two separate files."""
    ffrife = load_ffrife()
    ffrife_config = ffrife.load_config()
    for key in ("hardware_encoder", "video_codec", "video_crf", "video_preset"):
        if key in config:
            ffrife_config[key] = config[key]
    return ffrife_config

def setup_dependencies(config):
    print("Setting up dependencies...")
    system = platform.system()
    ffmpeg_bin = resolve_ffmpeg_binary(config)
    has_ffmpeg = command_exists(ffmpeg_bin) or os.path.exists(ffmpeg_bin)

    if has_ffmpeg and ffmpeg_has_filter(ffmpeg_bin, "drawtext"):
        print(f"Found a drawtext-capable ffmpeg at: {ffmpeg_bin}")
        print("(overlays will work — nothing to install)")
    elif has_ffmpeg:
        print(f"Found ffmpeg at {ffmpeg_bin}, but it's missing the drawtext filter (no freetype/fontconfig).")
        print("Text overlays won't work until you install a build that has it.")
        if system == "Darwin":
            print("Installing a freetype/fontconfig-enabled FFmpeg on macOS...")
            subprocess.run(["brew", "tap", "homebrew-ffmpeg/ffmpeg"], check=True)
            subprocess.run(["brew", "install", "homebrew-ffmpeg/ffmpeg/ffmpeg", "--with-freetype", "--with-fontconfig"], check=True)
        elif system == "Linux":
            print("Installing FFmpeg on Linux (Ubuntu/Debian builds normally include drawtext already)...")
            subprocess.run(["sudo", "apt", "update"], check=True)
            subprocess.run(["sudo", "apt", "install", "-y", "ffmpeg"], check=True)
        else:
            print("Please manually install an FFmpeg build with freetype/fontconfig on Windows (e.g., the gyan.dev 'full' builds).")
    else:
        if system == "Darwin":
            print("Installing FFmpeg with freetype/fontconfig on macOS...")
            subprocess.run(["brew", "tap", "homebrew-ffmpeg/ffmpeg"], check=True)
            subprocess.run(["brew", "install", "homebrew-ffmpeg/ffmpeg/ffmpeg", "--with-freetype", "--with-fontconfig"], check=True)
        elif system == "Linux":
            print("Installing FFmpeg on Linux...")
            subprocess.run(["sudo", "apt", "update"], check=True)
            subprocess.run(["sudo", "apt", "install", "-y", "ffmpeg"], check=True)
        else:
            print("Please manually install FFmpeg on Windows (e.g., winget install ffmpeg).")

def profile_already_has_dir(existing, target_dir):
    """Check every existing `set_dir="..."` assignment (this repo's own
    convention for guarded PATH blocks), not just slverse's own marker, so this
    doesn't add a second entry next to one someone wrote by hand."""
    for line in existing.splitlines():
        line = line.strip()
        if not line.startswith("set_dir="):
            continue
        value = line.split("=", 1)[1].strip().strip('"').strip("'")
        value = value.replace("$HOME", str(Path.home())).replace("~", str(Path.home()))
        try:
            if Path(value).resolve() == target_dir.resolve():
                return True
        except OSError:
            continue
    return False

def add_to_path_profile():
    script_dir = Path(__file__).resolve().parent
    marker = "# maj-scripts slverse PATH (added by 'slverse setup')"
    profile = Path.home() / ".profile"
    existing = profile.read_text() if profile.exists() else ""
    if marker in existing or profile_already_has_dir(existing, script_dir):
        print(f"{profile} already has slverse's folder on PATH.")
        return
    block = (
        f'\n{marker}\n'
        f'set_dir="{script_dir}"\n'
        f'if [ -d "$set_dir" ] ; then\n'
        f'    PATH="$set_dir:$PATH"\n'
        f'fi\n'
    )
    with open(profile, "a") as f:
        f.write(block)
    print(f"Added slverse's folder to PATH via {profile}.")
    print("Run 'source ~/.profile' or open a new terminal for it to take effect.")

# --- API & Network ---
def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'})
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.loads(response.read().decode('utf-8'))
    except Exception as e:
        print(f"Error fetching {url}: {e}")
        return None

def get_pub_media_links(lang, booknum=None):
    url = f"https://b.jw-cdn.org/apis/pub-media/GETPUBMEDIALINKS?output=json&pub=nwt&fileformat=MP4%2CM4V&alllangs=0&langwritten={lang}&txtCMSLang={lang}"
    if booknum:
        url += f"&booknum={booknum}"
    return fetch_json(url)

def get_bible_metadata(lang_code):
    lc = "en" if lang_code == "E" else lang_code.lower()
    url = f"https://www.jw.org/{lc}/library/bible/study-bible/books/json/"
    return fetch_json(url)

def list_all_sign_languages():
    data = fetch_json("https://data.jw-api.org/mediator/v1/languages/E/all")
    if not data:
        return []
    return [l["code"] for l in data.get("languages", []) if l.get("isSignLanguage")]

def _progress_bar(frac, width=30):
    filled = int(width * max(0.0, min(1.0, frac)))
    return "#" * filled + "-" * (width - filled)

def print_progress(downloaded, total, width=30):
    """Minimal single-line progress bar, redrawn in place via \\r - used for
    downloads (RIFE's zip, chapter videos) big enough that silence for tens
    of seconds would otherwise look hung."""
    if total:
        frac = downloaded / total
        sys.stdout.write(f"\r[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({downloaded/1e6:.1f}/{total/1e6:.1f} MB)")
    else:
        sys.stdout.write(f"\r{downloaded/1e6:.1f} MB downloaded")
    sys.stdout.flush()

def print_time_progress(current_s, total_s, label="", width=30):
    """Same bar, driven by seconds-of-output-encoded-so-far instead of
    bytes - for ffmpeg's own -progress pipe (see run_ffmpeg)."""
    frac = (current_s / total_s) if total_s else 0.0
    prefix = f"{label} " if label else ""
    sys.stdout.write(f"\r{prefix}[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({current_s:.1f}/{total_s:.1f}s)")
    sys.stdout.flush()

def print_count_progress(current, total, label="", width=30):
    """Same bar, driven by a plain item count (e.g. frames written) - for
    steps with no time-based progress signal, like the RIFE binary."""
    frac = (current / total) if total else 0.0
    prefix = f"{label} " if label else ""
    sys.stdout.write(f"\r{prefix}[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({current}/{total} frames)")
    sys.stdout.flush()

def download_file(url, output_path, expected_checksum=None):
    tmp_path = Path(str(output_path) + ".part")
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            print(f"Downloading {url}...")
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=60) as resp, open(tmp_path, "wb") as f:
                total = int(resp.headers.get("Content-Length") or 0)
                downloaded = 0
                while True:
                    chunk = resp.read(262144)
                    if not chunk:
                        break
                    f.write(chunk)
                    downloaded += len(chunk)
                    print_progress(downloaded, total)
                print()
            if expected_checksum:
                digest = hashlib.md5(tmp_path.read_bytes()).hexdigest()
                if digest != expected_checksum:
                    raise ValueError(f"checksum mismatch (got {digest}, expected {expected_checksum})")
            os.replace(tmp_path, output_path)
            print("Download complete.")
            return True
        except Exception as e:
            tmp_path.unlink(missing_ok=True)
            print(f"Download attempt {attempt} failed: {e}")
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    return False

# --- Cache management ---
def note_cache_use(state, path):
    state.setdefault("_cache_access", {})[str(path)] = time.time()

def enforce_cache_budget(config, state, protect=None):
    if config.get("cache_policy") != "lru":
        return
    try:
        max_gb = float(config.get("cache_max_gb", DEFAULT_CONFIG["cache_max_gb"]))
    except ValueError:
        return
    cache_dir = Path(config["cache_dir"])
    if not cache_dir.exists():
        return
    budget_bytes = max_gb * (1024 ** 3)
    access_map = state.setdefault("_cache_access", {})

    files = []
    total = 0
    for p in cache_dir.rglob("*"):
        if p.is_file():
            size = p.stat().st_size
            total += size
            last_used = access_map.get(str(p), p.stat().st_mtime)
            files.append((p, size, last_used))

    if total <= budget_bytes:
        return

    files.sort(key=lambda f: f[2])  # oldest-used first
    protect_path = Path(protect).resolve() if protect else None
    for path, size, _ in files:
        if total <= budget_bytes:
            break
        if protect_path and path.resolve() == protect_path:
            continue
        try:
            path.unlink()
            access_map.pop(str(path), None)
            total -= size
            print(f"Cache trim: removed {path.name} ({size/1e6:.1f} MB) to stay under {max_gb}GB.")
        except OSError:
            pass
    # Mutates state in place; the caller is responsible for save_state(), the
    # same as every other function that touches state — this must never
    # persist on its own, since a caller can pass a throwaway dict (tests do)
    # and save_state() always writes to the one real on-disk state.json.

def cache_dir_size(cache_dir):
    total = 0
    if Path(cache_dir).exists():
        for p in Path(cache_dir).rglob("*"):
            if p.is_file():
                total += p.stat().st_size
    return total

# --- Video Processing ---
def run_ffmpeg(args, duration=None, slow_after=4.0):
    """Runs ffmpeg. Most extract/interpolate steps finish in a few seconds
    and stay quiet; pass `duration` (expected output seconds, known by the
    caller from the verse's own start/end times) to show a minimal live
    progress bar once a run has actually taken longer than `slow_after`
    seconds, instead of going silent on a genuinely slow one (a long clip,
    a CPU-bound filter)."""
    base = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y"]
    print()
    print(f"Running: {' '.join(base + args)}")

    if not duration:
        subprocess.run(base + args, check=True)
        return

    cmd = base + ["-progress", "pipe:1", "-nostats"] + args
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    start = time.time()
    shown = False
    for line in proc.stdout:
        line = line.strip()
        if not line.startswith("out_time="):
            continue
        try:
            current = parse_hms(line.split("=", 1)[1])
        except ValueError:
            continue
        if not shown and time.time() - start > slow_after:
            shown = True
        if shown:
            print_time_progress(current, duration, label="Encoding")
    proc.stdout.close()
    proc.wait()
    if shown:
        print()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)

def nvenc_quality_from_crf(crf):
    # nvenc has no crf; -cq on the same 0-51 scale is the closest analogue.
    return crf

def videotoolbox_quality_from_crf(crf):
    # videotoolbox has no crf; -q:v is a 0-100 "higher is better" scale with
    # no fixed formula, so this is a rough inverse mapping, not an exact
    # match. The previous "100 - crf*3" curve put crf 20 (a fairly
    # high-quality setting) at q:v 40 - visibly blocky, since 40 sits in
    # videotoolbox's mediocre-quality range. A flat "100 - crf" keeps crf 20
    # at q:v 80, much closer to what -crf 20 -preset slow actually looks
    # like on libx264.
    try:
        crf_val = float(crf)
    except ValueError:
        crf_val = 20
    return max(1, min(100, round(100 - crf_val)))

def build_encode_args(config):
    hw = config.get("hardware_encoder", "cpu")
    codec = config.get("video_codec", "h264")
    crf = config.get("video_crf", "auto")
    if str(crf).strip().lower() == "auto":
        crf = {"h264": "20", "hevc": "23", "av1": "30"}.get(codec, "20")
    preset = config.get("video_preset", "slow")

    if hw == "nvenc":
        vcodec = {"hevc": "hevc_nvenc", "av1": "av1_nvenc"}.get(codec, "h264_nvenc")
        args = ["-c:v", vcodec, "-preset", preset, "-cq", str(nvenc_quality_from_crf(crf))]
    elif hw == "videotoolbox":
        vcodec = "hevc_videotoolbox" if codec == "hevc" else "h264_videotoolbox"
        args = ["-c:v", vcodec, "-q:v", str(videotoolbox_quality_from_crf(crf))]
    elif hw == "qsv":
        vcodec = "hevc_qsv" if codec == "hevc" else "h264_qsv"
        args = ["-c:v", vcodec, "-preset", preset, "-global_quality", str(crf)]
    else:
        vcodec = {"hevc": "libx265", "av1": "libsvtav1"}.get(codec, "libx264")
        args = ["-c:v", vcodec, "-crf", str(crf), "-preset", ("6" if codec == "av1" and preset == "slow" else preset)]
        if codec == "av1":
            args += ["-svtav1-params", "tune=0"]

    return args + ["-pix_fmt", "yuv420p", "-movflags", "+faststart"]

def output_metadata_args(book_name, chapter, verses, lang, source_url, checksum):
    title = f"{book_name} {chapter}:{verses} ({lang})"
    return ["-metadata", f"title={title}", "-metadata", f"artist=JW.org ({lang})",
            "-metadata", "encoder=jwkit slverse", "-metadata", f"comment=Source: {source_url}",
            "-metadata", f"source_checksum={checksum or ''}"]

def google_fonts_ttf_url(family, weight):
    """Resolve the current .ttf URL for a Google Fonts family/weight by
    reading the same CSS2 endpoint a browser would
    (fonts.googleapis.com/css2?family=...&wght@N) and pulling the url(...)
    out of the returned @font-face rule. A plain 'Mozilla/5.0' UA (no
    modern Accept/Sec-CH-UA hints) gets served a .ttf instead of .woff2 -
    verified live for Noto Sans Display, Inter, and Google Sans Flex."""
    css_url = f"https://fonts.googleapis.com/css2?family={urllib.parse.quote(family)}:wght@{weight}&display=swap"
    try:
        req = urllib.request.Request(css_url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=15) as resp:
            css = resp.read().decode('utf-8')
    except Exception as e:
        print(f"Error fetching Google Fonts CSS for {family} {weight}: {e}")
        return None
    match = re.search(r"url\((https://fonts\.gstatic\.com/[^)]+\.ttf)\)", css)
    return match.group(1) if match else None

def ensure_font(family_key, weight):
    """Auto-download one weight of a configured font family into
    CONFIG_DIR/fonts/ the first time it's needed, so a fresh machine gets
    working overlay typography without a manual font install step. Returns
    the local Path, or None if it's not already there and the download
    failed (callers fall back to fontconfig's default font)."""
    family = FONT_FAMILIES.get(family_key)
    if not family:
        return None
    path = FONT_DIR / f"{family_key}-{weight}.ttf"
    if path.exists():
        return path
    url = google_fonts_ttf_url(family, weight)
    if not url:
        return None
    FONT_DIR.mkdir(parents=True, exist_ok=True)
    if download_file(url, path):
        return path
    return None

def resolve_font_paths(config):
    """(main drawtext font, estimator font) - config font_path is a full
    manual override (same file used for both); otherwise font_family (see
    FONT_FAMILIES) picks which family to auto-download. The estimator (a
    lighter weight, used purely to *measure* how big the source video's own
    burned-in caption roughly is for delogo auto-sizing - see
    build_overlay_filter) falls back to the main font if its own download
    fails."""
    configured = config.get("font_path")
    if configured and os.path.exists(configured):
        return Path(configured), Path(configured)

    family_key = (config.get("font_family") or DEFAULT_CONFIG["font_family"]).strip().lower()
    if family_key not in FONT_FAMILIES:
        family_key = "noto-sans-display"
    main_font = ensure_font(family_key, FONT_MAIN_WEIGHT)
    estimator_font = ensure_font(family_key, FONT_ESTIMATOR_WEIGHT) or main_font
    return main_font, estimator_font

def measure_text_size(text, font_path, fontsize):
    """Pixel (width, height) `text` renders at when drawn with `font_path`
    at `fontsize` - used to auto-size the delogo box instead of the manual
    per-verse pixel offsets old ffv needed (-w/-t). Shells out to
    ImageMagick, the same way old ffv measured this; falls back to a rough
    character-count heuristic if ImageMagick isn't installed, so overlays
    still work, just with a less precisely fitted box."""
    if command_exists("magick") and command_exists("identify"):
        try:
            with tempfile.TemporaryDirectory() as tmp_dir:
                img_path = Path(tmp_dir) / "measure.png"
                cmd = ["magick", "-background", "none", "-fill", "black"]
                if font_path:
                    cmd += ["-font", str(font_path)]
                cmd += ["-pointsize", str(fontsize), f"label:{text}", str(img_path)]
                subprocess.run(cmd, check=True, capture_output=True)
                result = subprocess.run(["identify", "-format", "%w %h", str(img_path)], check=True, capture_output=True, text=True)
                w, h = result.stdout.split()
                return int(w), int(h)
        except Exception:
            pass
    return round(len(text) * fontsize * 0.55), round(fontsize * 1.3)

def build_overlay_filter(lang, book_name, chapter, verse_label, config, show_box, source_labels=None, fade_outs=None):
    """delogo (blur out the source video's own burned-in reference caption)
    + drawtext (the correct reference, in the caption position old ffv
    used) + a small label of which sign language this clip came from -
    mirrors old ffv's generate_filters(). Returns None when `lang` is the
    configured default_target_lang: that language's own burned-in caption
    is already correct, so no overlay is needed at all (old ffv's
    `if [ "${ll}" = "${lang_tr}" ]` early-out - skip delogo/drawtext
    entirely rather than draw a second caption on top of the first).

    Beyond that exact-language match, sign_lang_ref_language may also mark
    `lang` and default_target_lang as sharing the same spoken/reference
    language (e.g. ASL and FSL are different sign languages but both caption
    in English) - in that case the verse reference itself is already
    correct too, so delogo/drawtext for it are skipped the same way, while
    show_source_lang_label's small "which SL" label (independent of that
    skip) can still be drawn on its own.

    `show_box` draws the delogo rectangle as a visible outline instead of
    actually blurring it (ffmpeg delogo's own show=1 debug mode) - used for
    preview so you can see where the box lands before writing anything.

    source_labels are the source video's own per-verse caption text(s),
    straight from JW's marker metadata (e.g. "Mazmur 16:11" for INI) - used
    to size the delogo box against what ACTUALLY renders in this source,
    instead of the replacement text being drawn over it. Sizing off the
    replacement label was the old bug: a source caption in a language whose
    words simply run wider (INI's "Mazmur" vs "Psalm") left a sliver of the
    original still showing. Falls back to the replacement label if markers
    didn't carry one. A multi-verse window can show more than one distinct
    source caption in sequence (each verse advances its own marker's
    label), so every distinct one is measured and the box sized to the
    widest/tallest.
    """
    target_lang = (config.get("default_target_lang") or "").strip().upper()
    lang_u = lang.upper()
    if target_lang and lang_u == target_lang:
        return None

    ref_lang_map = parse_kv_config(config.get("sign_lang_ref_language", DEFAULT_CONFIG["sign_lang_ref_language"]))
    source_ref = ref_lang_map.get(lang_u)
    target_ref = ref_lang_map.get(target_lang) if target_lang else None
    skip_reference = bool(source_ref) and source_ref == target_ref

    show_label = str(config.get("show_source_lang_label", DEFAULT_CONFIG["show_source_lang_label"])).strip().lower() != "false"
    if skip_reference and not show_label:
        return None

    main_font, estimator_font = resolve_font_paths(config)
    x = int(config.get("overlay_x", DEFAULT_CONFIG["overlay_x"]))
    y = int(config.get("overlay_y", DEFAULT_CONFIG["overlay_y"]))
    fontsize = int(config.get("overlay_fontsize", DEFAULT_CONFIG["overlay_fontsize"]))
    alpha = config.get("overlay_alpha", DEFAULT_CONFIG["overlay_alpha"])
    label_alpha = config.get("overlay_source_label_alpha", DEFAULT_CONFIG["overlay_source_label_alpha"])
    def fading_alpha(base):
        # JW supplies endTransitionDuration for paragraph/chapter ends.  Make
        # our replacement caption disappear with that fade rather than remain
        # visibly static over a blackening source frame.
        expr = str(base)
        for fade_start, fade_end in reversed(fade_outs or []):
            expr = f"if(between(t\\,{fade_start:.3f}\\,{fade_end:.3f})\\,{base}*({fade_end:.3f}-t)/{fade_end - fade_start:.3f}\\,{expr})"
        return expr
    width_pad = int(config.get("delogo_width_pad", DEFAULT_CONFIG["delogo_width_pad"]))
    height_pad = int(config.get("delogo_height_pad", DEFAULT_CONFIG["delogo_height_pad"]))

    label_text = f"{book_name} {chapter}:{verse_label}"

    def esc(text):
        return text.replace(":", "\\:").replace("'", "\\'")

    font_arg = f":fontfile='{main_font}'" if main_font else ""
    filters = []

    # Measured whether or not the reference itself gets replaced: even when
    # skip_reference leaves the source's own caption untouched, the small
    # source-SL label still needs to sit BELOW it rather than on top of it
    # (drawing at the bare overlay_y position would overlap the still-visible
    # original caption one-for-one).
    measure_candidates = list(dict.fromkeys(source_labels or [])) or [label_text]
    w = h = 0
    for candidate in measure_candidates:
        cw, ch = measure_text_size(candidate, estimator_font, fontsize)
        w, h = max(w, cw), max(h, ch)

    if not skip_reference:
        show = 1 if show_box else 0
        delogo = f"delogo=x={x - 5}:y={y - 5}:w={w + 10 + width_pad}:h={h + 5 + height_pad}:show={show}"
        drawtext = f"drawtext=text='{esc(label_text)}'{font_arg}:fontcolor=white:fontsize={fontsize}:x={x}:y={y}:alpha='{fading_alpha(alpha)}'"
        filters += [delogo, drawtext]

    if show_label:
        drawtext_ll = f"drawtext=text='{lang_u}'{font_arg}:fontcolor=white:fontsize={fontsize}:x={x}:y={y + h - 5}:alpha='{fading_alpha(label_alpha)}'"
        filters.append(drawtext_ll)

    return ",".join(filters) if filters else None

def preview_verse(source, start_time, end_time, book_name, chapter, verse_label, lang, config, use_mpv=False, source_url=None, source_labels=None, fade_outs=None):
    """Default 'slverse extract' behavior (no --write): play the verse with
    its overlay applied live - including a visible box where delogo would
    remove the source caption - without writing anything to disk. Mirrors
    old ffv's play_video(): ffplay applies -vf directly against the stream
    (fastest - no encode at all), while mpv can't take -vf on a remote/
    local source directly, so --play/-m instead makes a quick ultrafast
    temp clip first, the same tradeoff the old script made."""
    overlay = build_overlay_filter(lang, book_name, chapter, verse_label, config, show_box=True, source_labels=source_labels, fade_outs=fade_outs)
    duration = end_time - start_time

    from_cache = source_url is not None and str(source) != str(source_url)

    if use_mpv:
        if not command_exists("mpv"):
            print("(--play needs mpv, which isn't installed - falling back to ffplay)")
        else:
            print()
            print(f"Previewing: {source}")
            if from_cache:
                print(f"Source: {source_url}")
            with tempfile.TemporaryDirectory() as tmp_dir:
                tmp_out = Path(tmp_dir) / "preview.mkv"
                cmd = ["-ss", str(start_time), "-t", str(duration), "-i", str(source)]
                if overlay:
                    cmd += ["-vf", overlay]
                cmd += ["-c:v", "libx264", "-preset", "ultrafast", "-crf", "23", "-c:a", "copy", "-f", "matroska", str(tmp_out)]
                run_ffmpeg(cmd, duration=duration)
                launch_mpv([str(tmp_out)], config=config)
            return

    ffplay_args = ["-ss", str(start_time), "-t", str(duration), "-i", str(source)]
    if overlay:
        ffplay_args += ["-vf", overlay]
    print()
    print(f"Previewing: {FFPLAY_BIN} {' '.join(ffplay_args)}")
    if from_cache:
        # Plain "Source: <url>" on its own line, not folded into a
        # parenthetical - so it's a clean copy/paste to swap in for the
        # local path above if you want to check the actual CDN source.
        print(f"Source: {source_url}")
    launch_ffplay(ffplay_args)

def extract_verse(source, output_file, start_time, end_time, book_name, chapter, verse_label, lang, config, remote=False, source_labels=None, kept_segments=None, fade_outs=None, metadata_args=None):
    """Single-pass: trim + overlay + (for framerate/minterpolate) the fps
    filter all happen in ONE ffmpeg encode, straight from `source`. Used to
    be two full lossy re-encode generations (extract-with-overlay, then a
    second pass just to add the fps filter) - now it's one, for every
    engine except rife, which has an unavoidable one-lossy-generation
    minimum of its own (see ffrife.interpolate: PNG extraction and RIFE
    itself are lossless, only the final merge encodes).

    kept_segments (from resolve_verse_window/resolve_kept_segments) is
    normally just [(0, duration)] - the plain single -vf path below. More
    than one segment means trim_mid_transitions cut something out of the
    middle of the window, which needs filter_complex trim+concat instead of
    a plain -vf - and, if the source has an audio stream, re-encoded audio
    too, since concatenating cut segments means there's no longer one
    continuous stream to -c:a copy straight through (JW's own Sign Language
    source videos normally carry no audio stream at all - see
    has_audio_stream - so this is usually moot in practice). Not combined
    with the rife engine here - ffrife owns its own PNG extraction and
    doesn't know about kept_segments."""
    overlay = build_overlay_filter(lang, book_name, chapter, verse_label, config, show_box=False, source_labels=source_labels, fade_outs=fade_outs)
    engine = config.get("interpolation_engine", "none")
    duration = end_time - start_time
    segments = kept_segments or [(0.0, duration)]

    if engine == "rife":
        if len(segments) > 1:
            print("(trim_mid_transitions doesn't support interpolation_engine=rife yet - mid-range transitions will play through untouched.)")
        ffrife = load_ffrife()
        ffrife.interpolate(source, output_file, ffrife_config_for(config), start=start_time, end=end_time, vf=overlay, fps=60, metadata_args=metadata_args)
        return

    vf_chain = list(filter(None, [overlay]))
    if engine == "minterpolate":
        print()
        print("Interpolating using ffmpeg minterpolate...")
        vf_chain.append("minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1")
    elif engine == "framerate":
        print()
        print("Interpolating using ffmpeg framerate...")
        vf_chain.append("framerate=fps=60")

    # -ss before -i does an input-side seek; on a remote URL that means the
    # CDN is only asked for bytes from roughly that point on, which is what
    # keeps onthefly mode from pulling the whole chapter over the network.
    cmd = ["-ss", str(start_time), "-to", str(end_time), "-i", str(source)]
    if len(segments) > 1:
        audio = has_audio_stream(source)
        fc = build_trim_concat_filter_complex(segments, audio=audio)
        if vf_chain:
            fc += f";[vout]{','.join(vf_chain)}[final]"
            out_label = "[final]"
        else:
            out_label = "[vout]"
        cmd += ["-filter_complex", fc, "-map", out_label]
        if audio:
            cmd += ["-map", "[aout]", "-c:a", "aac", "-b:a", "128k"]
        cmd += build_encode_args(config) + (metadata_args or []) + [str(output_file)]
    else:
        if vf_chain:
            cmd += ["-vf", ",".join(vf_chain)]
        cmd += ["-c:a", "copy"] + build_encode_args(config) + (metadata_args or []) + [str(output_file)]
    run_ffmpeg(cmd, duration=duration)

def parse_speed(value):
    """Accepts whatever notation is most natural to type: a plain decimal
    (0.5, 2.5), a fraction (1/3), or a percentage (40%, 150%) - same
    notation ffrife's own --speed takes (kept as a small standalone copy
    here rather than importing ffrife just for this, since that would
    force-load the sibling script on every slverse invocation instead of only
    ones that actually touch --slow/--fast/rife)."""
    s = str(value).strip()
    if s.endswith("%"):
        return float(s[:-1]) / 100
    if "/" in s:
        num, den = s.split("/", 1)
        return float(num) / float(den)
    return float(s)

def probe_source_fps(source):
    """ffprobe's r_frame_rate comes back as an 'N/D' fraction (e.g.
    '30000/1001'), not a plain float. Used to size ffrife's merge fps for
    --slow sections: RIFE always exactly doubles frame count, so requesting
    2x source fps keeps the pre-retime frame set at the source's original
    duration - the only fps value that keeps final output duration correct
    for any --speed (see extract_verse_sections)."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=r_frame_rate", "-of", "csv=p=0", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return float(Fraction(result.stdout.strip()))

def has_audio_stream(source):
    """JW's own Sign Language source videos carry no audio track at all
    (confirmed via ffprobe: video + a data stream + a thumbnail PNG stream,
    no 'a' stream) - a filter_complex that references [0:a] unconditionally
    (e.g. atrim) fails outright ("Error binding filtergraph inputs/outputs")
    against one of these, rather than just producing silence. Checked before
    building trim_mid_transitions' filter_complex so it can branch to a
    video-only concat instead - see build_trim_concat_filter_complex."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "a", "-show_entries", "stream=index", "-of", "csv=p=0", str(source)]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=20)
    except Exception:
        return False
    return bool(result.stdout.strip())

def resolve_kept_segments(chapters_meta, valid_verses, start, end, trim_mid):
    """[(seg_start, seg_end), ...] in seconds relative to the window's own
    start (0) - everything to actually keep. [(0, end-start)] (the whole
    window, one segment) unless trim_mid is true AND a verse other than the
    last selected one has its own nonzero end_transition (a paragraph
    boundary in the middle of the range, not the range's own trailing one -
    see trim_end_transition for that). Only verses before the last are
    considered: the last verse's own transition is trim_end_transition's
    call, made separately by the caller before `end` ever reaches here."""
    duration = end - start
    if not trim_mid or len(valid_verses) < 2:
        return [(0.0, duration)]

    drops = []
    for v in valid_verses[:-1]:
        et = chapters_meta[v].get("end_transition", 0)
        if et > 0:
            drop_end = chapters_meta[v]["end"] - start
            drop_start = drop_end - et
            if 0 < drop_start < drop_end <= duration:
                drops.append((drop_start, drop_end))

    if not drops:
        return [(0.0, duration)]

    segments = []
    cursor = 0.0
    for drop_start, drop_end in drops:
        if drop_start > cursor:
            segments.append((cursor, drop_start))
        cursor = drop_end
    if cursor < duration:
        segments.append((cursor, duration))
    return segments

def build_trim_concat_filter_complex(segments, base_label="[0:v]", audio=False):
    """trim each (seg_start, seg_end) out of `base_label` and concat them
    back-to-back into [vout] (and [aout] too, when `audio` is true) - the
    jump-cut side of trim_mid_transitions. Straight trims with no retiming
    (unlike build_sectioned_filter_complex's alternating slow/fast
    sections), so audio concatenates cleanly alongside video when there is
    any - JW's own Sign Language source videos normally carry none at all
    (see has_audio_stream), so callers should probe first and pass
    audio=False for those rather than reference a nonexistent [0:a]."""
    fc = ""
    v_labels, a_labels = [], []
    for i, (s, e) in enumerate(segments, start=1):
        fc += f"{base_label}trim={s}:{e},setpts=PTS-STARTPTS[v{i}];"
        v_labels.append(f"[v{i}]")
        if audio:
            fc += f"[0:a]atrim={s}:{e},asetpts=PTS-STARTPTS[a{i}];"
            a_labels.append(f"[a{i}]")
    if audio:
        pairs = "".join(v + a for v, a in zip(v_labels, a_labels))
        fc += f"{pairs}concat=n={len(segments)}:v=1:a=1[vout][aout]"
    else:
        fc += "".join(v_labels) + f"concat=n={len(segments)}:v=1[vout]"
    return fc

def build_sectioned_filter_complex(boundaries, speed, mode, base_label):
    """Builds a filter_complex that trims [0:v] (or `base_label`, if an
    ffmpeg-filter interpolation engine already ran on it) into N alternating
    normal/retimed sections at `boundaries` (seconds, relative to whatever
    window the caller already trimmed to via -ss/-to), then concats them -
    all in one pass. 'slow' retimes the even sections (2nd, 4th, ...),
    'fast' the odd ones (1st, 3rd, ...) - the same alternating pattern (and
    parity per direction) as the standalone ffslow/fffast tools. Returns
    (filter_complex_str, output_label)."""
    n = len(boundaries) + 1
    fc = ""
    labels = []
    for i in range(1, n + 1):
        if i == 1:
            fc += f"{base_label}trim=0:{boundaries[0]},setpts=PTS-STARTPTS[v{i}];"
        elif i == n:
            fc += f"{base_label}trim=start={boundaries[i - 2]},setpts=PTS-STARTPTS[v{i}];"
        else:
            fc += f"{base_label}trim={boundaries[i - 2]}:{boundaries[i - 1]},setpts=PTS-STARTPTS[v{i}];"
        retime = (i % 2 == 0) if mode == "slow" else (i % 2 == 1)
        if retime:
            fc += f"[v{i}]setpts=PTS/{speed:.6g}[r{i}];"
            labels.append(f"r{i}")
        else:
            labels.append(f"v{i}")
    fc += "".join(f"[{l}]" for l in labels) + f"concat=n={n}:v=1:a=0[out]"
    return fc, "[out]"

def extract_verse_sections(source, output_file, start_time, end_time, book_name, chapter, verse_label, lang, config, mode, boundaries, speed, source_labels=None):
    """--slow/--fast: split the verse window at `boundaries` (seconds,
    relative to the verse's own start) into alternating normal/retimed
    sections at `speed` - ported from the standalone ffslow/fffast tools'
    own section handling (see build_sectioned_filter_complex). Like those
    tools, the sectioned output is video-only: the concat step only carries
    a video stream (mixing RIFE'd and plain-trimmed pieces, or applying
    setpts to only half the timeline, leaves no single consistent audio
    track to carry through) - the single-window extract_verse path above
    still keeps audio."""
    overlay = build_overlay_filter(lang, book_name, chapter, verse_label, config, show_box=False, source_labels=source_labels)
    engine = config.get("interpolation_engine", "none")
    duration = end_time - start_time

    if mode == "slow" and engine == "rife":
        ffrife = load_ffrife()
        ffrife_config = ffrife_config_for(config)
        n = len(boundaries) + 1
        abs_bounds = [start_time + b for b in boundaries]
        starts = [start_time] + abs_bounds
        ends = abs_bounds + [end_time]
        source_fps = None

        with tempfile.TemporaryDirectory() as tmp_dir:
            pieces = []
            for i in range(n):
                seg_start, seg_end = starts[i], ends[i]
                piece = Path(tmp_dir) / f"piece_{i}.mp4"
                pieces.append(piece)
                if (i + 1) % 2 == 0:
                    # Slow section: RIFE + retime, one merge encode (see
                    # ffrife.interpolate's `speed` param).
                    if source_fps is None:
                        source_fps = probe_source_fps(source)
                    ffrife.interpolate(source, piece, ffrife_config, start=seg_start, end=seg_end, vf=None, fps=source_fps * 2, speed=speed)
                else:
                    # Normal-speed section: plain cut, no interpolation needed.
                    cmd = ["-ss", str(seg_start), "-to", str(seg_end), "-i", str(source), "-c:a", "copy"] + build_encode_args(config) + [str(piece)]
                    run_ffmpeg(cmd, duration=seg_end - seg_start)

            # concat *filter*, not the concat demuxer/-c copy: pieces have
            # different internal frame rates (normal pieces at source fps,
            # RIFE'd pieces at source_fps*2), and stream-copy concat doesn't
            # reconcile that - see ffslow's own version of this comment.
            concat_inputs = []
            concat_filter = ""
            for i, piece in enumerate(pieces):
                concat_inputs += ["-i", str(piece)]
                concat_filter += f"[{i}:v]"
            concat_filter += f"concat=n={n}:v=1:a=0[out]"
            map_label = "[out]"
            if overlay:
                concat_filter += f";[out]{overlay}[final]"
                map_label = "[final]"
            cmd = concat_inputs + ["-filter_complex", concat_filter, "-map", map_label] + build_encode_args(config) + [str(output_file)]
            run_ffmpeg(cmd, duration=duration)
        return

    base_label = "[0:v]"
    prefix = ""
    if mode == "slow" and engine == "minterpolate":
        print()
        print("Interpolating using ffmpeg minterpolate...")
        prefix = "[0:v]minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1[base];"
        base_label = "[base]"
    elif mode == "slow" and engine == "framerate":
        print()
        print("Interpolating using ffmpeg framerate...")
        prefix = "[0:v]framerate=fps=60[base];"
        base_label = "[base]"

    fc, out_label = build_sectioned_filter_complex(boundaries, speed, mode, base_label)
    fc = prefix + fc
    map_label = out_label
    if overlay:
        fc += f";{out_label}{overlay}[final]"
        map_label = "[final]"

    # -ss/-to before -i: same input-side seek extract_verse uses, so
    # `boundaries` stay relative to the verse's own start (0) rather than
    # needing the caller to add start_time to each one.
    cmd = ["-ss", str(start_time), "-to", str(end_time), "-i", str(source), "-filter_complex", fc, "-map", map_label]
    cmd += build_encode_args(config) + [str(output_file)]
    run_ffmpeg(cmd, duration=duration)

def expand_verses(verses_str):
    """'1, 2' / '1-3' / '1-3,5' -> sorted unique ints. Shared by parse_reference
    (extract's free-form reference string) and cmd_find's verse argument
    (which also accepts a single verse or a range/list, not just one int)."""
    verses = []
    for part in verses_str.replace(" ", "").split(","):
        if "-" in part:
            start, end = part.split("-")
            verses.extend(list(range(int(start), int(end) + 1)))
        else:
            verses.append(int(part))
    return sorted(set(verses))

def format_verses_label(verses):
    """Sorted unique ints -> a compact display string: '11', '11-13', or
    '11,13,15' for a non-contiguous list. Used for log/print output only -
    printing a raw list gives 'Psalm 16:[11]', which is what the readability
    complaint about slverse's logs was pointing at."""
    if not verses:
        return ""
    if len(verses) == 1:
        return str(verses[0])
    if verses == list(range(verses[0], verses[-1] + 1)):
        return f"{verses[0]}-{verses[-1]}"
    return ",".join(str(v) for v in verses)

def parse_reference(ref_str):
    match = re.match(r"(.+?)\s+(\d+):(.+)", ref_str)
    if not match:
        return None, None, []
    book, chapter, verses_str = match.groups()
    return book.strip(), int(chapter), expand_verses(verses_str)

def parse_hms(ts):
    """'HH:MM:SS.mmm' -> float seconds, as returned by GETPUBMEDIALINKS markers."""
    parts = ts.split(":")
    h, m, s = (["0", "0"] + parts)[-3:]
    return int(h) * 3600 + int(m) * 60 + float(s)

def markers_to_verse_times(markers):
    """Verse-level timestamps come straight from JW's own API metadata
    (GETPUBMEDIALINKS ... &booknum=N already returns per-verse markers), so
    there's no need to download the video and ffprobe its embedded chapters
    just to find out where a verse starts.

    end_transition (JW's own endTransitionDuration) is 0 for every verse
    mid-paragraph and nonzero on a paragraph's/chapter's last verse -
    confirmed against a real clip (Psalm 16:11 ASL: duration 33.800s,
    endTransitionDuration 6.940s) by extracting frames across that trailing
    window: the signer holds their final pose through
    start+duration-end_transition, then fades to black and cuts to the
    JW.org copyright card by start+duration - i.e. this one field covers
    exactly the "post-paragraph fadeout + copyright endscreen" tail (see
    resolve_verse_window)."""
    result = {}
    for m in markers or []:
        try:
            v = int(m["verseNumber"])
            start = parse_hms(m["startTime"])
            dur = parse_hms(m["duration"])
            end_transition = parse_hms(m.get("endTransitionDuration") or "0")
            result[v] = {"start": start, "end": start + dur, "label": m.get("label", ""), "end_transition": end_transition}
        except (KeyError, ValueError, TypeError):
            continue
    return result

def get_chapter_timestamps_ffprobe(input_file):
    """Fallback for videos cached before marker storage existed, or any file
    without markers available from the API."""
    cmd = [FFPROBE_BIN, "-hide_banner", "-loglevel", "quiet", "-show_chapters", "-print_format", "json", str(input_file)]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        data = json.loads(result.stdout)
        chapters = {}
        for ch in data.get("chapters", []):
            title = ch.get("tags", {}).get("title", "")
            parts = title.strip().split(":")
            verse_num = parts[-1] if parts else title.strip()
            try:
                verse = int(re.sub(r'[^0-9]', '', verse_num))
                chapters[verse] = {"start": float(ch["start_time"]), "end": float(ch["end_time"])}
            except (KeyError, ValueError, TypeError):
                pass
        return chapters
    except Exception as e:
        print(f"Error reading chapters: {e}")
        return {}

def resolve_book_number(book_name, lang="E", state=None):
    """Book names/numbers are static, so the study-bible metadata (one
    network call per language) is cached in state.json instead of being
    re-fetched on every extract/find."""
    if book_name.isdigit():
        return int(book_name)

    metadata = state.get("_book_metadata", {}).get(lang) if state is not None else None
    if metadata is None:
        metadata = get_bible_metadata(lang)
        if metadata is not None and state is not None:
            state.setdefault("_book_metadata", {})[lang] = metadata
    if not metadata:
        return None
    for b_id, b_data in metadata.get("editionData", {}).get("books", {}).items():
        if book_name.lower() in b_data.get("standardSingularBookName", "").lower():
            return int(b_id)
        if book_name.lower() in b_data.get("officialAbbreviation", "").lower():
            return int(b_id)
    return None

def verse_markers(file):
    """GETPUBMEDIALINKS wraps the per-verse marker list in a dict alongside
    book/chapter metadata: file['markers'] = {..., 'markers': [...]}."""
    wrapper = file.get("markers")
    if isinstance(wrapper, dict):
        return wrapper.get("markers", []) or []
    return []

def find_track(data, lang, chapter):
    for fmt in ("MP4", "M4V"):
        for file in data.get("files", {}).get(lang, {}).get(fmt, []):
            if file.get("label") == "720p" and file.get("track") == chapter:
                return file
    return None

def index_book(lang, n):
    """One language/book worth of index entries: {key: entry}."""
    data = get_pub_media_links(lang, n)
    if not data:
        return {}
    entries = {}
    for fmt in ("MP4", "M4V"):
        for file in data.get("files", {}).get(lang, {}).get(fmt, []):
            if file.get("label") != "720p":
                continue
            url = file["file"]["url"]
            checksum = file["file"]["checksum"]
            booknum = file.get("booknum", n)
            track = file.get("track")
            key = f"{booknum}_{track}"
            entries[key] = {
                "url": url,
                "checksum": checksum,
                "book_num": booknum,
                "chapter": track,
                "markers": verse_markers(file),
            }
    return entries

# --- Commands ---
def cmd_setup(args, config):
    if args.non_interactive:
        setup_dependencies(config)
        if not _jwkit_common.JWKIT_CONFIG_FILE.exists():
            _jwkit_common.save_jwkit_config(_jwkit_common.load_jwkit_config())
        return

    print("Let's get slverse set up. Press Enter to accept the suggested answer shown in [brackets].\n")
    setup_dependencies(config)
    jwlangs = load_jwlangs()

    current = config.get("languages", DEFAULT_CONFIG["languages"])
    print(f"\nCurrent language list: {', '.join(lang_display(c, jwlangs) for c in current.split(','))}")
    ans = input(f"Which sign languages do you usually watch? Comma-separated codes (see https://www.jw.org/en/languages) [{current}]: ").strip()
    if ans:
        config["languages"] = ",".join(c.strip().upper() for c in ans.split(",") if c.strip())

    ans = input(f"\nHow much disk space can slverse use to cache downloaded chapters, in GB? [{config.get('cache_max_gb', DEFAULT_CONFIG['cache_max_gb'])}]: ").strip()
    if ans:
        config["cache_max_gb"] = ans
        config["cache_policy"] = "lru"

    print("\n60fps playback options:")
    print("  rife         - fastest and best quality, but needs a one-time download (uses your graphics card)")
    print("  minterpolate - works right now with no extra download, but is slow (uses your processor)")
    print("  none         - skip 60fps conversion")
    ans = (input("Which one do you want? [rife]: ").strip().lower() or "rife")
    if ans not in ("rife", "minterpolate", "framerate", "none"):
        ans = "none"
    config["interpolation_engine"] = ans
    if ans == "rife":
        # RIFE install/config lives entirely in the sibling ffrife tool
        # (not JW-specific - see load_ffrife's docstring), so delegate to
        # its own setup instead of duplicating the download logic here.
        ffrife = load_ffrife()
        ffrife.cmd_setup(ffrife.load_config())

    hw = detect_hardware_encoder()
    print(f"\nVideo encoder: {hw} (libx264 - measured smaller files at equal quality vs. GPU encoders for short clips;")
    print("run 'slverse config set hardware_encoder videotoolbox' (or nvenc/qsv) if you'd rather trade file size for speed)")
    config["hardware_encoder"] = hw

    ans = input("\nAdd slverse to your PATH so you can type 'slverse' from any folder on this machine? [Y/n]: ").strip().lower()
    if ans in ("", "y", "yes"):
        add_to_path_profile()

    # Shared across every jwkit tool (slverse, ffrife, jwdl, jwvideo-mux),
    # not just slverse's own config - see _jwkit_common.py.
    jwkit_config = _jwkit_common.load_jwkit_config()
    default_label = "Y/n" if jwkit_config.get("auto_update", True) else "y/N"
    ans = input(f"\nKeep jwkit up to date automatically (checked at most once a day when you run a jwkit command)? [{default_label}]: ").strip().lower()
    if ans:
        jwkit_config["auto_update"] = ans in ("y", "yes")
    _jwkit_common.save_jwkit_config(jwkit_config)

    save_config(config)
    print("\nAll set. Run 'slverse config' anytime to see or change these settings.")
    print("If you use slverse on more than one computer, run 'slverse setup' on each one — settings are per-machine.")

def cmd_config(args, config):
    if args.key and args.value:
        config[args.key] = args.value
        save_config(config)
        print(f"Set {args.key} = {args.value}")
    elif args.key:
        print(f"{args.key} = {config.get(args.key)}")
        help_text = CONFIG_HELP.get(args.key)
        if help_text:
            print(f"  {help_text}")
    else:
        # CONFIG_HELP covers every DEFAULT_CONFIG key, so this doubles as
        # the full documented config surface - see also docs/slverse.md.
        width = max((len(k) for k in config), default=0)
        for k, v in config.items():
            help_text = CONFIG_HELP.get(k, "")
            suffix = f"  # {help_text}" if help_text else ""
            print(f"{k:<{width}} = {v}{suffix}")

def cmd_langs(args, config):
    jwlangs = load_jwlangs()
    state = get_state()
    meta = state.get("_meta", {})
    print("Configured languages:")
    for code in get_lang_list(config):
        last = meta.get(code, {}).get("last_synced")
        last_str = time.strftime("%Y-%m-%d %H:%M", time.localtime(last)) if last else "never synced"
        print(f"  {lang_display(code, jwlangs):40} last synced: {last_str}")
    if args.discover:
        print("\nAll sign languages JW.org publishes NWT video in:")
        for code in sorted(list_all_sign_languages()):
            print(f"  {lang_display(code, jwlangs)}")

def sync_one_lang(lang):
    entries = {}
    for n in range(1, 67):
        entries.update(index_book(lang, n))
        print(f"  {lang} book {n}: indexed", end="\r")
    print(f"  {lang}: indexed {len(entries)} chapter(s) worth of tracks.       ")
    return lang, entries

def sync_languages(langs, config, state, quiet=False):
    """Core of 'slverse sync', factored out so the auto-sync path (see
    maybe_auto_sync) can reuse it without going through argparse. Mutates
    `state` in place; caller owns save_state()."""
    workers = int(config.get("sync_workers", DEFAULT_CONFIG["sync_workers"]) or 1)
    printer = (lambda *a, **k: None) if quiet else print

    printer(f"Syncing metadata for: {', '.join(langs)}")
    results = {}
    if len(langs) > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            for lang, entries in pool.map(sync_one_lang, langs):
                results[lang] = entries
    else:
        lang, entries = sync_one_lang(langs[0])
        results[lang] = entries

    now = time.time()
    for lang, entries in results.items():
        existing = load_index(lang)
        new_count = 0
        for key, entry in entries.items():
            prior = existing.get(key)
            if not prior or prior.get("checksum") != entry["checksum"]:
                entry["downloaded"] = prior.get("downloaded", False) if prior else False
                existing[key] = entry
                new_count += 1
            else:
                # keep markers/track fresh even when checksum matches
                prior["markers"] = entry["markers"]
        save_index(lang, existing)
        state.setdefault("_meta", {}).setdefault(lang, {})["last_synced"] = now
        printer(f"{lang}: {new_count} new/updated track(s).")

def cmd_sync(args, config):
    langs = get_lang_list(config, args.lang)
    state = get_state()
    sync_languages(langs, config, state, quiet=getattr(args, "quiet", False))
    save_state(state)

def internet_available():
    try:
        urllib.request.urlopen(
            urllib.request.Request("https://b.jw-cdn.org", method="HEAD", headers={"User-Agent": "Mozilla/5.0"}),
            timeout=3,
        )
        return True
    except urllib.error.HTTPError:
        # A real HTTP response (even an error status, e.g. this CDN 403s a
        # bare root request) still proves the network path is up. Only
        # connection-level failures (DNS, timeout, refused) mean "offline".
        return True
    except Exception:
        return False

def maybe_auto_sync(args, config):
    """Once-a-day, best-effort refresh so non-technical users get updated
    verse availability without ever running 'slverse sync' themselves.
    Gated on a plain elapsed-time check (no network) on every call, so the
    common case (already synced today) costs nothing.

    Runs as a detached background subprocess by default (auto_sync_background,
    see DEFAULT_CONFIG) so it never holds up the command that triggered it -
    a full multi-language sync can take a while and the caller almost always
    just wants their extract/find/bulk to proceed. Set auto_sync_background
    to false to restore the old behavior of syncing inline before proceeding."""
    if getattr(args, "no_auto_sync", False):
        return
    if config.get("auto_sync", "true").strip().lower() not in ("true", "1", "yes"):
        return

    try:
        interval_hours = float(config.get("auto_sync_interval_hours", DEFAULT_CONFIG["auto_sync_interval_hours"]))
    except ValueError:
        interval_hours = 24.0

    state = get_state()
    last_attempt = state.get("_auto_sync", {}).get("last_attempt", 0)
    if time.time() - last_attempt < interval_hours * 3600:
        return

    # Mark the attempt regardless of outcome, so a flaky/offline connection
    # doesn't retry (and pause) on every single command for the rest of the day.
    state.setdefault("_auto_sync", {})["last_attempt"] = time.time()
    save_state(state)

    if not internet_available():
        return

    background = config.get("auto_sync_background", DEFAULT_CONFIG["auto_sync_background"]).strip().lower() in ("true", "1", "yes")
    if background:
        print("Refreshing sign language availability in the background (runs about once a day)...", file=sys.stderr)
        try:
            subprocess.Popen(
                [sys.executable, str(Path(__file__).resolve()), "sync", "--quiet"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except Exception:
            pass
        return

    print("Checking for updated sign language availability (runs about once a day)...", file=sys.stderr)
    langs = get_lang_list(config)
    state = get_state()  # re-read: sync_languages below expects the latest on-disk state
    sync_languages(langs, config, state, quiet=True)
    save_state(state)

def clamp_offset_window(natural_start, natural_end, offset_start, offset_end, lang="", min_duration=0.1):
    """Apply --offset-start/--offset-end to (natural_start, natural_end) and
    clamp the result to the verse's own natural window - a 12s verse only
    has 12s to offset within (e.g. offset_start=3.567, offset_end=-1.997
    asks for the 3.567s-10.003s slice, entirely inside those 12s: passes
    through untouched). An offset that would push start before 0, past the
    verse's own end, or end before its own start (individually or combined)
    is a real overshoot - JW's markers don't tell us anything reliable
    about what comes before/after this verse's own window, so rather than
    silently referencing whatever happens to be there, this clamps back to
    the natural window's own edges (or the whole natural window, if the
    combination collapsed to nothing) and prints what happened."""
    start = natural_start + (offset_start or 0.0)
    end = natural_end + (offset_end or 0.0)
    natural_duration = natural_end - natural_start

    clamped = False
    if start < 0.0:
        start = 0.0
        clamped = True
    if start > natural_end - min_duration:
        start = max(0.0, natural_end - min_duration)
        clamped = True
    if end > natural_end:
        end = natural_end
        clamped = True
    if end < natural_start + min_duration:
        end = natural_start + min_duration
        clamped = True
    if end - start < min_duration:
        start, end = natural_start, natural_end
        clamped = True

    if clamped:
        prefix = f"[{lang}] " if lang else ""
        print(f"{prefix}--offset-start/--offset-end overshot this verse's own {natural_duration:.3f}s window - clamped to {start - natural_start:.3f}s..{end - natural_start:.3f}s (relative to its natural start).")
    return start, end

def resolve_verse_window(lang, book_num, chapter, verses, config, keep_end_transition=False, trim_mid_transitions=None, offset_start=0.0, offset_end=0.0, clip_window=None):
    """Return (start, end, url, checksum, valid_verses, source_labels,
    kept_segments) for a verse range, using the saved per-language index
    when we have it and falling back to a live API call (which also
    backfills the index) when we don't. source_labels are the source
    video's own per-verse caption text straight from JW's marker metadata
    (e.g. "Mazmur 16:11" for INI) - used by build_overlay_filter to size the
    delogo box against what's actually burned in, not our replacement text.
    kept_segments is resolve_kept_segments' output - always [(0, end-start)]
    unless trim_mid_transitions ends up true.

    keep_end_transition (from --keep-end-transition) forces the trailing
    fade-out/endscreen to stay even if trim_end_transition's config default
    is true. trim_mid_transitions (from --trim-mid-transitions), when not
    None, overrides that config key's default for this call instead of
    reading it.

    offset_start/offset_end (from --offset-start/--offset-end, seconds,
    either sign) are the old ffv -s/-e - added straight onto the verse
    range's own computed start/end (after trim_end_transition, before
    kept_segments), a manual nudge on top of the metadata-derived window
    rather than a raw -ss/-to into the whole file: +5.302 on offset_start
    plays from 5.302s into the verse through its natural end; a negative
    offset_end ends that many seconds early. See clamp_offset_window for
    what happens if they overshoot the verse's own natural boundaries."""
    key = f"{book_num}_{chapter}"
    index = load_index(lang)
    entry = index.get(key)

    if not entry:
        data = get_pub_media_links(lang, book_num)
        if not data:
            return None
        file = find_track(data, lang, chapter)
        if not file:
            return None
        entry = {
            "url": file["file"]["url"],
            "checksum": file["file"]["checksum"],
            "book_num": book_num,
            "chapter": chapter,
            "markers": verse_markers(file),
            "downloaded": False,
        }
        index[key] = entry
        save_index(lang, index)

    chapters_meta = markers_to_verse_times(entry.get("markers"))
    valid_verses = [v for v in verses if v in chapters_meta]
    if not valid_verses:
        return None

    start = chapters_meta[valid_verses[0]]["start"]
    end = chapters_meta[valid_verses[-1]]["end"]
    trim_end = str(config.get("trim_end_transition", DEFAULT_CONFIG["trim_end_transition"])).strip().lower() != "false"
    if keep_end_transition:
        trim_end = False
    if trim_end:
        end_transition = chapters_meta[valid_verses[-1]].get("end_transition", 0)
        if end_transition > 0 and end - end_transition > start:
            end -= end_transition

    if clip_window:
        offset_start, clip_end = clip_window
        offset_end = clip_end - (end - start)
    if offset_start or offset_end:
        start, end = clamp_offset_window(start, end, offset_start, offset_end, lang=lang)

    trim_mid = str(config.get("trim_mid_transitions", DEFAULT_CONFIG["trim_mid_transitions"])).strip().lower() == "true"
    if trim_mid_transitions is not None:
        trim_mid = trim_mid_transitions
    kept_segments = resolve_kept_segments(chapters_meta, valid_verses, start, end, trim_mid)

    source_labels = [chapters_meta[v]["label"] for v in valid_verses if chapters_meta[v].get("label")]
    return start, end, entry["url"], entry.get("checksum"), valid_verses, source_labels, kept_segments

def overlay_fade_outs(lang, book_num, chapter, valid_verses, start, end, config, keep_end_transition=False, trim_mid_transitions=None):
    """Metadata-derived fade-out intervals, relative to this output window."""
    meta = markers_to_verse_times(load_index(lang).get(f"{book_num}_{chapter}", {}).get("markers", []))
    trim_end = str(config.get("trim_end_transition", DEFAULT_CONFIG["trim_end_transition"])).strip().lower() != "false" and not keep_end_transition
    trim_mid = str(config.get("trim_mid_transitions", DEFAULT_CONFIG["trim_mid_transitions"])).strip().lower() == "true" if trim_mid_transitions is None else trim_mid_transitions
    fades = []
    for v in valid_verses:
        transition = meta.get(v, {}).get("end_transition", 0)
        if not transition or (v == valid_verses[-1] and trim_end) or (v != valid_verses[-1] and trim_mid):
            continue
        fade_end = meta[v]["end"]
        fade_start = fade_end - transition
        if fade_end > start and fade_start < end:
            fades.append((max(fade_start, start) - start, min(fade_end, end) - start))
    return fades

def resolve_retime_args(args, duration):
    """Turn --slow/--fast's raw TIME strings into (mode, boundaries,
    speed), validated against this window's actual `duration`. Returns
    (None, None, None, None) when neither flag was passed. Boundaries are
    seconds relative to the verse's own start (0), matching
    extract_verse_sections."""
    slow, fast, speed_arg = getattr(args, "slow", None), getattr(args, "fast", None), getattr(args, "speed", None)
    if slow:
        mode, raw = "slow", slow
    elif fast:
        mode, raw = "fast", fast
    else:
        return None, None, None, None

    speed = speed_arg if speed_arg is not None else (0.5 if mode == "slow" else 3.0)
    try:
        boundaries = [parse_hms(t) for t in raw]
    except ValueError:
        return None, None, None, f"Could not parse --{mode} time(s): {raw}"
    if boundaries != sorted(set(boundaries)) or any(b <= 0 or b >= duration for b in boundaries):
        return None, None, None, f"--{mode} times must be strictly increasing and within (0, {duration:.2f}s) - got {raw}"
    return mode, boundaries, speed, None

def parse_clip_window(value):
    try:
        start, end = (float(part) for part in value.split(":", 1))
    except (ValueError, AttributeError):
        raise argparse.ArgumentTypeError("must be START:END seconds relative to the verse window")
    if start < 0 or end < 0:
        raise argparse.ArgumentTypeError("START and END must be non-negative")
    return start, end

def extract_one_lang(lang, book_name, book_num, chapter, verses, args, config, state):
    window = resolve_verse_window(
        lang, book_num, chapter, verses, config,
        keep_end_transition=getattr(args, "keep_end_transition", False),
        trim_mid_transitions=True if getattr(args, "trim_mid_transitions", False) else None,
        offset_start=getattr(args, "offset_start", None) or 0.0,
        offset_end=getattr(args, "offset_end", None) or 0.0,
        clip_window=getattr(args, "clip_window", None),
    )
    if not window:
        return lang, None, f"Verses {verses} not found for {lang} (video may not exist for this chapter in this language yet)."
    start_time, end_time, url, checksum, valid_verses, source_labels, kept_segments = window
    fade_outs = overlay_fade_outs(lang, book_num, chapter, valid_verses, start_time, end_time, config, getattr(args, "keep_end_transition", False), True if getattr(args, "trim_mid_transitions", False) else None)
    verses_str = format_verses_label(valid_verses)
    out_filename = f"{book_name.replace(' ', '_')}_{chapter}_{'_'.join(map(str, valid_verses))}_{lang}.mp4"
    metadata_args = output_metadata_args(book_name, chapter, verses_str, lang, url, checksum)

    if not args.write:
        # Default: preview only, nothing written to disk deliberately - the
        # locally cached chapter file is the one exception, and it's opt-out
        # rather than opt-in (see preview_source). 'cache' (the default)
        # downloads the chapter once if it isn't already cached and plays
        # from that local copy from then on, so previewing more verses from
        # the same chapter costs no further bandwidth; 'remote' always
        # streams straight from the URL instead and never touches disk.
        # Either way the remote URL is still shown alongside what's playing.
        source = url
        if config.get("preview_source", DEFAULT_CONFIG["preview_source"]).strip().lower() != "remote":
            cache_dir = Path(config.get("cache_dir", DEFAULT_CONFIG["cache_dir"])) / lang
            cached = cache_dir / url.split("/")[-1]
            if cached.exists():
                note_cache_use(state, cached)
                source = str(cached)
            else:
                cache_dir.mkdir(parents=True, exist_ok=True)
                if download_file(url, cached, expected_checksum=checksum):
                    note_cache_use(state, cached)
                    enforce_cache_budget(config, state, protect=cached)
                    source = str(cached)
                # else: download failed (offline, CDN hiccup, etc) - fall
                # back to streaming straight from the URL for this preview.
        preview_verse(source, start_time, end_time, book_name, chapter, verses_str, lang, config, use_mpv=args.play, source_url=url, source_labels=source_labels, fade_outs=fade_outs)
        return lang, None, None

    mode, boundaries, speed, retime_error = resolve_retime_args(args, end_time - start_time)
    if retime_error:
        return lang, None, retime_error

    if args.onthefly:
        extract_mode = "onthefly"
    elif args.cache:
        extract_mode = "cache"
    else:
        extract_mode = config.get("extract_mode", DEFAULT_CONFIG["extract_mode"])

    if mode and len(kept_segments) > 1:
        print(f"[{lang}] --slow/--fast doesn't support trim_mid_transitions yet - mid-range transitions will play through untouched.")

    if extract_mode == "onthefly":
        if mode:
            extract_verse_sections(url, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, mode, boundaries, speed, source_labels=source_labels)
        else:
            extract_verse(url, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, remote=True, source_labels=source_labels, kept_segments=kept_segments, fade_outs=fade_outs, metadata_args=metadata_args)
    else:
        cache_dir = Path(config["cache_dir"]) / lang
        cache_dir.mkdir(parents=True, exist_ok=True)
        local_path = cache_dir / url.split("/")[-1]

        if not local_path.exists():
            if not download_file(url, local_path, expected_checksum=checksum):
                return lang, None, f"Download failed for {lang} {book_name} {chapter}."
        else:
            print(f"[{lang}] Using cached video file.")

        note_cache_use(state, local_path)
        if mode:
            extract_verse_sections(local_path, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, mode, boundaries, speed, source_labels=source_labels)
        else:
            extract_verse(local_path, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, remote=False, source_labels=source_labels, kept_segments=kept_segments, fade_outs=fade_outs, metadata_args=metadata_args)

        key = f"{book_num}_{chapter}"
        index = load_index(lang)
        index.setdefault(key, {})["downloaded"] = True
        save_index(lang, index)

        if config.get("cache_policy") == "delete_after_use":
            os.remove(local_path)
            state["_cache_access"].pop(str(local_path), None)
            print(f"[{lang}] Cleaned up cached video file.")
        else:
            enforce_cache_budget(config, state, protect=local_path)

    if args.play:
        if command_exists("mpv"):
            launch_mpv([out_filename], config=config)
        else:
            print(f"[{lang}] (--play needs mpv, which isn't installed)")

    return lang, out_filename, None

def cmd_extract(args, config):
    langs = get_lang_list(config, args.lang) if (args.lang.lower() == "all" or "," in args.lang) else [args.lang.upper()]
    ref = args.reference

    book_name, chapter, verses = parse_reference(ref)
    if not book_name:
        print(f"Could not parse reference: {ref}. Use format 'Book Chapter:Verse(s)' (e.g., 'Rev 13:1, 2')")
        return

    state = get_state()
    book_num = resolve_book_number(book_name, config.get("api_language", "E"), state=state)
    if not book_num:
        common = {"gen": 1, "ex": 2, "ps": 19, "psalms": 19, "prov": 20, "matt": 40, "rev": 66, "revelation": 66}
        for k, v in common.items():
            if k in book_name.lower():
                book_num = v
                break
    if not book_num:
        print(f"Could not resolve book number for {book_name}. Try the book number directly (e.g., '66 13:1, 2').")
        return

    if not args.write and len(langs) > 1:
        print(f"Preview mode only plays one language at a time (got {', '.join(langs)}).")
        print("Pass --write/-f to batch-export all of them, or give a single language to preview.")
        return

    if (args.slow or args.fast) and not args.write:
        print("--slow/--fast need --write/-f (there's no live preview for sectioned retiming).")
        return

    verb = "Extracting" if args.write else "Previewing"
    print(f"{verb} {book_name} {chapter}:{format_verses_label(verses)} for {', '.join(langs)}...")

    results = []
    if len(langs) > 1:
        workers = int(config.get("extract_workers", DEFAULT_CONFIG["extract_workers"]) or 1)
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            futures = [pool.submit(extract_one_lang, lang, book_name, book_num, chapter, verses, args, config, state) for lang in langs]
            for f in concurrent.futures.as_completed(futures):
                results.append(f.result())
    else:
        results.append(extract_one_lang(langs[0], book_name, book_num, chapter, verses, args, config, state))

    save_state(state)
    print()
    for lang, filename, error in results:
        if error:
            print(f"[{lang}] {error}")
        elif filename:
            print(f"[{lang}] Successfully created: {filename}")
        else:
            print(f"[{lang}] Preview finished.")

def cmd_find(args, config):
    """Default output is a compact checkmark table grouped by language -
    easiest to scan at a glance, and the format non-technical users actually
    want. --verbose brings back the full URL/mpv-command block per match;
    --json is for scripts (always the full lang x verse array, found or
    not). 'verse' takes a single verse, a range (25-27), or a comma list,
    the same syntax extract's reference string uses."""
    state = get_state()
    jwlangs = load_jwlangs()
    book_num = resolve_book_number(args.book, config.get("api_language", "E"), state=state)
    save_state(state)  # persist any newly-cached book-name metadata even if nothing matches below
    if not book_num:
        print(f"Could not resolve book: {args.book}")
        return

    try:
        verses = expand_verses(args.verse)
    except ValueError:
        print(f"Could not parse verse(s): {args.verse}")
        return

    key = f"{book_num}_{args.chapter}"
    results = []
    for lang in synced_languages():
        entry = load_index(lang).get(key)
        times = markers_to_verse_times(entry.get("markers")) if entry else {}
        jwentry = jwlangs.get(lang.upper())
        for verse in verses:
            marker = times.get(verse)
            results.append({
                "lang": lang,
                "lang_name": jwentry[1] if jwentry else None,
                "book": args.book,
                "chapter": args.chapter,
                "verse": verse,
                "found": marker is not None,
                "url": entry["url"] if (entry and marker) else None,
                "start": marker["start"] if marker else None,
                "end": marker["end"] if marker else None,
                "label": marker.get("label") if marker else None,
            })

    if args.json:
        print(json.dumps(results, indent=2))
        return

    if not results:
        print("No languages synced yet. Try 'slverse sync all' first.")
        return
    if not any(r["found"] for r in results):
        verse_label = str(verses[0]) if len(verses) == 1 else f"{verses[0]}-{verses[-1]}"
        print(f"No synced language has {args.book} {args.chapter}:{verse_label} yet.")
        print("Try 'slverse sync all' first, or sync a specific language.")
        return

    by_lang = {}
    for r in results:
        by_lang.setdefault(r["lang"], []).append(r)

    if args.verbose:
        for lang, rows in by_lang.items():
            found_rows = [r for r in rows if r["found"]]
            if not found_rows:
                continue
            print(f"\n{lang_display(lang, jwlangs)}")
            for r in found_rows:
                print(f"  {r['label'] or ''}")
                print(f"  {r['url']}")
                start_str = f"{int(r['start']//3600):02d}:{int(r['start']%3600//60):02d}:{r['start']%60:06.3f}"
                dur = r["end"] - r["start"]
                print(f"  mpv --start={start_str} --length={dur:.3f} '{r['url']}'")
    else:
        for lang, rows in by_lang.items():
            for r in rows:
                mark = "✅" if r["found"] else "❌"
                print(f"{mark} {lang_display(lang, jwlangs)} {r['book']} {r['chapter']}:{r['verse']}")
            print()

    if args.play:
        if not command_exists("mpv"):
            print("(--play needs mpv, which isn't installed)")
        else:
            to_play = [r for r in results if r["found"]]
            multi = len(to_play) > 1
            window_size = config.get("preview_window_size", DEFAULT_CONFIG["preview_window_size"])
            if multi:
                print(f"\nOpening {len(to_play)} preview windows, one per language, all paused - unpause each to review it.")
            for i, r in enumerate(to_play):
                start_str = f"{int(r['start']//3600):02d}:{int(r['start']%3600//60):02d}:{r['start']%60:06.3f}"
                dur = r["end"] - r["start"]
                # Multiple matches: windowed (not fullscreen, so several can
                # be visible at once), sized to preview_window_size (percent
                # of screen, aspect preserved - mpv works this out itself,
                # no need to know actual screen resolution here), and
                # cascaded a bit so they don't stack exactly on top of each
                # other. A single match keeps the old fullscreen-and-autoplay
                # behavior. Every mpv window here is spawned via
                # subprocess.Popen with wait=False, so this loop never
                # blocks - true on macOS/Linux/Windows alike, since a Popen
                # child outlives its parent's normal exit on all three
                # without any extra detachment flags.
                launch_mpv(
                    [f"--start={start_str}", f"--length={dur:.3f}", r["url"]],
                    wait=False,
                    fullscreen=not multi,
                    paused=multi,
                    config=config,
                    autofit=window_size if multi else None,
                    geometry=f"+{40 + (i % 5) * 60}+{40 + (i % 5) * 60}" if multi else None,
                )

def cmd_cache(args, config):
    state = get_state()
    cache_dir = Path(config["cache_dir"])

    if args.action == "clean":
        target = cache_dir / args.lang.upper() if args.lang else cache_dir
        if target.exists():
            shutil.rmtree(target)
            print(f"Cache cleared: {target}")
        else:
            print("Nothing to clear.")
        return

    if args.action == "trim":
        enforce_cache_budget(config, state)
        save_state(state)
        return

    if args.action == "list":
        if not cache_dir.exists():
            print("Cache is empty.")
            return
        total = 0
        for lang_dir in sorted(cache_dir.iterdir()):
            if not lang_dir.is_dir():
                continue
            size = cache_dir_size(lang_dir)
            total += size
            print(f"  {lang_dir.name:8} {size/1e6:8.1f} MB")
        max_gb = config.get("cache_max_gb", DEFAULT_CONFIG["cache_max_gb"])
        print(f"Total: {total/1e9:.2f} GB (cap: {max_gb} GB, policy: {config.get('cache_policy')})")

def parse_book_range(spec):
    if not spec or spec.lower() == "all":
        return set(range(1, 67))
    result = set()
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            result.update(range(int(a), int(b) + 1))
        else:
            result.add(int(part))
    return result

def bulk_one_lang(lang, books, args, config):
    index = load_index(lang)
    if not index:
        print(f"[{lang}] not synced yet — syncing first...")
        _, entries = sync_one_lang(lang)
        save_index(lang, entries)
        index = entries

    targets = sorted(
        (e["book_num"], e["chapter"], e) for e in index.values() if e.get("book_num") in books
    )
    if not targets:
        print(f"[{lang}] nothing to do for the requested book range.")
        return

    out_dir = Path(args.out) if args.out else Path(config["cache_dir"]) / "bulk" / lang
    out_dir.mkdir(parents=True, exist_ok=True)
    print(f"[{lang}] processing {len(targets)} chapter(s) into {out_dir}...")

    engine = config.get("interpolation_engine", "none") if args.interpolate else "none"
    bulk_config = dict(config, interpolation_engine=engine)

    for book_num, chapter, entry in targets:
        out_file = out_dir / f"{lang}_{book_num:02d}_{chapter:02d}.mp4"
        if out_file.exists() and not args.overwrite:
            continue

        chapter_times = markers_to_verse_times(entry.get("markers"))
        duration = max((v["end"] for v in chapter_times.values()), default=None) if chapter_times else None

        with tempfile.TemporaryDirectory() as tmp_dir:
            tmp_download = Path(tmp_dir) / "chapter.mp4"
            if not download_file(entry["url"], tmp_download, expected_checksum=entry.get("checksum")):
                print(f"[{lang}] {book_num}_{chapter}: download failed, skipping.")
                continue
            if engine == "none":
                shutil.copy(tmp_download, out_file)
            elif engine == "rife":
                ffrife = load_ffrife()
                ffrife.interpolate(str(tmp_download), str(out_file), ffrife_config_for(bulk_config), fps=60)
            else:
                minterp = "minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1" if engine == "minterpolate" else "framerate=fps=60"
                run_ffmpeg(["-i", str(tmp_download), "-vf", minterp, "-c:a", "copy"] + build_encode_args(bulk_config) + [str(out_file)], duration=duration)
        print(f"[{lang}] {book_num}_{chapter}: done.")

    print(f"[{lang}] bulk complete.")

def cmd_bulk(args, config):
    langs = get_lang_list(config, args.lang) if (args.lang.lower() == "all" or "," in args.lang) else [args.lang.upper()]
    books = parse_book_range(args.books)
    workers = int(config.get("sync_workers", DEFAULT_CONFIG["sync_workers"]) or 1)

    if len(langs) > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            list(pool.map(lambda lang: bulk_one_lang(lang, books, args, config), langs))
    else:
        bulk_one_lang(langs[0], books, args, config)

# --- Main ---
def main():
    migrate_legacy_config_dir()
    parser = argparse.ArgumentParser(
        description="slverse - JW Sign Language Video Tool",
        epilog="Nearly all behavior is configurable - see 'slverse config list' or docs/slverse.md.",
    )
    subparsers = parser.add_subparsers(dest="command")

    p_setup = subparsers.add_parser("setup", help="Interactive first-run setup (dependencies, languages, cache, 60fps, PATH)")
    p_setup.add_argument("--non-interactive", action="store_true", help="Only install dependencies, skip the Q&A")

    p_config = subparsers.add_parser("config", help="Manage configuration")
    p_config.add_argument("action", choices=["set", "get", "list"], nargs="?", default="list")
    p_config.add_argument("key", nargs="?")
    p_config.add_argument("value", nargs="?")

    p_langs = subparsers.add_parser("langs", help="Show configured languages and when each was last synced")
    p_langs.add_argument("--discover", action="store_true", help="Also list every sign language JW.org publishes NWT video in")

    p_sync = subparsers.add_parser("sync", help="Sync metadata (and verse markers) so extract can skip video downloads to look up timestamps")
    p_sync.add_argument("lang", nargs="?", default="all", help="Sign language code, comma list, or 'all' for your configured list (default: all)")
    p_sync.add_argument("-q", "--quiet", action="store_true", help="Suppress per-language progress output (used internally by the background auto-sync)")

    p_extract = subparsers.add_parser("extract", help="Extract and overlay verses from a chapter")
    p_extract.add_argument("lang", help="Sign language code, comma list, or 'all' for your configured list")
    p_extract.add_argument("reference", help="Bible reference (e.g., 'Rev 13:1, 2')")
    p_extract.add_argument("-f", "--write", action="store_true", help="Encode and save the output file. Default is preview-only: play the verse with its overlay (delogo box shown, not applied) and write nothing.")
    p_extract.add_argument("-m", "--play", action="store_true", help="With --write, also play the finished file via mpv. Without --write, preview via mpv instead of ffplay.")
    p_extract.add_argument("--interpolate", action="store_true", help="Force interpolation on output")
    p_extract.add_argument("--onthefly", action="store_true", help="Stream-extract from the source URL; never store the full chapter on disk (default)")
    p_extract.add_argument("--cache", action="store_true", help="Download and keep the full chapter in the local cache instead of streaming on the fly")
    p_extract.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")
    p_extract.add_argument("--keep-end-transition", action="store_true", help="Keep the trailing fade-out/copyright-endscreen this once, overriding trim_end_transition for this run only")
    p_extract.add_argument("--trim-mid-transitions", action="store_true", help="Also cut mid-range paragraph transitions inside a multi-verse range this once, overriding trim_mid_transitions for this run only")
    p_extract.add_argument("-s", "--offset-start", type=float, metavar="SECONDS", help="Nudge the verse range's own start by this many seconds (either sign) - e.g. 5.302 to skip the first 5.302s and play to the natural end")
    p_extract.add_argument("-e", "--offset-end", type=float, metavar="SECONDS", help="Nudge the verse range's own end by this many seconds (either sign) - e.g. -3 to end 3s early")
    p_extract.add_argument("--window", dest="clip_window", type=parse_clip_window, metavar="START:END", help="Keep one relative slice of the natural verse window, e.g. --window 3.567:10.003")
    p_extract_retime = p_extract.add_mutually_exclusive_group()
    p_extract_retime.add_argument("--slow", nargs="+", metavar="TIME", help="Split the verse at TIME(s) (seconds or HH:MM:SS, relative to the verse's own start) into alternating normal/slow sections (2nd, 4th, ... retimed). Needs --write. Video-only output (matches the standalone ffslow tool).")
    p_extract_retime.add_argument("--fast", nargs="+", metavar="TIME", help="Same as --slow but alternating normal/fast sections (1st, 3rd, ... retimed) - matches the standalone fffast tool.")
    p_extract.add_argument("--speed", type=parse_speed, metavar="N", help="Retime multiplier for --slow/--fast - decimal (0.5), fraction (1/3), or percent (150%%). Default: 0.5 for --slow, 3 for --fast.")

    p_find = subparsers.add_parser("find", help="Search already-synced languages for who has a given verse")
    p_find.add_argument("book", help="Book name or number")
    p_find.add_argument("chapter", type=int)
    p_find.add_argument("verse", help="Single verse, a range (25-27), or a comma list (1,3,5)")
    p_find.add_argument("--play", action="store_true", help="Also stream-preview each match with mpv")
    p_find.add_argument("-v", "--verbose", action="store_true", help="Show full match details (URL, mpv command) instead of the compact checkmark list")
    p_find.add_argument("--json", action="store_true", help="Machine-readable JSON instead of the checkmark list (always includes every synced language, found or not)")
    p_find.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")

    p_cache = subparsers.add_parser("cache", help="Manage cache")
    p_cache.add_argument("action", choices=["clean", "list", "trim"])
    p_cache.add_argument("--lang", help="Limit 'clean' to one language")

    p_bulk = subparsers.add_parser("bulk", help="Precompute whole chapters (optionally interpolated) ahead of time, instead of extracting on demand")
    p_bulk.add_argument("lang", help="Sign language code, comma list, or 'all' for your configured list")
    p_bulk.add_argument("--books", default="all", help="Book number range, e.g. '40-66' or '66' (default: all 66)")
    p_bulk.add_argument("--interpolate", action="store_true", help="Interpolate each chapter to 60fps using the configured engine")
    p_bulk.add_argument("--out", help="Output directory (default: <cache_dir>/bulk/<lang>)")
    p_bulk.add_argument("--overwrite", action="store_true", help="Reprocess chapters even if the output file already exists")
    p_bulk.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")

    args = parser.parse_args()
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)
    config = load_config()

    global FFMPEG_BIN, FFPROBE_BIN, FFPLAY_BIN, FONT_MAIN_WEIGHT, FONT_ESTIMATOR_WEIGHT, MAX_ATTEMPTS, RETRY_BACKOFF
    FFMPEG_BIN = resolve_ffmpeg_binary(config)
    FFPROBE_BIN = resolve_ffprobe_binary(config)
    FFPLAY_BIN = resolve_ffplay_binary(config)
    FONT_MAIN_WEIGHT = config.get("font_weight_main", DEFAULT_CONFIG["font_weight_main"])
    FONT_ESTIMATOR_WEIGHT = config.get("font_weight_estimator", DEFAULT_CONFIG["font_weight_estimator"])
    MAX_ATTEMPTS = int(config.get("download_max_attempts", DEFAULT_CONFIG["download_max_attempts"]))
    RETRY_BACKOFF = int(config.get("download_retry_backoff", DEFAULT_CONFIG["download_retry_backoff"]))

    if args.command == "setup":
        cmd_setup(args, config)
    elif args.command == "config":
        if args.action == "set" and args.key and args.value:
            cmd_config(args, config)
        elif args.action == "get" and args.key:
            cmd_config(args, config)
        elif args.action == "list":
            cmd_config(argparse.Namespace(key=None, value=None), config)
        else:
            print("Usage: slverse config set <key> <value>, or 'slverse config get <key>'")
    elif args.command == "langs":
        cmd_langs(args, config)
    elif args.command == "sync":
        cmd_sync(args, config)
    elif args.command == "extract":
        maybe_auto_sync(args, config)
        if args.interpolate and config.get("interpolation_engine") == "none":
            config["interpolation_engine"] = "minterpolate"
        cmd_extract(args, config)
    elif args.command == "find":
        maybe_auto_sync(args, config)
        cmd_find(args, config)
    elif args.command == "cache":
        cmd_cache(args, config)
    elif args.command == "bulk":
        maybe_auto_sync(args, config)
        cmd_bulk(args, config)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
