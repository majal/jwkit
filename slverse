# --- Config Management ---
def load_config():
    config = DEFAULT_CONFIG.copy()
    if not CONFIG_FILE.exists():
        return config
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or line.startswith("["):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("'").strip('"')
                    config[k] = v
    except Exception as e:
        print(f"Warning: could not parse config: {e}")
    return config

def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        for k, v in config.items():
            f.write(f'{k} = "{v}"\n')

def get_state():
    """Small, fast-loading state: sync timestamps, cache-access bookkeeping,
    and cached book-name metadata. Per-language verse/marker indexes live in
    INDEX_DIR instead (see load_index/save_index) so state.json doesn't grow
    to tens of megabytes as more languages get synced."""
    if not STATE_FILE.exists():
        return {}
    try:
        with open(STATE_FILE, "r") as f:
            state = json.load(f)
    except Exception:
        return {}

    legacy_langs = [k for k in state if not k.startswith("_")]
    if legacy_langs:
        print(f"One-time migration: moving {len(legacy_langs)} language index(es) out of state.json into {INDEX_DIR}/")
        for lang in legacy_langs:
            entries = state.pop(lang)
            existing = load_index(lang)
            existing.update(entries)
            save_index(lang, existing)
        save_state(state)

    return state

def save_state(state):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)

def load_index(lang):
    path = INDEX_DIR / f"{lang}.json"
    if not path.exists():
        return {}
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def save_index(lang, entries):
    INDEX_DIR.mkdir(parents=True, exist_ok=True)
    with open(INDEX_DIR / f"{lang}.json", "w") as f:
        json.dump(entries, f, indent=2)

def synced_languages():
    """Languages with an on-disk index, for commands like 'find' that search
    across everything already synced rather than just the configured list."""
    if not INDEX_DIR.exists():
        return []
    return sorted(p.stem for p in INDEX_DIR.glob("*.json"))

def load_jwlangs():
    try:
        with open(JWLANGS_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return {}

def lang_display(code, jwlangs=None):
    jwlangs = jwlangs if jwlangs is not None else load_jwlangs()
    entry = jwlangs.get(code.upper())
    return f"{code.upper()} ({entry[1]})" if entry else code.upper()

def get_lang_list(config, lang_arg=None):
    """Resolve a language argument to a list of codes.
    'all' or None uses the configured language list; a comma list is split;
    anything else is a single code."""
    if lang_arg and lang_arg.lower() != "all":
        parts = lang_arg.split(",")
    else:
        parts = config.get("languages", DEFAULT_CONFIG["languages"]).split(",")
    return [p.strip().upper() for p in parts if p.strip()]

# --- System Check & Setup ---
def command_exists(cmd):
    return shutil.which(cmd) is not None

def focus_process(pid):
    """macOS-only: activate a just-launched GUI process by pid via System
    Events. mpv and ffplay are both bare CLI binaries there (no signed
    .app bundle), so launching either from a background terminal process
    doesn't get the NSApplication activation a Dock/Finder launch would.
    A short retry loop covers the moment between process start and the
    window registering with the WindowServer - the very first attempt
    typically fails simply because the window doesn't exist yet."""
    if platform.system() != "Darwin":
        return
    script = f'tell application "System Events" to set frontmost of (first process whose unix id is {pid}) to true'
    for attempt in range(5):
        if attempt:
            time.sleep(0.3)
        result = subprocess.run(["osascript", "-e", script], capture_output=True)
        if result.returncode == 0:
            return

def launch_mpv(args, wait=True):
    """Spawn mpv with `args` and try to bring it to the front on every OS.
    --force-window=immediate plus mpv's own --focus-on=open default (mpv
    0.34+) cover Linux/Windows window managers reasonably well; see
    focus_process for the macOS-specific piece. --no-keep-open matches old
    ffv's mpv_opts (mpv's own default is already --keep-open=no, so this
    is belt-and-suspenders, not a behavior change)."""
    cmd = ["mpv", "--no-config", "--fullscreen=yes", "--force-window=immediate", "--no-keep-open"] + list(args)
    proc = subprocess.Popen(cmd)
    focus_process(proc.pid)
    if wait:
        proc.wait()
    return proc

def launch_ffplay(args, wait=True):
    """Same idea as launch_mpv but for ffplay, used by the default preview
    path (see preview_verse) - ffplay is SDL-based and usually grabs focus
    fine on its own, but macOS's bare-CLI-binary activation gap applies to
    it exactly the same way it does to mpv."""
    cmd = [FFPLAY_BIN, "-hide_banner", "-loglevel", "error", "-autoexit"] + list(args)
    proc = subprocess.Popen(cmd)
    focus_process(proc.pid)
    if wait:
        proc.wait()
    return proc

def detect_hardware_encoder():
    """Defaults to 'cpu' (libx264) everywhere. Measured directly on this
    machine's Apple Silicon GPU for a 31s 720p verse clip: videotoolbox at
    the quality setting matching crf 20 produced an 8.0MB file (SSIM
    0.99786 against the source), while libx264 crf 20 preset slow produced
    a 3.1MB file - close to the 2.9MB source itself - at SSIM 0.99752,
    a difference too small to see. Encode time was nearly identical either
    way (3.6s vs 3.0s for that clip) - GPU's speed advantage isn't
    meaningful at these short clip lengths, so there's no real tradeoff:
    CPU gets a ~2.6x smaller file for immeasurably different quality.
    Matching bitrate explicitly (700kbps VBR) instead of crf made GPU
    *worse* than CPU at the same size (SSIM 0.99633 vs 0.99723) - x264's
    rate-distortion efficiency beats videotoolbox's at a fixed bitrate too.
    videotoolbox/nvenc remain available via 'slverse config set
    hardware_encoder videotoolbox' for anyone who wants GPU speed for bulk
    processing many chapters, where CPU's per-clip cost adds up."""
    return "cpu"

def ffmpeg_has_filter(ffmpeg_bin, filter_name):
    try:
        result = subprocess.run([ffmpeg_bin, "-hide_banner", "-filters"], capture_output=True, text=True, timeout=10)
        return filter_name in result.stdout
    except Exception:
        return False

def resolve_ffmpeg_binary(config):
    override = config.get("ffmpeg_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffmpeg-full"),
        *[p for p in FFMPEG_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffmpeg"),
    ] if c]
    for c in candidates:
        if ffmpeg_has_filter(c, "drawtext"):
            return c
    return candidates[0] if candidates else "ffmpeg"

def resolve_ffplay_binary(config):
    override = config.get("ffplay_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [shutil.which("ffplay-full"), shutil.which("ffplay")] if c]
    return candidates[0] if candidates else "ffplay"

def resolve_ffprobe_binary(config):
    override = config.get("ffprobe_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffprobe-full"),
        *[p for p in FFPROBE_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffprobe"),
    ] if c]
    return candidates[0] if candidates else "ffprobe"

_FFRIFE_MODULE = None

def load_ffrife():
    """Import the sibling `ffrife` script as a module (same pattern
    tests/support.py uses to load slverse itself). RIFE interpolation isn't
    Bible/JW-specific, so it lives in its own standalone, reusable tool
    (ffrife) instead of being duplicated here - other tools (ffslow's --ai
    flag) share the exact same RIFE install/interpolation logic this way.
    Cached at module level so repeated extract calls (e.g. multi-language
    ThreadPoolExecutor runs) don't re-parse/re-exec the script each time."""
    global _FFRIFE_MODULE
    if _FFRIFE_MODULE is None:
        script_path = Path(__file__).resolve().parent / "ffrife"
        loader = SourceFileLoader("ffrife", str(script_path))
        spec = importlib.util.spec_from_loader("ffrife", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        module.FFMPEG_BIN = FFMPEG_BIN
        module.FFPROBE_BIN = FFPROBE_BIN
        _FFRIFE_MODULE = module
    return _FFRIFE_MODULE

def ffrife_config_for(config):
    """Bridges slverse's own encode-quality settings into ffrife's config
    shape for one interpolate() call. ffrife's own config file only holds
    what's genuinely ffrife-specific (rife_binary_path, rife_fallback_engine);
    encode quality (hardware_encoder/video_crf/etc.) stays a single source
    of truth in slverse's config rather than needing to be kept in sync across
    two separate files."""
    ffrife = load_ffrife()
    ffrife_config = ffrife.load_config()
    for key in ("hardware_encoder", "video_codec", "video_crf", "video_preset"):
        if key in config:
            ffrife_config[key] = config[key]
    return ffrife_config

