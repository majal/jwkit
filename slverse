def migrate_legacy_config_dir():
    """One-time move from the pre-split ~/.config/maj-scripts/jwsl location
    (back when this tool was named jwsl and lived in maj-scripts) to this
    tool's own ~/.config/slverse now that it's split out into jwkit. Keeps
    an existing sync index/cache-size config from silently resetting."""
    if _LEGACY_CONFIG_DIR.exists() and not CONFIG_DIR.exists():
        CONFIG_DIR.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(_LEGACY_CONFIG_DIR), str(CONFIG_DIR))
        print(f"Moved your existing settings from {_LEGACY_CONFIG_DIR} to {CONFIG_DIR} (this tool is now 'slverse', split out of maj-scripts into jwkit).")

