    entries = {}
    for n in range(1, 67):
        entries.update(index_book(lang, n))
        print(f"  {lang} book {n}: indexed", end="\r")
    print(f"  {lang}: indexed {len(entries)} chapter(s) worth of tracks.       ")
    return lang, entries

def sync_languages(langs, config, state, quiet=False):
    """Core of 'slverse sync', factored out so the auto-sync path (see
    maybe_auto_sync) can reuse it without going through argparse. Mutates
    `state` in place; caller owns save_state()."""
    workers = int(config.get("sync_workers", DEFAULT_CONFIG["sync_workers"]) or 1)
    printer = (lambda *a, **k: None) if quiet else print

    printer(f"Syncing metadata for: {', '.join(langs)}")
    results = {}
    if len(langs) > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            for lang, entries in pool.map(sync_one_lang, langs):
                results[lang] = entries
    else:
        lang, entries = sync_one_lang(langs[0])
        results[lang] = entries

    now = time.time()
    for lang, entries in results.items():
        existing = load_index(lang)
        new_count = 0
        for key, entry in entries.items():
            prior = existing.get(key)
            if not prior or prior.get("checksum") != entry["checksum"]:
                entry["downloaded"] = prior.get("downloaded", False) if prior else False
                existing[key] = entry
                new_count += 1
            else:
                # keep markers/track fresh even when checksum matches
                prior["markers"] = entry["markers"]
        save_index(lang, existing)
        state.setdefault("_meta", {}).setdefault(lang, {})["last_synced"] = now
        printer(f"{lang}: {new_count} new/updated track(s).")

def cmd_sync(args, config):
    langs = get_lang_list(config, args.lang)
    state = get_state()
    sync_languages(langs, config, state)
    save_state(state)

def internet_available():
    try:
        urllib.request.urlopen(
            urllib.request.Request("https://b.jw-cdn.org", method="HEAD", headers={"User-Agent": "Mozilla/5.0"}),
            timeout=3,
        )
        return True
    except urllib.error.HTTPError:
        # A real HTTP response (even an error status, e.g. this CDN 403s a
        # bare root request) still proves the network path is up. Only
        # connection-level failures (DNS, timeout, refused) mean "offline".
        return True
    except Exception:
        return False

def maybe_auto_sync(args, config):
    """Once-a-day, best-effort background-ish refresh so non-technical users
    get updated verse availability without ever running 'slverse sync'
    themselves. Gated on a plain elapsed-time check (no network) on every
    call, so the common case (already synced today) costs nothing."""
    if getattr(args, "no_auto_sync", False):
        return
    if config.get("auto_sync", "true").strip().lower() not in ("true", "1", "yes"):
        return

    try:
        interval_hours = float(config.get("auto_sync_interval_hours", DEFAULT_CONFIG["auto_sync_interval_hours"]))
    except ValueError:
        interval_hours = 24.0

    state = get_state()
    last_attempt = state.get("_auto_sync", {}).get("last_attempt", 0)
    if time.time() - last_attempt < interval_hours * 3600:
        return

    # Mark the attempt regardless of outcome, so a flaky/offline connection
    # doesn't retry (and pause) on every single command for the rest of the day.
    state.setdefault("_auto_sync", {})["last_attempt"] = time.time()
    save_state(state)

    if not internet_available():
        return

    print("Checking for updated sign language availability (runs about once a day)...", file=sys.stderr)
    langs = get_lang_list(config)
    state = get_state()  # re-read: sync_languages below expects the latest on-disk state
    sync_languages(langs, config, state, quiet=True)
    save_state(state)

def resolve_verse_window(lang, book_num, chapter, verses, config):
    """Return (start, end, url, checksum, label) for a verse range, using the
    saved per-language index when we have it and falling back to a live API
    call (which also backfills the index) when we don't."""
    key = f"{book_num}_{chapter}"
    index = load_index(lang)
    entry = index.get(key)

    if not entry:
        data = get_pub_media_links(lang, book_num)
        if not data:
            return None
        file = find_track(data, lang, chapter)
        if not file:
            return None
        entry = {
            "url": file["file"]["url"],
            "checksum": file["file"]["checksum"],
            "book_num": book_num,
            "chapter": chapter,
            "markers": verse_markers(file),
            "downloaded": False,
        }
        index[key] = entry
        save_index(lang, index)

    chapters_meta = markers_to_verse_times(entry.get("markers"))
    valid_verses = [v for v in verses if v in chapters_meta]
    if not valid_verses:
        return None

    start = chapters_meta[valid_verses[0]]["start"]
    end = chapters_meta[valid_verses[-1]]["end"]
    return start, end, entry["url"], entry.get("checksum"), valid_verses

def resolve_retime_args(args, duration):
    """Turn --slow/--fast's raw TIME strings into (mode, boundaries,
    speed), validated against this window's actual `duration`. Returns
    (None, None, None, None) when neither flag was passed. Boundaries are
    seconds relative to the verse's own start (0), matching
    extract_verse_sections."""
    slow, fast, speed_arg = getattr(args, "slow", None), getattr(args, "fast", None), getattr(args, "speed", None)
    if slow:
        mode, raw = "slow", slow
    elif fast:
        mode, raw = "fast", fast
    else:
        return None, None, None, None

    speed = speed_arg if speed_arg is not None else (0.5 if mode == "slow" else 3.0)
    try:
        boundaries = [parse_hms(t) for t in raw]
    except ValueError:
        return None, None, None, f"Could not parse --{mode} time(s): {raw}"
    if boundaries != sorted(set(boundaries)) or any(b <= 0 or b >= duration for b in boundaries):
        return None, None, None, f"--{mode} times must be strictly increasing and within (0, {duration:.2f}s) - got {raw}"
    return mode, boundaries, speed, None

def extract_one_lang(lang, book_name, book_num, chapter, verses, args, config, state):
    window = resolve_verse_window(lang, book_num, chapter, verses, config)
    if not window:
        return lang, None, f"Verses {verses} not found for {lang} (video may not exist for this chapter in this language yet)."
    start_time, end_time, url, checksum, valid_verses = window
    verses_str = format_verses_label(valid_verses)
    out_filename = f"{book_name.replace(' ', '_')}_{chapter}_{'_'.join(map(str, valid_verses))}_{lang}.mp4"

    if not args.write:
        # Default: preview only, nothing written to disk - see preview_verse.
        # Always plays straight from the source (remote URL or, if --cache
        # was also passed, a locally cached chapter); no need for the
        # cache/onthefly branching below since nothing is being encoded to
        # keep.
        preview_verse(url, start_time, end_time, book_name, chapter, verses_str, lang, config, use_mpv=args.play)
        return lang, None, None

    mode, boundaries, speed, retime_error = resolve_retime_args(args, end_time - start_time)
    if retime_error:
        return lang, None, retime_error

    if args.onthefly:
        extract_mode = "onthefly"
    elif args.cache:
        extract_mode = "cache"
    else:
        extract_mode = config.get("extract_mode", DEFAULT_CONFIG["extract_mode"])

    if extract_mode == "onthefly":
        if mode:
            extract_verse_sections(url, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, mode, boundaries, speed)
        else:
            extract_verse(url, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, remote=True)
    else:
        cache_dir = Path(config["cache_dir"]) / lang
        cache_dir.mkdir(parents=True, exist_ok=True)
        local_path = cache_dir / url.split("/")[-1]

        if not local_path.exists():
            if not download_file(url, local_path, expected_checksum=checksum):
                return lang, None, f"Download failed for {lang} {book_name} {chapter}."
        else:
            print(f"[{lang}] Using cached video file.")

        note_cache_use(state, local_path)
        if mode:
            extract_verse_sections(local_path, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, mode, boundaries, speed)
        else:
            extract_verse(local_path, out_filename, start_time, end_time, book_name, chapter, verses_str, lang, config, remote=False)

        key = f"{book_num}_{chapter}"
        index = load_index(lang)
        index.setdefault(key, {})["downloaded"] = True
        save_index(lang, index)

        if config.get("cache_policy") == "delete_after_use":
            os.remove(local_path)
            state["_cache_access"].pop(str(local_path), None)
            print(f"[{lang}] Cleaned up cached video file.")
        else:
            enforce_cache_budget(config, state, protect=local_path)

    if args.play:
        if command_exists("mpv"):
            launch_mpv([out_filename])
        else:
            print(f"[{lang}] (--play needs mpv, which isn't installed)")

    return lang, out_filename, None

def cmd_extract(args, config):
    langs = get_lang_list(config, args.lang) if (args.lang.lower() == "all" or "," in args.lang) else [args.lang.upper()]
    ref = args.reference

    book_name, chapter, verses = parse_reference(ref)
    if not book_name:
        print(f"Could not parse reference: {ref}. Use format 'Book Chapter:Verse(s)' (e.g., 'Rev 13:1, 2')")
        return

    state = get_state()
    book_num = resolve_book_number(book_name, config.get("api_language", "E"), state=state)
    if not book_num:
        common = {"gen": 1, "ex": 2, "ps": 19, "psalms": 19, "prov": 20, "matt": 40, "rev": 66, "revelation": 66}
        for k, v in common.items():
            if k in book_name.lower():
                book_num = v
                break
    if not book_num:
        print(f"Could not resolve book number for {book_name}. Try the book number directly (e.g., '66 13:1, 2').")
        return

    if not args.write and len(langs) > 1:
        print(f"Preview mode only plays one language at a time (got {', '.join(langs)}).")
        print("Pass --write/-f to batch-export all of them, or give a single language to preview.")
        return

    if (args.slow or args.fast) and not args.write:
        print("--slow/--fast need --write/-f (there's no live preview for sectioned retiming).")
        return

    verb = "Extracting" if args.write else "Previewing"
    print(f"{verb} {book_name} {chapter}:{format_verses_label(verses)} for {', '.join(langs)}...")

    results = []
    if len(langs) > 1:
        workers = int(config.get("extract_workers", DEFAULT_CONFIG["extract_workers"]) or 1)
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            futures = [pool.submit(extract_one_lang, lang, book_name, book_num, chapter, verses, args, config, state) for lang in langs]
            for f in concurrent.futures.as_completed(futures):
                results.append(f.result())
    else:
        results.append(extract_one_lang(langs[0], book_name, book_num, chapter, verses, args, config, state))

    save_state(state)
    print()
    for lang, filename, error in results:
        if error:
            print(f"[{lang}] {error}")
        elif filename:
            print(f"[{lang}] Successfully created: {filename}")
        else:
            print(f"[{lang}] Preview finished (nothing written - pass --write/-f to save).")

def cmd_find(args, config):
    """Default output is a compact checkmark table grouped by language -
    easiest to scan at a glance, and the format non-technical users actually
    want. --verbose brings back the full URL/mpv-command block per match;
    --json is for scripts (always the full lang x verse array, found or
    not). 'verse' takes a single verse, a range (25-27), or a comma list,
    the same syntax extract's reference string uses."""
    state = get_state()
    jwlangs = load_jwlangs()
    book_num = resolve_book_number(args.book, config.get("api_language", "E"), state=state)
    save_state(state)  # persist any newly-cached book-name metadata even if nothing matches below
    if not book_num:
        print(f"Could not resolve book: {args.book}")
        return

    try:
        verses = expand_verses(args.verse)
    except ValueError:
        print(f"Could not parse verse(s): {args.verse}")
        return

    key = f"{book_num}_{args.chapter}"
    results = []
    for lang in synced_languages():
        entry = load_index(lang).get(key)
        times = markers_to_verse_times(entry.get("markers")) if entry else {}
        jwentry = jwlangs.get(lang.upper())
        for verse in verses:
            marker = times.get(verse)
            results.append({
                "lang": lang,
                "lang_name": jwentry[1] if jwentry else None,
                "book": args.book,
                "chapter": args.chapter,
                "verse": verse,
                "found": marker is not None,
                "url": entry["url"] if (entry and marker) else None,
                "start": marker["start"] if marker else None,
                "end": marker["end"] if marker else None,
                "label": marker.get("label") if marker else None,
            })

    if args.json:
        print(json.dumps(results, indent=2))
        return

    if not results:
        print("No languages synced yet. Try 'slverse sync all' first.")
        return
    if not any(r["found"] for r in results):
        verse_label = str(verses[0]) if len(verses) == 1 else f"{verses[0]}-{verses[-1]}"
        print(f"No synced language has {args.book} {args.chapter}:{verse_label} yet.")
        print("Try 'slverse sync all' first, or sync a specific language.")
        return

    by_lang = {}
    for r in results:
        by_lang.setdefault(r["lang"], []).append(r)

    if args.verbose:
        for lang, rows in by_lang.items():
            found_rows = [r for r in rows if r["found"]]
            if not found_rows:
                continue
            print(f"\n{lang_display(lang, jwlangs)}")
            for r in found_rows:
                print(f"  {r['label'] or ''}")
                print(f"  {r['url']}")
                start_str = f"{int(r['start']//3600):02d}:{int(r['start']%3600//60):02d}:{r['start']%60:06.3f}"
                dur = r["end"] - r["start"]
                print(f"  mpv --start={start_str} --length={dur:.3f} '{r['url']}'")
    else:
        for lang, rows in by_lang.items():
            for r in rows:
                mark = "✅" if r["found"] else "❌"
                print(f"{mark} {lang_display(lang, jwlangs)} {r['book']} {r['chapter']}:{r['verse']}")
            print()

    if args.play:
        if not command_exists("mpv"):
            print("(--play needs mpv, which isn't installed)")
        else:
            for r in results:
                if not r["found"]:
                    continue
                start_str = f"{int(r['start']//3600):02d}:{int(r['start']%3600//60):02d}:{r['start']%60:06.3f}"
                dur = r["end"] - r["start"]
                launch_mpv([f"--start={start_str}", f"--length={dur:.3f}", r["url"]], wait=False)

def cmd_cache(args, config):
    state = get_state()
    cache_dir = Path(config["cache_dir"])

    if args.action == "clean":
        target = cache_dir / args.lang.upper() if args.lang else cache_dir
        if target.exists():
            shutil.rmtree(target)
            print(f"Cache cleared: {target}")
        else:
            print("Nothing to clear.")
        return

    if args.action == "trim":
        enforce_cache_budget(config, state)
        save_state(state)
        return

    if args.action == "list":
        if not cache_dir.exists():
            print("Cache is empty.")
            return
        total = 0
        for lang_dir in sorted(cache_dir.iterdir()):
            if not lang_dir.is_dir():
                continue
            size = cache_dir_size(lang_dir)
            total += size
            print(f"  {lang_dir.name:8} {size/1e6:8.1f} MB")
        max_gb = config.get("cache_max_gb", DEFAULT_CONFIG["cache_max_gb"])
        print(f"Total: {total/1e9:.2f} GB (cap: {max_gb} GB, policy: {config.get('cache_policy')})")

def parse_book_range(spec):
    if not spec or spec.lower() == "all":
        return set(range(1, 67))
    result = set()
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            result.update(range(int(a), int(b) + 1))
        else:
            result.add(int(part))
    return result

def bulk_one_lang(lang, books, args, config):
    index = load_index(lang)
    if not index:
        print(f"[{lang}] not synced yet — syncing first...")
        _, entries = sync_one_lang(lang)
        save_index(lang, entries)
        index = entries

    targets = sorted(
        (e["book_num"], e["chapter"], e) for e in index.values() if e.get("book_num") in books
    )
    if not targets:
        print(f"[{lang}] nothing to do for the requested book range.")
        return

    out_dir = Path(args.out) if args.out else Path(config["cache_dir"]) / "bulk" / lang
    out_dir.mkdir(parents=True, exist_ok=True)
    print(f"[{lang}] processing {len(targets)} chapter(s) into {out_dir}...")

    engine = config.get("interpolation_engine", "none") if args.interpolate else "none"
    bulk_config = dict(config, interpolation_engine=engine)

    for book_num, chapter, entry in targets:
        out_file = out_dir / f"{lang}_{book_num:02d}_{chapter:02d}.mp4"
        if out_file.exists() and not args.overwrite:
            continue

        chapter_times = markers_to_verse_times(entry.get("markers"))
        duration = max((v["end"] for v in chapter_times.values()), default=None) if chapter_times else None

        with tempfile.TemporaryDirectory() as tmp_dir:
            tmp_download = Path(tmp_dir) / "chapter.mp4"
            if not download_file(entry["url"], tmp_download, expected_checksum=entry.get("checksum")):
                print(f"[{lang}] {book_num}_{chapter}: download failed, skipping.")
                continue
            if engine == "none":
                shutil.copy(tmp_download, out_file)
            elif engine == "rife":
                ffrife = load_ffrife()
                ffrife.interpolate(str(tmp_download), str(out_file), ffrife_config_for(bulk_config), fps=60)
            else:
                minterp = "minterpolate=fps=60:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1" if engine == "minterpolate" else "framerate=fps=60"
                run_ffmpeg(["-i", str(tmp_download), "-vf", minterp, "-c:a", "copy"] + build_encode_args(bulk_config) + [str(out_file)], duration=duration)
        print(f"[{lang}] {book_num}_{chapter}: done.")

    print(f"[{lang}] bulk complete.")

def cmd_bulk(args, config):
    langs = get_lang_list(config, args.lang) if (args.lang.lower() == "all" or "," in args.lang) else [args.lang.upper()]
    books = parse_book_range(args.books)
    workers = int(config.get("sync_workers", DEFAULT_CONFIG["sync_workers"]) or 1)

    if len(langs) > 1:
        with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
            list(pool.map(lambda lang: bulk_one_lang(lang, books, args, config), langs))
    else:
        bulk_one_lang(langs[0], books, args, config)

# --- Main ---
def main():
    migrate_legacy_config_dir()
    parser = argparse.ArgumentParser(description="slverse - JW Sign Language Video Tool")
    subparsers = parser.add_subparsers(dest="command")

    p_setup = subparsers.add_parser("setup", help="Interactive first-run setup (dependencies, languages, cache, 60fps, PATH)")
    p_setup.add_argument("--non-interactive", action="store_true", help="Only install dependencies, skip the Q&A")

    p_config = subparsers.add_parser("config", help="Manage configuration")
    p_config.add_argument("action", choices=["set", "get", "list"], nargs="?", default="list")
    p_config.add_argument("key", nargs="?")
    p_config.add_argument("value", nargs="?")

    p_langs = subparsers.add_parser("langs", help="Show configured languages and when each was last synced")
    p_langs.add_argument("--discover", action="store_true", help="Also list every sign language JW.org publishes NWT video in")

    p_sync = subparsers.add_parser("sync", help="Sync metadata (and verse markers) so extract can skip video downloads to look up timestamps")
    p_sync.add_argument("lang", nargs="?", default="all", help="Sign language code, comma list, or 'all' for your configured list (default: all)")

    p_extract = subparsers.add_parser("extract", help="Extract and overlay verses from a chapter")
    p_extract.add_argument("lang", help="Sign language code, comma list, or 'all' for your configured list")
    p_extract.add_argument("reference", help="Bible reference (e.g., 'Rev 13:1, 2')")
    p_extract.add_argument("-f", "--write", action="store_true", help="Encode and save the output file. Default is preview-only: play the verse with its overlay (delogo box shown, not applied) and write nothing.")
    p_extract.add_argument("-m", "--play", action="store_true", help="With --write, also play the finished file via mpv. Without --write, preview via mpv instead of ffplay.")
    p_extract.add_argument("--interpolate", action="store_true", help="Force interpolation on output")
    p_extract.add_argument("--onthefly", action="store_true", help="Stream-extract from the source URL; never store the full chapter on disk (default)")
    p_extract.add_argument("--cache", action="store_true", help="Download and keep the full chapter in the local cache instead of streaming on the fly")
    p_extract.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")
    p_extract_retime = p_extract.add_mutually_exclusive_group()
    p_extract_retime.add_argument("--slow", nargs="+", metavar="TIME", help="Split the verse at TIME(s) (seconds or HH:MM:SS, relative to the verse's own start) into alternating normal/slow sections (2nd, 4th, ... retimed). Needs --write. Video-only output (matches the standalone ffslow tool).")
    p_extract_retime.add_argument("--fast", nargs="+", metavar="TIME", help="Same as --slow but alternating normal/fast sections (1st, 3rd, ... retimed) - matches the standalone fffast tool.")
    p_extract.add_argument("--speed", type=parse_speed, metavar="N", help="Retime multiplier for --slow/--fast - decimal (0.5), fraction (1/3), or percent (150%%). Default: 0.5 for --slow, 3 for --fast.")

    p_find = subparsers.add_parser("find", help="Search already-synced languages for who has a given verse")
    p_find.add_argument("book", help="Book name or number")
    p_find.add_argument("chapter", type=int)
    p_find.add_argument("verse", help="Single verse, a range (25-27), or a comma list (1,3,5)")
    p_find.add_argument("--play", action="store_true", help="Also stream-preview each match with mpv")
    p_find.add_argument("-v", "--verbose", action="store_true", help="Show full match details (URL, mpv command) instead of the compact checkmark list")
    p_find.add_argument("--json", action="store_true", help="Machine-readable JSON instead of the checkmark list (always includes every synced language, found or not)")
    p_find.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")

    p_cache = subparsers.add_parser("cache", help="Manage cache")
    p_cache.add_argument("action", choices=["clean", "list", "trim"])
    p_cache.add_argument("--lang", help="Limit 'clean' to one language")

    p_bulk = subparsers.add_parser("bulk", help="Precompute whole chapters (optionally interpolated) ahead of time, instead of extracting on demand")
    p_bulk.add_argument("lang", help="Sign language code, comma list, or 'all' for your configured list")
    p_bulk.add_argument("--books", default="all", help="Book number range, e.g. '40-66' or '66' (default: all 66)")
    p_bulk.add_argument("--interpolate", action="store_true", help="Interpolate each chapter to 60fps using the configured engine")
    p_bulk.add_argument("--out", help="Output directory (default: <cache_dir>/bulk/<lang>)")
    p_bulk.add_argument("--overwrite", action="store_true", help="Reprocess chapters even if the output file already exists")
    p_bulk.add_argument("--no-auto-sync", action="store_true", help="Skip the once-a-day automatic background metadata refresh for this run")

    args = parser.parse_args()
    config = load_config()

    global FFMPEG_BIN, FFPROBE_BIN, FFPLAY_BIN
    FFMPEG_BIN = resolve_ffmpeg_binary(config)
    FFPROBE_BIN = resolve_ffprobe_binary(config)
    FFPLAY_BIN = resolve_ffplay_binary(config)

    if args.command == "setup":
        cmd_setup(args, config)
    elif args.command == "config":
        if args.action == "set" and args.key and args.value:
            cmd_config(args, config)
        elif args.action == "list":
            cmd_config(argparse.Namespace(key=None, value=None), config)
        else:
            print("Usage: slverse config set <key> <value>")
    elif args.command == "langs":
        cmd_langs(args, config)
    elif args.command == "sync":
        cmd_sync(args, config)
    elif args.command == "extract":
        maybe_auto_sync(args, config)
        if args.interpolate and config.get("interpolation_engine") == "none":
            config["interpolation_engine"] = "minterpolate"
        cmd_extract(args, config)
    elif args.command == "find":
        maybe_auto_sync(args, config)
        cmd_find(args, config)
    elif args.command == "cache":
        cmd_cache(args, config)
    elif args.command == "bulk":
        maybe_auto_sync(args, config)
        cmd_bulk(args, config)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
