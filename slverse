def migrate_legacy_config_dir():
    """One-time move from wherever this tool's config used to live (jwsl in
    maj-scripts, or the brief standalone ~/.config/slverse) to its current
    home, ~/.config/jwkit/slverse. Keeps an existing sync index/cache-size
    config from silently resetting across the rename/moves."""
    if CONFIG_DIR.exists():
        return
    for legacy_dir in _LEGACY_CONFIG_DIRS:
        if legacy_dir.exists():
            CONFIG_DIR.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(legacy_dir), str(CONFIG_DIR))
            print(f"Moved your existing settings from {legacy_dir} to {CONFIG_DIR}.")
            return

