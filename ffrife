                                  "rife_profile", "rife_gpu", "rife_threads", "chunk_frames", "cooldown_seconds",
                                  "resume", "keep_work", "scene_detection", "gradual_transition_detection",
                                  "container", "keep_subtitles", "keep_chapters", "keep_extra_audio_tracks",
                                  "keep_attachments", "keep_thumbnail", "keep_source_metadata", "space_check",
