def migrate_legacy_config_dir():
    """One-time move from the pre-unification ~/.config/maj-scripts/ffrife
    location to ~/.config/jwkit/ffrife now that all jwkit tools share one
    config namespace (also carries over the downloaded RIFE binary in
    bin/, so it doesn't need re-downloading)."""
    if _LEGACY_CONFIG_DIR.exists() and not CONFIG_DIR.exists():
        CONFIG_DIR.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(_LEGACY_CONFIG_DIR), str(CONFIG_DIR))
        # config.toml's rife_binary_path is an absolute string, so a plain
        # directory move leaves it pointing at the old location - rewrite it
        # rather than making the user re-download RIFE.
        config_file = CONFIG_DIR / "config.toml"
        if config_file.exists():
            text = config_file.read_text()
            config_file.write_text(text.replace(str(_LEGACY_CONFIG_DIR), str(CONFIG_DIR)))
        print(f"Moved your existing settings from {_LEGACY_CONFIG_DIR} to {CONFIG_DIR}.")

