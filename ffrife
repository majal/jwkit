def videotoolbox_quality_from_crf(crf):
    return _jwkit_common.videotoolbox_quality_from_crf(crf)

def build_encode_args(config, notice=True):
    return _jwkit_common.build_encode_args(FFMPEG_BIN, config, notice=notice)

def run_ffmpeg(args, duration=None, slow_after=4.0, label="Encoding"):
    base = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y"]
    print()
    print(COLOR.header(f"{label}..."))
    print(f"Running: {' '.join(base + args)}")

    if not duration:
        subprocess.run(base + args, check=True)
        return

    cmd = base + ["-progress", "pipe:1", "-nostats"] + args
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    start = time.time()
    shown = False
    eta_estimator = _jwkit_common.ProgressETA(duration)
    last_print = last_eta = 0.0; eta_display = None
    for line in proc.stdout:
        line = line.strip()
        if not line.startswith("out_time="):
            continue
        try:
            current = parse_hms(line.split("=", 1)[1])
        except ValueError:
            continue
        if not shown and time.time() - start > slow_after:
            shown = True
        now = time.time(); eta = eta_estimator.update(current, now)
        if now - last_eta >= 5.0: eta_display, last_eta = eta, now
        if shown and now - last_print >= 1.0:
            print_time_progress(current, duration, label=label, eta_seconds=eta_display)
            last_print = now
    proc.stdout.close()
    proc.wait()
    if shown:
        print_time_progress(duration, duration, label=label, done=True)
        print()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)

# --- RIFE install ---
def rife_release_hint():
    system = platform.system()
    if system == "Darwin":
        return "rife-ncnn-vulkan-*-macos.zip (macOS, works on both Intel and Apple Silicon)"
    if system == "Linux":
        return "rife-ncnn-vulkan-*-ubuntu.zip (Linux)"
    return "rife-ncnn-vulkan-*-windows.zip (Windows)"

def prune_unused_models(models_dir, keep_name):
    """The upstream release zip bundles ~10 model directories (rife-v2.3,
    rife-v3.1, rife-HD, rife-anime, ...) totaling ~450MB, but interpolate()
    only ever uses the single configured rife_model. Removes every sibling
    directory in `models_dir` except `keep_name` - leaves files (the
    executable, LICENSE, README) untouched."""
    for entry in Path(models_dir).iterdir():
        if entry.is_dir() and entry.name != keep_name:
            shutil.rmtree(entry)

def install_rife(config):
    """Download the platform-matching rife-ncnn-vulkan release, unzip it
    into BIN_DIR, and point rife_binary_path at the extracted executable.
    Returns the resolved binary path on success, None on failure."""
    system = platform.system()
    suffix = RIFE_ASSET_SUFFIX.get(system)
    if not suffix:
        print(f"No known rife-ncnn-vulkan release for platform '{system}'; install manually.")
        return None

    release = fetch_json(RIFE_RELEASES_API)
    if not release:
        return None
    asset = next((a for a in release.get("assets", []) if a.get("name", "").endswith(suffix)), None)
    if not asset:
        print(f"No release asset ending in '{suffix}' found in the latest rife-ncnn-vulkan release.")
        return None

    BIN_DIR.mkdir(parents=True, exist_ok=True)
    zip_path = BIN_DIR / asset["name"]
    if not download_file(asset["browser_download_url"], zip_path):
        return None

    try:
        with zipfile.ZipFile(zip_path) as zf:
            zf.extractall(BIN_DIR)
    finally:
        zip_path.unlink(missing_ok=True)

    exe_name = "rife-ncnn-vulkan.exe" if system == "Windows" else "rife-ncnn-vulkan"
    match = next((p for p in BIN_DIR.rglob(exe_name)), None)
    if not match:
        print(f"Downloaded the RIFE release but couldn't find '{exe_name}' inside it.")
        return None

    if system != "Windows":
        match.chmod(match.stat().st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)

    prune_unused_models(match.parent, config.get("rife_model", DEFAULT_CONFIG["rife_model"]))

    config["rife_binary_path"] = str(match)
    save_config(config)
    print(f"RIFE installed: {match}")
    return match

def run_rife(rife_path, in_frames, out_frames, target_count, model_path=None, slow_after=4.0,
             threads=None, gpu=None):
    """rife-ncnn-vulkan has no built-in progress output, so this polls the
    output directory's file count against `target_count`. By far the
    slowest step in the whole pipeline - measured ~125-130s for a
    31s/936-frame clip on an Apple Silicon GPU.

    `-n target_count` asks for an exact (possibly non-2x) output frame
    count and `-m model_path` selects the model - only rife-v4/rife-v4.6
    support either; older bundled models (v2.x/v3.x/HD/UHD/anime) reject
    a non-default -n outright with "only rife-v4 model support custom
    numframe and timestep"."""
    cmd = [rife_path, "-i", str(in_frames), "-o", str(out_frames), "-n", str(target_count)]
    if model_path:
        cmd += ["-m", str(model_path)]
    if threads and str(threads).lower() != "auto":
        if not re.fullmatch(r"\d+:\d+:\d+", str(threads)):
            raise ValueError("rife_threads must be load:process:save, for example 1:1:1")
        if any(int(value) < 1 for value in str(threads).split(":")):
            raise ValueError("every rife_threads value must be at least 1")
        cmd += ["-j", str(threads)]
    if gpu is not None and str(gpu).lower() != "auto":
        gpu_id = "-1" if str(gpu).lower() == "cpu" else str(gpu)
        if not re.fullmatch(r"(?:-1|\d+)", gpu_id):
            raise ValueError("rife_gpu must be auto, cpu, or a numeric GPU id")
        cmd += ["-g", gpu_id]
    proc = subprocess.Popen(cmd)
    start = time.time()
    shown = False
    eta_estimator = _jwkit_common.ProgressETA(target_count)
    last_print = last_eta = 0.0; eta_display = None
    try:
        while proc.poll() is None:
            time.sleep(0.5)
            if not shown and time.time() - start > slow_after:
                shown = True
            if shown:
                current = len(list(Path(out_frames).glob("*.png")))
                now = time.time()
                eta = eta_estimator.update(current, now)
                if now - last_eta >= 5.0: eta_display, last_eta = eta, now
                if now - last_print >= 1.0:
                    print_count_progress(current, target_count, label="RIFE", eta_seconds=eta_display)
                    last_print = now
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
    if shown:
        print_count_progress(target_count, target_count, label="RIFE", done=True)
        print()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, [rife_path])

# --- Retiming (slow-motion/fast-forward) ---
def parse_speed(value):
    """Accepts whatever notation is most natural to type: a plain decimal
    (0.5, 2.5), a fraction (1/3), or a percentage (40%, 150%) - all resolve
    to the same internal multiplier passed to interpolate()'s `speed`."""
    s = str(value).strip()
    if s.endswith("%"):
        return float(s[:-1]) / 100
    if "/" in s:
        num, den = s.split("/", 1)
        return float(num) / float(den)
    return float(s)

def atempo_chain(speed):
    """ffmpeg's atempo filter only accepts a single factor in [0.5, 2.0];
    chain multiple instances to cover any speed value so audio stays in
    sync with a setpts-retimed video track. Returns None for speed 1/None
    (no retiming needed)."""
    if not speed or speed == 1:
        return None
    filters = []
    remaining = speed
    while remaining > 2.0:
        filters.append("atempo=2.0")
        remaining /= 2.0
    while remaining < 0.5:
        filters.append("atempo=0.5")
        remaining /= 0.5
    filters.append(f"atempo={remaining:.6g}")
    return ",".join(filters)

def retimed_duration(duration, speed):
    """run_ffmpeg's progress bar reads ffmpeg's own out_time=, which for a
    setpts=PTS/speed-retimed encode reflects the OUTPUT timeline, not the
    source-relative `duration` passed in - a half-speed encode (speed=0.5)
    actually runs twice as long, a 3x encode a third as long. Without this,
    the bar hits 100% at the halfway point (or overshoots) well before
    ffmpeg is actually done."""
    if duration and speed and speed != 1:
        return duration / speed
    return duration

def probe_source_fps(source):
    """ffprobe's r_frame_rate comes back as an 'N/D' fraction (e.g.
    '30000/1001'), not a plain float. Used by interpolate() to size RIFE's
    -n target frame count so the requested `fps` is hit exactly regardless
    of the source's real frame rate, instead of relying on RIFE's own
    implicit 2x-doubling default."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=r_frame_rate", "-of", "csv=p=0", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    return float(Fraction(result.stdout.strip()))

def probe_source_resolution(source):
    """Width/height of the source's first video stream. Used to scale
    long_run_frames by expected per-frame RIFE cost (see resolve_rife_policy)
    - a short but high-resolution clip can take as long to run as a longer
    low-resolution one, so a raw frame-count threshold alone underestimates
    it."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "v:0", "-show_entries",
           "stream=width,height", "-of", "csv=s=x:p=0", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    width, height = result.stdout.strip().split("x")
    return int(width), int(height)

def resolve_target_fps(fps_spec, source_fps):
    """`fps_spec` is either a plain literal target ('60') or a source-relative
    spec: 'Nx' ('2x', '2.5x') or 'N%' ('150%'), resolved against `source_fps`
    - mirrors parse_speed's percent/plain style."""
    s = str(fps_spec).strip()
    if s.lower().endswith("x"):
        return source_fps * float(s[:-1])
    if s.endswith("%"):
        return source_fps * float(s[:-1]) / 100
    return float(s)

# --- Core: single-pass interpolation ---
def _link_or_copy(source, destination):
    try:
        os.link(source, destination)
    except OSError:
        shutil.copy2(source, destination)

def _write_json_atomic(path, payload):
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(payload, indent=2, sort_keys=True))
    temp.replace(path)

def suppress_scene_cut_interpolation(in_frames, out_frames, input_count, target_count, cuts):
    """Replace output samples strictly between each cut's real endpoints."""
    if input_count < 2 or target_count < 2:
        return 0
    scale = (target_count - 1) / (input_count - 1)
    replaced = 0
    for cut in cuts:
        if not 0 < cut < input_count:
            continue
        first = math.floor((cut - 1) * scale) + 1
        last = math.ceil(cut * scale) - 1
        # `cut` is the zero-based index of the shot's first frame; frame
        # files are one-based, so the post-cut source is at `cut + 1`.
        source = Path(in_frames) / f"{cut + 1:08d}.png"
        for output_zero_index in range(first, last + 1):
            destination = Path(out_frames) / f"{output_zero_index + 1:08d}.png"
            if destination.exists():
                shutil.copy2(source, destination)
                replaced += 1
    return replaced

def detect_transitions(in_frames, source_fps, cut_sensitivity=3.0, cut_floor=0.05,
                        revert_fraction=0.5, min_duration=0.25,
                        sensitivity=1.35, alignment=0.80, detect_gradual=True):
    """Single-pass detection of hard cuts and gradual transitions.

    Tiny RGB frames (32x18, cheap enough to hold in memory for the whole
    clip) make this cheap, and colour - not just luma - matters: a cut
    between two shots that happen to share the same average brightness but
    differ in hue is invisible to a grayscale-only metric.

    Every frame-to-frame step gets a magnitude (how much changed) and an
    alignment (cosine similarity with the previous step's change vector).
    The two transition types share the same signal but differ in shape:

    - A hard cut is an isolated impulse: magnitude clears both ``cut_floor``
      (an absolute pixel-change amount - keeps near-silent clips from
      treating tiny noise as a cut) and ``cut_sensitivity`` times the
      clip's recent baseline, is unaligned with the motion before it (the
      incoming shot's content has no relationship to the outgoing shot's
      direction of change), and both neighbors are below ``revert_fraction``
      of the spike itself - far smaller, not just smaller. That last,
      *relative* part matters - comparing the neighbors only to the
      pre-spike baseline would also flag whip pans (which sustain elevated,
      poorly-aligned magnitude across several frames) and would miss a cut
      into a shot that itself opens with brisk motion (whose first real
      frame reads as "elevated" against the calmer outgoing shot).
      Comparing each neighbor to the spike's own size instead - not the
      baseline - tells "steep both ways" (a cut) apart from "ramps up,
      ramps down" (real camera motion) or "elevated throughout" (a busy new
      shot), even when every individual frame of a whip pan clears the
      baseline-relative bar on its own.
    - A gradual transition is the same signature sustained: elevated
      magnitude that stays aligned with itself frame after frame, which is
      what a monotonic fade/dissolve looks like (linear alpha blending
      produces a near-constant per-pixel change direction for its whole
      duration). ``min_duration`` only sizes the baseline lookback window
      (how far back to search for the clip's normal motion level before
      judging a run elevated) - it is not a minimum run length. Quick
      dissolves (a handful of frames) are common and are protected the
      same as long ones; the magnitude/alignment gates already reject
      one-off motion spikes.

    Returns ``(cuts, transitions)``: ``cuts`` is a sorted list of
    zero-based indices of frames that begin a new shot; ``transitions`` is
    a list of zero-based ``(start, end)`` frame ranges for sustained
    fades/dissolves.
    """
    width, height = 32, 18
    cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "error", "-framerate",
           f"{float(source_fps):.12g}", "-i", str(Path(in_frames) / "%08d.png"),
           "-vf", f"scale={width}:{height}", "-pix_fmt", "rgb24", "-f", "rawvideo", "-"]
    size = width * height * 3
    minimum = max(3, round(float(min_duration) * float(source_fps)))
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    previous_frame = previous_delta = None
    frame_count = 0
    magnitudes = []
    cosines = {}
    while True:
        frame = proc.stdout.read(size)
        if len(frame) != size:
            break
        frame_count += 1
        if previous_frame is not None:
            delta = [b - a for a, b in zip(previous_frame, frame)]
            magnitude = sum(abs(value) for value in delta) / (size * 255)
            magnitudes.append(magnitude)
            if previous_delta is not None:
                index = len(magnitudes) - 1
                left_energy = sum(value * value for value in previous_delta)
                right_energy = sum(value * value for value in delta)
                cosines[index] = (sum(a * b for a, b in zip(previous_delta, delta)) /
                                  math.sqrt(left_energy * right_energy) if left_energy and right_energy else 0.0)
            previous_delta = delta
        previous_frame = frame
    proc.stdout.close()
    if proc.wait() != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)
    if frame_count < 3:
        return [], []

    def baseline_at(index):
        history_end = max(1, index - minimum)
        history = magnitudes[max(0, history_end - max(24, minimum * 3)):history_end]
        return statistics.median(history) if history else magnitudes[index - 1]

    transitions = []
    if detect_gradual:
        candidates = []
        for index in range(1, len(magnitudes)):
            if index not in cosines:
                continue
            cosine = cosines[index]
            magnitude = magnitudes[index]
            baseline = baseline_at(index)
            active = magnitude >= max(0.003, baseline * float(sensitivity))
            candidates.append((index + 1, active and cosine >= float(alignment),
                               magnitude >= 0.003 and cosine >= float(alignment)))
        start = previous = None
        gaps = 0
        for frame_index, begins, continues in candidates + [(frame_count, False, False), (frame_count + 1, False, False)]:
            accepted = begins if start is None else continues
            if accepted:
                start = frame_index if start is None else start
                previous = frame_index
                gaps = 0
                continue
            if start is not None:
                gaps += 1
                if gaps <= 1:
                    continue
                transitions.append((max(0, start - 1), min(frame_count - 1, previous + 1)))
                start = previous = None
                gaps = 0

    protected = set()
    for start_frame, end_frame in transitions:
        protected.update(range(start_frame, end_frame + 1))

    cuts = []
    for index in range(len(magnitudes)):
        frame_index = index + 1  # zero-based index of the frame that just arrived
        if frame_index in protected:
            continue
        magnitude = magnitudes[index]
        baseline = baseline_at(index) if index >= 1 else magnitude
        if magnitude < max(float(cut_floor), baseline * float(cut_sensitivity)):
            continue
        if cosines.get(index, 0.0) >= float(alignment):
            continue  # coherent with recent motion direction - not a discontinuity
        previous_magnitude = magnitudes[index - 1] if index >= 1 else 0.0
        next_magnitude = magnitudes[index + 1] if index + 1 < len(magnitudes) else 0.0
        if (previous_magnitude >= magnitude * float(revert_fraction) or
                next_magnitude >= magnitude * float(revert_fraction)):
            continue  # part of a sustained burst (e.g. a whip pan), not a one-off cut
        cuts.append(frame_index)
    return sorted(set(cuts)), transitions

def parse_transition_ranges(value, source_fps, input_count):
    ranges = []
    for item in str(value or "").split(","):
        if not item.strip():
            continue
        try:
            start, end = (float(part) for part in item.split(":", 1))
        except ValueError as exc:
            raise ValueError("transition_ranges must be comma-separated START:END seconds") from exc
        if start < 0 or end <= start:
            raise ValueError("each transition range must satisfy 0 <= START < END")
        ranges.append((max(0, round(start * source_fps)), min(input_count - 1, round(end * source_fps))))
    return ranges

def _job_signature(source, output_file, options):
    source_path = Path(str(source)).expanduser()
    source_identity = str(source_path.resolve()) if source_path.exists() else str(source)
    if source_path.exists():
        stat_result = source_path.stat()
        source_identity += f":{stat_result.st_size}:{stat_result.st_mtime_ns}"
    raw = json.dumps([source_identity, str(Path(output_file).resolve()), options], sort_keys=True)
    return hashlib.sha256(raw.encode()).hexdigest()[:16]

def _work_dir_for(output_file, signature):
    output = Path(output_file)
    return output.parent / f".{output.name}.ffrife-{signature}"

def _chunk_ranges(frame_count, chunk_frames):
    if chunk_frames == 1:
        raise ValueError("chunk_frames must be 0 (disabled) or at least 2")
    if frame_count < 2 or chunk_frames <= 0 or frame_count <= chunk_frames:
        return [(0, frame_count)]
    ranges = []
    start = 0
    while start < frame_count - 1:
        end = min(frame_count, start + chunk_frames)
        ranges.append((start, end))
        if end == frame_count:
            break
        start = end - 1  # overlap one endpoint so RIFE sees the seam
    return ranges

def _render_rife_chunks(rife_path, in_frames, out_frames, target_count, model_path, config, state_path):
    inputs = sorted(Path(in_frames).glob("*.png"))
    ranges = _chunk_ranges(len(inputs), config_int(config, "chunk_frames", 0))
    completed = set()
    if state_path.exists():
        try:
            completed = set(json.loads(state_path.read_text()).get("completed_chunks", []))
        except (OSError, ValueError):
            completed = set()
    chunks_root = state_path.parent / "chunks"
    chunks_root.mkdir(parents=True, exist_ok=True)
    total_intervals = max(1, len(inputs) - 1)
    target_intervals = max(0, target_count - 1)
    for index, (start, end) in enumerate(ranges):
        chunk_key = str(index)
        chunk_out = chunks_root / f"{index:06d}" / "out"
        marker = chunk_out.parent / "complete.json"
        if chunk_key in completed and marker.exists():
            try:
                expected = int(json.loads(marker.read_text())["target_count"])
            except (OSError, ValueError, KeyError, TypeError):
                expected = -1
            if len(list(chunk_out.glob("*.png"))) == expected:
                print(f"Resuming: chunk {index + 1}/{len(ranges)} already complete.")
                continue
            print(f"Resume data for chunk {index + 1} is incomplete; rebuilding it.")
        chunk_in = chunks_root / f"{index:06d}" / "in"
        shutil.rmtree(chunk_in, ignore_errors=True)
        shutil.rmtree(chunk_out, ignore_errors=True)
        chunk_in.mkdir(parents=True); chunk_out.mkdir(parents=True)
        for local_index, source_frame in enumerate(inputs[start:end], 1):
            _link_or_copy(source_frame, chunk_in / f"{local_index:08d}.png")
        first_interval = round(start * target_intervals / total_intervals)
        last_interval = round((end - 1) * target_intervals / total_intervals)
        chunk_target = max(2, last_interval - first_interval + 1)
        print(f"RIFE chunk {index + 1}/{len(ranges)} ({end - start} source frames)...")
        run_rife(rife_path, chunk_in, chunk_out, chunk_target, model_path=model_path,
                 threads=config.get("rife_threads"), gpu=config.get("rife_gpu"))
        _write_json_atomic(marker, {"target_count": chunk_target})
        completed.add(chunk_key)
        _write_json_atomic(state_path, {"completed_chunks": sorted(completed, key=int)})
        shutil.rmtree(chunk_in, ignore_errors=True)
        cooldown = config_float(config, "cooldown_seconds", 0)
        if cooldown and index + 1 < len(ranges):
            print(f"Cooling down for {cooldown}s before the next chunk (Ctrl-C is safe; resume later)...")
            time.sleep(cooldown)
    shutil.rmtree(out_frames, ignore_errors=True)
    Path(out_frames).mkdir(parents=True)
    output_index = 1
    for index in range(len(ranges)):
        frames = sorted((chunks_root / f"{index:06d}" / "out").glob("*.png"))
        if index:
            frames = frames[1:]  # overlapped endpoint was emitted by prior chunk
        for frame in frames:
            _link_or_copy(frame, Path(out_frames) / f"{output_index:08d}.png")
            output_index += 1
    if output_index - 1 != target_count:
        raise RuntimeError(f"chunk assembly produced {output_index - 1} frames; expected {target_count}")

def render_rife_frames(source, frames_root, config, start=None, end=None, vf=None, fps=60, speed=None, source_fps=None):
    """Decode a source window, synthesize its final retimed RIFE frame
    sequence, and return ``(out_frames, resolved_fps, duration)``.

    The caller owns ``frames_root`` and the final encode. This lets sectioned
    editors concatenate multiple lossless RIFE sequences and encode only once.
    Returns ``None`` when RIFE is unavailable; callers can then apply their
    configured ffmpeg fallback without creating an intermediate video.
    """
    if str(fps).strip().lower().endswith(("x", "%")):
        fps = resolve_target_fps(fps, probe_source_fps(source))
    else:
        fps = float(fps)
    rife_path = config.get("rife_binary_path")
    if not rife_path or not command_exists(rife_path):
        return None

    print()
    print(COLOR.header("Interpolating using rife-ncnn-vulkan..."))
    frames_root = Path(frames_root)
    in_frames = frames_root / "in"
    out_frames = frames_root / "out"
    in_frames.mkdir(parents=True)
    out_frames.mkdir(parents=True)
    trim_args = []
    if start is not None:
        trim_args += ["-ss", str(start)]
    if end is not None:
        trim_args += ["-to", str(end)]
    duration = (end - start) if (start is not None and end is not None) else None
    extract_cmd = trim_args + ["-i", str(source)]
    if vf:
        extract_cmd += ["-vf", vf]
    extract_cmd += [f"{in_frames}/%08d.png"]
    extract_marker = frames_root / "extract-complete.json"
    if extract_marker.exists() and any(in_frames.glob("*.png")):
        print("Resuming: extracted source frames already complete.")
    else:
        shutil.rmtree(in_frames, ignore_errors=True)
        in_frames.mkdir(parents=True)
        run_ffmpeg(extract_cmd, duration=duration, label="Extracting")
        _write_json_atomic(extract_marker, {"frame_count": len(list(in_frames.glob("*.png")))})

    input_frame_count = len(list(in_frames.glob("*.png")))
    if input_frame_count == 0:
        print("No frames extracted - nothing to interpolate.")
        return None
    source_fps = float(source_fps) if source_fps is not None else probe_source_fps(source)
    # Generate the final temporal samples directly. For half speed this is
    # twice the normal target count, avoiding setpts-driven frame duplication.
    speed_factor = speed if speed and speed != 1 else 1.0
    target_count = round(input_frame_count * fps / source_fps / speed_factor)
    scene_threshold = None
    explicit_transitions = []
    if config_bool(config, "scene_detection", True) and input_frame_count > 1:
        scene_threshold = config_float(config, "scene_threshold", 3.0)
        if scene_threshold <= 0:
            raise ValueError("scene_threshold must be greater than 0")
        explicit_transitions = parse_transition_ranges(
            config.get("transition_ranges", ""), source_fps, input_frame_count
        )
    model_path = Path(rife_path).parent / config.get("rife_model", DEFAULT_CONFIG["rife_model"])
    # Library callers historically pass only the settings they own. Keep that
    # API compatible; the full ffrife config enables resumable chunking.
    if "chunk_frames" not in config:
        run_rife(rife_path, in_frames, out_frames, target_count=target_count, model_path=model_path)
    else:
        width, height = probe_source_resolution(source)
        pixel_scale = (width * height) / REFERENCE_PIXELS if width and height else 1.0
        fps_scale = (target_count / input_frame_count) / REFERENCE_FPS_RATIO
        effective = resolve_rife_policy(config, input_frame_count, workload_scale=pixel_scale * fps_scale)
        print(f"RIFE profile: {effective['resolved_rife_profile']} "
              f"(threads={effective['rife_threads']}, chunks={effective['chunk_frames']}, "
              f"cooldown={effective['cooldown_seconds']}s)")
        _render_rife_chunks(rife_path, in_frames, out_frames, target_count, model_path, effective,
                            frames_root / "rife-state.json")
    if scene_threshold is not None:
        detect_gradual = config_bool(config, "gradual_transition_detection", True)
        print(f"Detecting scene cuts and transitions (sensitivity={scene_threshold:g})...")
        cuts, transitions = detect_transitions(
            in_frames, source_fps,
            cut_sensitivity=scene_threshold,
            cut_floor=config_float(config, "scene_floor", 0.05),
            revert_fraction=config_float(config, "scene_revert_fraction", 0.5),
            min_duration=config_float(config, "transition_min_duration", 0.25),
            sensitivity=config_float(config, "transition_sensitivity", 1.35),
            alignment=config_float(config, "transition_alignment", 0.80),
            detect_gradual=detect_gradual,
        )
        transitions = list(explicit_transitions) + transitions
        for start_frame, end_frame in transitions:
            cuts.extend(range(start_frame + 1, end_frame + 1))
        cuts = sorted(set(cuts))
        replaced = suppress_scene_cut_interpolation(
            in_frames, out_frames, input_frame_count, target_count, cuts
        )
        print(f"Transitions: {len(transitions)} gradual interval(s), {len(cuts)} protected boundary/boundaries; "
              f"{replaced} interpolated frame(s) replaced.")
    return out_frames, fps, retimed_duration(duration, speed)


def interpolate(source, output_file, config, start=None, end=None, vf=None, fps=60, speed=None, metadata_args=None, output_vf=None):
    """Interpolate `source` (local path or remote URL) to `fps`, optionally
    trimmed to [start, end] and with an extra ffmpeg -vf filter chain
    applied before RIFE. ``output_vf`` is instead applied after RIFE in the
    final encode, which is preferable for static text/overlays that the model
    should not reinterpret. Frame extraction is directly from the source
    (trim + filter baked in), so there's no intermediate lossy re-encode
    generation before RIFE ever sees the footage. The only lossy encode is
    the final merge. Falls back to a plain ffmpeg filter (or no
    interpolation at all) per config's rife_fallback_engine if RIFE isn't
    installed/configured.

    `speed` (e.g. 0.5 for half-speed slow-motion, 3 for 3x fast-forward)
    changes RIFE's requested output-frame count directly; audio uses atempo.
    The ffmpeg fallback uses setpts/atempo in its one encode. Neither path
    needs a separate retiming pass. Returns True on success.

    `fps` accepts a plain literal target (60) or a source-relative spec
    ('2x', '2.5x', '150%') - resolved once here against the source's real
    fps so both the RIFE branch and the ffmpeg-fallback branch below see an
    already-resolved plain number."""
    if str(fps).strip().lower().endswith(("x", "%")):
        fps = resolve_target_fps(fps, probe_source_fps(source))
    else:
        fps = float(fps)
    duration = (end - start) if (start is not None and end is not None) else None
    trim_args = []
    if start is not None:
        trim_args += ["-ss", str(start)]
    if end is not None:
        trim_args += ["-to", str(end)]
    speed_vf = f"setpts=PTS/{speed:.6g}" if speed and speed != 1 else None
    speed_af = atempo_chain(speed)

    rife_path = config.get("rife_binary_path")
    if not rife_path or not command_exists(rife_path):
        fallback = config.get("rife_fallback_engine", DEFAULT_CONFIG["rife_fallback_engine"])
        print()
        print("RIFE binary not found. (Run 'ffrife setup' to download and configure it.)")
        vf_chain = list(filter(None, [vf]))
        if fallback in ("framerate", "minterpolate"):
            print(f"Falling back to ffmpeg's {fallback} filter for {fps}fps - note this can make motion look")
            print("artificially smooth/slow-motion-ish (frame blending, not real interpolation).")
            print("Set rife_fallback_engine=none to just keep native fps with no artifact instead.")
            interp_filter = (f"minterpolate=fps={fps}:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1"
                              if fallback == "minterpolate" else f"framerate=fps={fps}")
            vf_chain.append(interp_filter)
        else:
            print("rife_fallback_engine=none: keeping native frame rate, no interpolation applied.")
        if speed_vf:
            vf_chain.append(speed_vf)
        if output_vf:
            vf_chain.append(output_vf)
        cmd = trim_args + ["-i", str(source)]
        if vf_chain:
            cmd += ["-vf", ",".join(vf_chain)]
        cmd += (["-af", speed_af] if speed_af else ["-c:a", "copy"]) + build_encode_args(config) + (metadata_args or []) + [str(output_file)]
        run_ffmpeg(cmd, duration=retimed_duration(duration, speed))
        return True

    options = {"start": start, "end": end, "vf": vf, "fps": fps, "speed": speed,
               "model": config.get("rife_model"), "threads": config.get("rife_threads"),
               "gpu": config.get("rife_gpu"), "profile": config.get("rife_profile"),
               "chunk_frames": config.get("chunk_frames"), "long_run_frames": config.get("long_run_frames"),
               "batch": bool(config.get("_batch_mode")),
               "scene_detection": config.get("scene_detection"),
               "scene_threshold": config.get("scene_threshold"),
               "scene_floor": config.get("scene_floor"),
               "scene_revert_fraction": config.get("scene_revert_fraction"),
               "gradual_transition_detection": config.get("gradual_transition_detection"),
               "transition_min_duration": config.get("transition_min_duration"),
               "transition_sensitivity": config.get("transition_sensitivity"),
               "transition_alignment": config.get("transition_alignment"),
               "transition_ranges": config.get("transition_ranges")}
    signature = _job_signature(source, output_file, options)
    durable = config_bool(config, "resume", False)
    work_path = _work_dir_for(output_file, signature) if durable else Path(tempfile.mkdtemp(prefix="ffrife-"))
    work_path.mkdir(parents=True, exist_ok=True)
    try:
        temp_dir_path = work_path
        rendered = render_rife_frames(source, temp_dir_path, config, start=start, end=end, vf=vf, fps=fps, speed=speed)
        if not rendered:
            if not durable:
                shutil.rmtree(work_path, ignore_errors=True)
            return False
        out_frames, fps, _ = rendered

        audio_path = temp_dir_path / "audio.aac"
        audio_cmd = [FFMPEG_BIN, "-y"] + trim_args + ["-i", str(source), "-vn", "-c:a", "copy", str(audio_path)]
        subprocess.run(audio_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        merge_cmd = ["-r", str(fps), "-i", f"{out_frames}/%08d.png"]
        has_audio = audio_path.exists() and audio_path.stat().st_size > 0
        if has_audio:
            merge_cmd += ["-i", str(audio_path)]
        # RIFE already generated the retimed video frame count above.
        if output_vf:
            merge_cmd += ["-vf", output_vf]
        if has_audio:
            merge_cmd += (["-af", speed_af] if speed_af else ["-c:a", "copy"])
        merge_cmd += build_encode_args(config) + (metadata_args or []) + [str(output_file)]
        run_ffmpeg(merge_cmd, duration=retimed_duration(duration, speed))
    except BaseException:
        if durable:
            print(f"Work saved for resume: {work_path}")
        else:
            shutil.rmtree(work_path, ignore_errors=True)
        raise
    if not config_bool(config, "keep_work", False):
        shutil.rmtree(work_path, ignore_errors=True)
    return True

# --- CLI ---
def rife_supports_custom_frame_count(rife_path, model_path):
    """interpolate() always passes an explicit -n/-m now (see run_rife) -
    older bundled models (rife-v2.x/v3.x/HD/UHD/anime) reject that outright
    ("only rife-v4 model support custom numframe and timestep"), so an
    install/model predating that change would fail on every real run. Smoke
    -tests the actual configured binary+model with 2 throwaway synthetic
    frames, not any real footage."""
    try:
        with tempfile.TemporaryDirectory() as tmp_dir:
            in_frames, out_frames = Path(tmp_dir) / "in", Path(tmp_dir) / "out"
            in_frames.mkdir()
            out_frames.mkdir()
            for i, color in enumerate(("red", "blue"), start=1):
                subprocess.run(
                    [FFMPEG_BIN, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
                     "-i", f"color=c={color}:s=32x32", "-frames:v", "1", str(in_frames / f"{i:08d}.png")],
                    check=True, timeout=15,
                )
            result = subprocess.run(
                [rife_path, "-i", str(in_frames), "-o", str(out_frames), "-n", "3", "-m", str(model_path)],
                capture_output=True, text=True, timeout=30,
            )
            return result.returncode == 0 and len(list(out_frames.glob("*.png"))) == 3
    except Exception:
        return False

def cmd_setup(config):
    hw = config.get("hardware_encoder", "cpu")
    print(f"Video encoder: {hw}")
    ffmpeg_bin = resolve_ffmpeg_binary(config)
    if not ffmpeg_has_filter(ffmpeg_bin, "delogo") and not ffmpeg_has_filter(ffmpeg_bin, "drawtext"):
        print(f"Note: {ffmpeg_bin} may be missing some filters callers pass via --vf.")

    if config.get("rife_binary_path") and command_exists(config["rife_binary_path"]):
        model_path = Path(config["rife_binary_path"]).parent / config.get("rife_model", DEFAULT_CONFIG["rife_model"])
        if rife_supports_custom_frame_count(config["rife_binary_path"], model_path):
            print(f"RIFE already configured: {config['rife_binary_path']}")
            return
        print(f"RIFE is configured ({config['rife_binary_path']}), but this install can't hit an exact")
        print("target frame count (older releases only support a plain 2x doubling with the default")
        print("model) - ffrife now always requests an exact target, so every real run against this")
        print("install would fail.")
        ans = input("Download and install a fresh release now? [Y/n]: ").strip().lower()
        if ans in ("", "y", "yes"):
            old_dir = Path(config["rife_binary_path"]).resolve().parent
            if install_rife(config):
                new_dir = Path(config["rife_binary_path"]).resolve().parent
                if old_dir != new_dir and old_dir.parent == BIN_DIR and old_dir.exists():
                    shutil.rmtree(old_dir)
                    print(f"Removed old install directory: {old_dir}")
            else:
                print("Automatic install failed. Download it yourself from")
                print("https://github.com/nihui/rife-ncnn-vulkan/releases, unzip it, then run:")
                print("  ffrife config set rife_binary_path /path/to/rife-ncnn-vulkan")
        else:
            print("Skipping - ffrife run will keep failing against this install until you fix it.")
        return

    print(f"\nRIFE isn't installed yet ({rife_release_hint()}).")
    ans = input("Download and install it now? [Y/n]: ").strip().lower()
    if ans in ("", "y", "yes"):
        if not install_rife(config):
            print("Automatic install failed. Download it yourself from")
            print("https://github.com/nihui/rife-ncnn-vulkan/releases, unzip it, then run:")
            print("  ffrife config set rife_binary_path /path/to/rife-ncnn-vulkan")
    else:
        print("Skipping - run 'ffrife setup' again anytime.")

BENCHMARK_CRF_SWEEP = {"h264": ["18", "20", "23"], "hevc": ["20", "23", "26"], "av1": ["24", "27", "30"]}
BENCHMARK_CRF_QUICK = {"h264": "20", "hevc": "23", "av1": "30"}

def cmd_benchmark(args, config):
    """Times every video encoder this machine's ffmpeg build actually has
    against a sample clip, at a few crf values per codec (BENCHMARK_CRF_SWEEP
    - a real size/quality tradeoff view, not one guessed point), measuring
    size and SSIM - see _jwkit_common.run_encoder_benchmark. Same engine
    slverse's own 'benchmark' command uses; this one takes --sample
    directly since ffrife (unlike slverse) has no cache of its own content
    to pull a representative clip from automatically. --quick skips the
    sweep (one crf per codec) for a faster, coarser answer."""
    ffmpeg_bin = resolve_ffmpeg_binary(config)
    ffprobe_bin = resolve_ffprobe_binary(config)
    sample = getattr(args, "sample", None)
    crf_map = BENCHMARK_CRF_QUICK if getattr(args, "quick", False) else BENCHMARK_CRF_SWEEP
    with tempfile.TemporaryDirectory(prefix="ffrife-bench-") as tmp_dir:
        if not sample:
            sample = str(Path(tmp_dir) / "bench_sample.mp4")
            print("No --sample given - benchmarking against a synthetic test clip (pass --sample <file> to test against real content instead).")
            subprocess.run(
                [ffmpeg_bin, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
                 "-i", "testsrc2=size=1280x720:rate=30:duration=8",
                 "-c:v", "libx264", "-crf", "12", "-preset", "fast", sample],
                check=True, timeout=60,
            )
        else:
            # A whole downloaded chapter (minutes long) as --sample would
            # multiply every one of the crf sweep's ~15 encodes by its own
            # full length instead of a few seconds - trim to a short
            # representative slice first, the same way slverse's own
            # find_or_generate_bench_sample does for its cached content.
            try:
                duration = float(subprocess.run(
                    [ffprobe_bin, "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", sample],
                    capture_output=True, text=True, timeout=15, check=True,
                ).stdout.strip())
            except Exception:
                duration = 0.0
            if duration > 12:
                trimmed = str(Path(tmp_dir) / "bench_sample.mp4")
                offset = max(0.0, (duration - 8) / 2)
                subprocess.run(
                    [ffmpeg_bin, "-hide_banner", "-loglevel", "error", "-y", "-ss", str(offset), "-t", "8", "-i", sample,
                     "-c:v", "libx264", "-crf", "12", "-preset", "fast", "-an", trimmed],
                    check=True, timeout=60,
                )
                print(f"--sample is {duration:.0f}s long - using an 8s slice from its middle instead of the whole thing.")
                sample = trimmed
        print(COLOR.header("Trying every encoder this machine's ffmpeg supports - this can take a minute or two:\n"))
        results = _jwkit_common.run_encoder_benchmark(ffmpeg_bin, sample, crf_map=crf_map, log=lambda m: print(f"  {m}"))

    print()
    print(_jwkit_common.format_benchmark_table(results))
    best = _jwkit_common.recommend_from_benchmark(results)
    if not best:
        print("\nNo encoder on this machine actually worked - keeping current settings.")
        return None
    print(f"\n{COLOR.bold(COLOR.green('Recommended:'))} hardware_encoder={best['hw']}, video_codec={best['codec']}, video_crf={best['crf']} (smallest file at SSIM >= 0.98, or highest SSIM available if none cleared that)")
    if getattr(args, "apply", False):
        config["hardware_encoder"], config["video_codec"] = best["hw"], best["codec"]
        # See slverse's own cmd_benchmark comment: "auto" instead of the
        # literal crf when it's just that codec's normal default, so
        # video_crf stays correctly adaptive if the codec ever changes.
        config["video_crf"] = "auto" if best["crf"] == _jwkit_common.AUTO_CRF_BY_CODEC.get(best["codec"]) else best["crf"]
        save_config(config)
        print("Applied and saved.")
    return best

def cmd_config(args, config):
    if args.action == "set" and args.key and args.value:
        config[args.key] = args.value
        save_config(config)
        print(f"Set {args.key} = {args.value}")
    elif args.action == "get" and args.key:
        print(f"{args.key} = {config.get(args.key)}")
    else:
        for k, v in config.items():
            print(f"{k} = {v}")

# DEFAULT_CONFIG keys with their own dedicated per-run flag already -
# excluded from the generic --<key> override loop (see slverse's own
# GENERIC_OVERRIDE_EXCLUDED_KEYS for the same pattern).
GENERIC_OVERRIDE_EXCLUDED_KEYS = {"rife_fallback_engine", "hardware_encoder", "video_codec", "video_crf", "video_preset",
                                  "rife_profile", "rife_gpu", "rife_threads", "chunk_frames", "cooldown_seconds",
                                  "resume", "keep_work", "scene_detection", "gradual_transition_detection"}

def add_generic_config_overrides(parser):
    for key in DEFAULT_CONFIG:
        if key in GENERIC_OVERRIDE_EXCLUDED_KEYS:
            continue
        parser.add_argument(f"--{key.replace('_', '-')}", dest=key, help=f"Override {key} for this run")

def apply_generic_config_overrides(args, config):
    for key in DEFAULT_CONFIG:
        if key in GENERIC_OVERRIDE_EXCLUDED_KEYS:
            continue
        value = getattr(args, key, None)
        if value is not None:
            config[key] = value

def collect_batch_inputs(inputs, patterns=None, list_files=None, recursive=False):
    candidates = []
    for value in inputs or []:
        path = Path(value).expanduser()
        if path.is_dir():
            iterator = path.rglob("*") if recursive else path.glob("*")
            candidates.extend(p for p in iterator if p.is_file() and p.suffix.lower() in VIDEO_EXTENSIONS)
        elif any(char in value for char in "*?["):
            candidates.extend(Path(p) for p in glob.glob(str(path), recursive=recursive))
        else:
            candidates.append(path)
    for pattern in patterns or []:
        candidates.extend(Path(p) for p in glob.glob(os.path.expanduser(pattern), recursive=recursive))
    for list_file in list_files or []:
        base = Path(list_file).expanduser().resolve().parent
        for line in Path(list_file).expanduser().read_text().splitlines():
            value = line.strip()
            if not value or value.startswith("#"):
                continue
            path = Path(value).expanduser()
            candidates.append(path if path.is_absolute() else base / path)
    result = []
    seen = set()
    for path in candidates:
        if not path.is_file() or path.suffix.lower() not in VIDEO_EXTENSIONS:
            continue
        resolved = path.resolve()
        if resolved not in seen:
            result.append(resolved); seen.add(resolved)
    return result

def batch_output_path(source, output_dir, suffix):
    rendered = suffix.format(stem=source.stem, suffix=source.suffix, name=source.name)
    if not Path(rendered).suffix:
        rendered += source.suffix
    return Path(output_dir) / rendered

def default_output_path(source):
    """Where `ffrife run <input>` writes when -o is omitted: alongside a
    local source, using the same {stem}_rife{suffix} naming batch mode used
    to default to everywhere - or in the current directory (from the URL's
    own filename) for a remote source, which has no local sibling
    directory to use. Always keeps the _rife suffix, unlike batch's own
    default (see batch's --output-name help) - batch's separate -O
    directory usually makes a collision with the source unlikely, but a
    bare single-file run with no -o has nowhere else to go."""
    source_path = Path(str(source)).expanduser()
    if source_path.exists():
        directory, name_source = source_path.parent, source_path
    else:
        directory, name_source = Path("."), Path(urllib.parse.urlsplit(str(source)).path)
    stem = name_source.stem or "output"
    suffix = name_source.suffix or ".mp4"
    return directory / f"{stem}_rife{suffix}"

def apply_run_overrides(args, config):
    if getattr(args, "fallback", None):
        config["rife_fallback_engine"] = args.fallback
    for arg_name, config_key in (("encoder", "hardware_encoder"), ("codec", "video_codec"),
                                 ("crf", "video_crf"), ("preset", "video_preset")):
        value = getattr(args, arg_name, None)
        if value is not None:
            config[config_key] = value
    if getattr(args, "rife_profile", None):
        config["rife_profile"] = args.rife_profile
    if getattr(args, "scene_detection", None) is not None:
        config["scene_detection"] = args.scene_detection
    if getattr(args, "gradual_transition_detection", None) is not None:
        config["gradual_transition_detection"] = args.gradual_transition_detection

def add_processing_arguments(parser, include_trim=True):
    if include_trim:
        parser.add_argument("--start", type=float, help="Trim start (seconds)")
        parser.add_argument("--end", type=float, help="Trim end (seconds)")
    parser.add_argument("--fps", default="60", help="Target frame rate: a plain number (60) or source-relative (2x, 2.5x, 150%%) (default: 60)")
    parser.add_argument("--speed", type=parse_speed, help="Retime output: decimal, fraction, or percentage")
    parser.add_argument("--vf", help="Extra ffmpeg -vf filter chain during frame extraction")
    parser.add_argument("--fallback", choices=["none", "framerate", "minterpolate"])
    parser.add_argument("--encoder", choices=["cpu", "videotoolbox", "nvenc", "qsv"])
    parser.add_argument("--codec", choices=["h264", "hevc", "av1"])
    parser.add_argument("--crf", help="Video quality for this run; use 'auto' for codec default")
    parser.add_argument("--preset", help="FFmpeg encoder preset")
    profile_group = parser.add_mutually_exclusive_group()
    profile_group.add_argument("--profile", dest="rife_profile", choices=["auto", "performance", "balanced", "cool"],
                               help="Long-run policy profile (default: auto)")
    profile_group.add_argument("--cool", dest="rife_profile", action="store_const", const="cool",
                               help="Cool profile: 1:1:1 workers, chunks, and 15s rests")
    profile_group.add_argument("--performance", "--perf", dest="rife_profile", action="store_const", const="performance",
                               help="Upstream worker defaults with no chunk rests")
    parser.add_argument("--rife-gpu", help="RIFE GPU: auto, cpu, or numeric device id")
    parser.add_argument("-j", "--rife-threads", help="RIFE load:process:save threads; auto lets the profile choose")
    parser.add_argument("-c", "--chunk-frames", help="Source frames per resumable chunk; auto uses profile, 0 disables")
    parser.add_argument("--cooldown", "--cooldown-seconds", dest="cooldown_seconds", help="Seconds to rest between chunks")
    resume_group = parser.add_mutually_exclusive_group()
    resume_group.add_argument("--resume", dest="resume", action="store_const", const="true", default=None)
    resume_group.add_argument("--no-resume", dest="resume", action="store_const", const="false")
    keep_group = parser.add_mutually_exclusive_group()
    keep_group.add_argument("--keep-work", dest="keep_work", action="store_const", const="true", default=None,
                            help="Keep completed intermediate frames for inspection")
    keep_group.add_argument("--no-keep-work", dest="keep_work", action="store_const", const="false")
    scene_group = parser.add_mutually_exclusive_group()
    scene_group.add_argument("--scene-detection", dest="scene_detection", action="store_const", const="true", default=None,
                             help="Detect hard cuts and replace RIFE hybrids (default)")
    scene_group.add_argument("--no-scene-detection", dest="scene_detection", action="store_const", const="false",
                             help="Skip scene-cut detection and postprocessing")
    gradual_group = parser.add_mutually_exclusive_group()
    gradual_group.add_argument("--gradual-transition-detection", dest="gradual_transition_detection",
                               action="store_const", const="true", default=None,
                               help="Detect fades/dissolves as well as hard cuts (default)")
    gradual_group.add_argument("--no-gradual-transition-detection", dest="gradual_transition_detection",
                               action="store_const", const="false",
                               help="Protect hard cuts only")
    parser.add_argument("--on-exists", choices=["ask", "overwrite", "rename", "trash", "fail"])
    parser.add_argument("--on-exists-unattended", choices=["overwrite", "rename", "trash", "fail"])
    parser.add_argument("--overwrite-timeout", type=float)
    add_generic_config_overrides(parser)

def build_parser():
    parser = argparse.ArgumentParser(description="ffrife - AI frame interpolation (rife-ncnn-vulkan) for any video")
    subparsers = parser.add_subparsers(dest="command")

    subparsers.add_parser("setup", help="Interactive: download/configure the rife-ncnn-vulkan binary")

    p_config = subparsers.add_parser("config", help="Manage configuration")
    p_config.add_argument("action", choices=["set", "get", "list"], nargs="?", default="list")
    p_config.add_argument("key", nargs="?")
    p_config.add_argument("value", nargs="?")

    p_benchmark = subparsers.add_parser("benchmark", help="Time this machine's video encoders for speed/size/quality and suggest the best default")
    p_benchmark.add_argument("--sample", help="Real clip to benchmark against (default: a synthetic test clip)")
    p_benchmark.add_argument("--apply", action="store_true", help="Save the recommended hardware_encoder/video_codec/video_crf to config instead of just printing them")
    p_benchmark.add_argument("--quick", action="store_true", help="Skip the crf sweep (one crf per codec) for a faster, coarser answer")

    p_run = subparsers.add_parser("run", help="Interpolate a file (also the default when no subcommand is given)")
    p_run.add_argument("input", help="Local path or remote URL")
    p_run.add_argument("-o", "--output", help="Defaults to <input>_rife<ext> alongside the input")
    add_processing_arguments(p_run)

    p_batch = subparsers.add_parser("batch", aliases=["bulk"], help="Interpolate folders, globs, or file lists sequentially")
    p_batch.add_argument("inputs", nargs="*", help="Files, folders, or quoted wildcard patterns")
    p_batch.add_argument("--glob", dest="patterns", action="append", default=[], help="Additional glob pattern; repeatable")
    p_batch.add_argument("--list", dest="list_files", action="append", default=[], help="Text file with one input path per line; repeatable")
    p_batch.add_argument("-O", "--output-dir", required=True)
    p_batch.add_argument("--output-name", default="{name}", help="Output template using {stem}, {suffix}, {name} - "
                         "defaults to the source's own name since -O already separates outputs into their own folder; "
                         "the usual --on-exists handling still protects against actually colliding with the source")
    p_batch.add_argument("-r", "--recursive", action="store_true", help="Recurse through input folders and ** globs")
    p_batch.add_argument("--fail-fast", action="store_true", help="Stop the batch after the first failed file")
    add_processing_arguments(p_batch, include_trim=False)

    # On every subparser, not the top-level parser: normalize_argv rewrites
    # a bare `ffrife --no-color in.mp4 ...` to `run --no-color in.mp4 ...`,
    # putting the flag AFTER the subcommand token, where only a subparser's
    # own registered args (not the top-level parser's) are recognized.
    for p in (subparsers.choices["setup"], p_config, p_benchmark, p_run, p_batch):
        color_group = p.add_mutually_exclusive_group()
        color_group.add_argument("--color", dest="color", action="store_true", default=None, help="Force colored output for this run (overrides the shared color_output config and auto-detection)")
        color_group.add_argument("--no-color", dest="color", action="store_false", help="Disable colored output for this run")
    return parser

def normalize_argv(argv):
    """`ffrife <input> -o <output> ...` works without typing the 'run'
    subcommand explicitly - only dispatch to it when the first arg isn't
    already a known subcommand name."""
    if argv and argv[0] not in ("setup", "config", "run", "batch", "bulk", "benchmark", "-h", "--help"):
        return ["run"] + argv
    return argv

def main():
    migrate_legacy_config_dir()
    args = build_parser().parse_args(normalize_argv(sys.argv[1:]))
    _jwkit_common.maybe_auto_update(Path(__file__).resolve().parent)
    config = load_config()
    # Applied before binary resolution below (not per-command) so a
    # --ffmpeg-binary/--ffprobe-binary override actually takes effect for
    # this run, rather than resolving against the pre-override config. A
    # no-op for subcommands that don't register these flags at all -
    # getattr(args, key, None) just finds nothing to apply.
    apply_generic_config_overrides(args, config)

    global FFMPEG_BIN, FFPROBE_BIN, COLOR
    COLOR = _jwkit_common.Colorizer(_jwkit_common.resolve_color_enabled(_jwkit_common.load_jwkit_config(), cli_override=getattr(args, "color", None)))
    FFMPEG_BIN = resolve_ffmpeg_binary(config)
    FFPROBE_BIN = resolve_ffprobe_binary(config)

    if args.command == "setup":
        cmd_setup(config)
    elif args.command == "config":
        cmd_config(args, config)
    elif args.command == "benchmark":
        cmd_benchmark(args, config)
    elif args.command == "run":
        apply_run_overrides(args, config)
        jwkit_config = _jwkit_common.load_jwkit_config()
        for arg_name, config_key in (("on_exists", "on_output_exists"), ("on_exists_unattended", "on_output_exists_unattended"), ("overwrite_timeout", "overwrite_prompt_timeout")):
            value = getattr(args, arg_name, None)
            if value is not None:
                jwkit_config[config_key] = value
        requested_output = args.output or default_output_path(args.input)
        output = _jwkit_common.resolve_output_conflict(requested_output, jwkit_config)
        if output is None:
            sys.exit(1)

        ok = interpolate(args.input, output, config, start=args.start, end=args.end, vf=args.vf, fps=args.fps, speed=args.speed)
        sys.exit(0 if ok else 1)
    elif args.command in ("batch", "bulk"):
        apply_run_overrides(args, config)
        config["_batch_mode"] = True
        sources = collect_batch_inputs(args.inputs, args.patterns, args.list_files, args.recursive)
        if not sources:
            print("No supported video files found.", file=sys.stderr)
            sys.exit(2)
        output_dir = Path(args.output_dir).expanduser()
        output_dir.mkdir(parents=True, exist_ok=True)
        jwkit_config = _jwkit_common.load_jwkit_config()
        for arg_name, config_key in (("on_exists", "on_output_exists"), ("on_exists_unattended", "on_output_exists_unattended"), ("overwrite_timeout", "overwrite_prompt_timeout")):
            value = getattr(args, arg_name, None)
            if value is not None:
                jwkit_config[config_key] = value
        failures = []
        completed = skipped = 0
        # The frame count here is a placeholder, not a real probe - it only
        # matters when rife_profile=auto, and auto always resolves to
        # balanced in batch mode (_batch_mode=True short-circuits the size
        # check in resolve_rife_policy) regardless of what's passed.
        batch_pause = config_float(resolve_rife_policy(config, 2), "cooldown_seconds", 0)
        print(f"Batch: {len(sources)} file(s), processed sequentially to limit sustained load.")
        for index, source in enumerate(sources, 1):
            print(f"\n[{index}/{len(sources)}] {source}")
            requested = batch_output_path(source, output_dir, args.output_name)
            output = _jwkit_common.resolve_output_conflict(requested, jwkit_config)
            if output is None:
                skipped += 1
                continue
            try:
                if interpolate(source, output, config, vf=args.vf, fps=args.fps, speed=args.speed):
                    completed += 1
                else:
                    failures.append((source, "interpolation unavailable"))
            except KeyboardInterrupt:
                print("\nBatch interrupted; completed chunks are saved for resume.")
                raise
            except Exception as exc:
                failures.append((source, str(exc)))
                print(f"Failed: {exc}", file=sys.stderr)
                if args.fail_fast:
                    break
            if batch_pause and index < len(sources):
                print(f"Cooling down for {batch_pause}s before the next file (Ctrl-C is safe)...")
                time.sleep(batch_pause)
        print(f"\nBatch summary: {completed} completed, {skipped} skipped, {len(failures)} failed.")
        for source, error in failures:
            print(f"  FAILED {source}: {error}")
        sys.exit(1 if failures else 0)
    else:
        build_parser().print_help()

if __name__ == "__main__":
    main()
