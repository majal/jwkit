def run_ffmpeg(args, duration=None, slow_after=4.0, label="Encoding"):
    base = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y"]
    print()
    print(COLOR.header(f"{label}..."))
    print(f"Running: {' '.join(base + args)}")

    if not duration:
        subprocess.run(base + args, check=True)
        return

    cmd = base + ["-progress", "pipe:1", "-nostats"] + args
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True, bufsize=1)
    start = time.time()
    shown = False
    eta_estimator = _jwkit_common.ProgressETA(duration)
    last_print = last_eta = 0.0; eta_display = None
    for line in proc.stdout:
        line = line.strip()
        if not line.startswith("out_time="):
            continue
        try:
            current = parse_hms(line.split("=", 1)[1])
        except ValueError:
            continue
        if not shown and time.time() - start > slow_after:
            shown = True
        now = time.time(); eta = eta_estimator.update(current, now)
        if now - last_eta >= 5.0: eta_display, last_eta = eta, now
        if shown and now - last_print >= 1.0:
            print_time_progress(current, duration, label=label, eta_seconds=eta_display)
            last_print = now
    proc.stdout.close()
    proc.wait()
    if shown:
        print_time_progress(duration, duration, label=label, done=True)
        print()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)

# --- RIFE install ---
def rife_release_hint():
    system = platform.system()
    if system == "Darwin":
        return "rife-ncnn-vulkan-*-macos.zip (macOS, works on both Intel and Apple Silicon)"
    if system == "Linux":
        return "rife-ncnn-vulkan-*-ubuntu.zip (Linux)"
    return "rife-ncnn-vulkan-*-windows.zip (Windows)"

def prune_unused_models(models_dir, keep_name):
    """The upstream release zip bundles ~10 model directories (rife-v2.3,
    rife-v3.1, rife-HD, rife-anime, ...) totaling ~450MB, but interpolate()
    only ever uses the single configured rife_model. Removes every sibling
    directory in `models_dir` except `keep_name` - leaves files (the
    executable, LICENSE, README) untouched."""
    for entry in Path(models_dir).iterdir():
        if entry.is_dir() and entry.name != keep_name:
            shutil.rmtree(entry)

def install_rife(config):
    """Download the platform-matching rife-ncnn-vulkan release, unzip it
    into BIN_DIR, and point rife_binary_path at the extracted executable.
    Returns the resolved binary path on success, None on failure."""
    system = platform.system()
    suffix = RIFE_ASSET_SUFFIX.get(system)
    if not suffix:
        print(f"No known rife-ncnn-vulkan release for platform '{system}'; install manually.")
        return None

    release = fetch_json(RIFE_RELEASES_API)
    if not release:
        return None
    asset = next((a for a in release.get("assets", []) if a.get("name", "").endswith(suffix)), None)
    if not asset:
        print(f"No release asset ending in '{suffix}' found in the latest rife-ncnn-vulkan release.")
        return None

    BIN_DIR.mkdir(parents=True, exist_ok=True)
    zip_path = BIN_DIR / asset["name"]
    if not download_file(asset["browser_download_url"], zip_path):
        return None

    try:
        with zipfile.ZipFile(zip_path) as zf:
            zf.extractall(BIN_DIR)
    finally:
        zip_path.unlink(missing_ok=True)

    exe_name = "rife-ncnn-vulkan.exe" if system == "Windows" else "rife-ncnn-vulkan"
    match = next((p for p in BIN_DIR.rglob(exe_name)), None)
    if not match:
        print(f"Downloaded the RIFE release but couldn't find '{exe_name}' inside it.")
        return None

    if system != "Windows":
        match.chmod(match.stat().st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)

    prune_unused_models(match.parent, config.get("rife_model", DEFAULT_CONFIG["rife_model"]))

    config["rife_binary_path"] = str(match)
    save_config(config)
    print(f"RIFE installed: {match}")
    return match

def run_rife(rife_path, in_frames, out_frames, target_count, model_path=None, slow_after=4.0,
             threads=None, gpu=None):
    """rife-ncnn-vulkan has no built-in progress output, so this polls the
    output directory's file count against `target_count`. By far the
    slowest step in the whole pipeline - measured ~125-130s for a
    31s/936-frame clip on an Apple Silicon GPU.

    `-n target_count` asks for an exact (possibly non-2x) output frame
    count and `-m model_path` selects the model - only rife-v4/rife-v4.6
    support either; older bundled models (v2.x/v3.x/HD/UHD/anime) reject
    a non-default -n outright with "only rife-v4 model support custom
    numframe and timestep"."""
    cmd = [rife_path, "-i", str(in_frames), "-o", str(out_frames), "-n", str(target_count)]
    if model_path:
        cmd += ["-m", str(model_path)]
    if threads and str(threads).lower() != "auto":
        if not re.fullmatch(r"\d+:\d+:\d+", str(threads)):
            raise ValueError("rife_threads must be load:process:save, for example 1:1:1")
        if any(int(value) < 1 for value in str(threads).split(":")):
            raise ValueError("every rife_threads value must be at least 1")
        cmd += ["-j", str(threads)]
    if gpu is not None and str(gpu).lower() != "auto":
        gpu_id = "-1" if str(gpu).lower() == "cpu" else str(gpu)
        if not re.fullmatch(r"(?:-1|\d+)", gpu_id):
            raise ValueError("rife_gpu must be auto, cpu, or a numeric GPU id")
        cmd += ["-g", gpu_id]
    proc = subprocess.Popen(cmd)
    start = time.time()
    shown = False
    eta_estimator = _jwkit_common.ProgressETA(target_count)
    last_print = last_eta = 0.0; eta_display = None
    try:
        while proc.poll() is None:
            time.sleep(0.5)
            if not shown and time.time() - start > slow_after:
                shown = True
            if shown:
                current = len(list(Path(out_frames).glob("*.png")))
                now = time.time()
                eta = eta_estimator.update(current, now)
                if now - last_eta >= 5.0: eta_display, last_eta = eta, now
                if now - last_print >= 1.0:
                    print_count_progress(current, target_count, label="RIFE", eta_seconds=eta_display)
                    last_print = now
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
    if shown:
        print_count_progress(target_count, target_count, label="RIFE", done=True)
        print()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, [rife_path])

def run_rife_chunk(rife_path, chunk_in, chunk_out, chunk_target, model_path, threads, gpu, label):
    """run_rife wrapper for the per-chunk loops in _render_rife_chunks:
    retries a chunk from scratch if the upstream rife-ncnn-vulkan binary
    itself crashes (observed in the wild as an intermittent SIGSEGV on
    Apple Silicon's Vulkan/Metal backend several chunks into an otherwise
    identical run, not tied to any particular chunk's content) instead of
    losing the whole multi-hour job to one flaky invocation of a chunk
    that's trivially re-runnable. A deterministic failure (bad args, a
    frame the binary can never process) still surfaces after MAX_ATTEMPTS,
    same as before this wrapper existed."""
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            run_rife(rife_path, chunk_in, chunk_out, chunk_target, model_path=model_path,
                     threads=threads, gpu=gpu)
            return
        except subprocess.CalledProcessError as exc:
            if attempt == MAX_ATTEMPTS:
                raise
            print(f"{label} crashed ({exc}); retrying (attempt {attempt + 1}/{MAX_ATTEMPTS})...")
            shutil.rmtree(chunk_out, ignore_errors=True)
            Path(chunk_out).mkdir(parents=True, exist_ok=True)
            time.sleep(RETRY_BACKOFF ** attempt)

# --- Retiming (slow-motion/fast-forward) ---
def parse_speed(value):
    """Accepts whatever notation is most natural to type: a plain decimal
    (0.5, 2.5), a fraction (1/3), or a percentage (40%, 150%) - all resolve
    to the same internal multiplier passed to interpolate()'s `speed`."""
    s = str(value).strip()
    if s.endswith("%"):
        return float(s[:-1]) / 100
    if "/" in s:
        num, den = s.split("/", 1)
        return float(num) / float(den)
    return float(s)

def parse_trim_window(value):
    """Parse the compact ``--window START-END`` CLI form."""
    try:
        return _jwkit_common.parse_time_range(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from exc

def resolve_processing_window(args):
    """Return the effective CLI trim bounds, rejecting ambiguous forms."""
    window = getattr(args, "window", None)
    start = getattr(args, "start", None)
    end = getattr(args, "end", None)
    if window is not None:
        if start is not None or end is not None:
            raise ValueError("--window cannot be combined with --start or --end")
        return window
    if start is not None and end is not None and end <= start:
        raise ValueError("--end must be greater than --start")
    return start, end

def atempo_chain(speed):
    """ffmpeg's atempo filter only accepts a single factor in [0.5, 2.0];
    chain multiple instances to cover any speed value so audio stays in
    sync with a setpts-retimed video track. Returns None for speed 1/None
    (no retiming needed)."""
    if not speed or speed == 1:
        return None
    filters = []
    remaining = speed
    while remaining > 2.0:
        filters.append("atempo=2.0")
        remaining /= 2.0
    while remaining < 0.5:
        filters.append("atempo=0.5")
        remaining /= 0.5
    filters.append(f"atempo={remaining:.6g}")
    return ",".join(filters)

def retimed_duration(duration, speed):
    """run_ffmpeg's progress bar reads ffmpeg's own out_time=, which for a
    setpts=PTS/speed-retimed encode reflects the OUTPUT timeline, not the
    source-relative `duration` passed in - a half-speed encode (speed=0.5)
    actually runs twice as long, a 3x encode a third as long. Without this,
    the bar hits 100% at the halfway point (or overshoots) well before
    ffmpeg is actually done."""
    if duration and speed and speed != 1:
        return duration / speed
    return duration

def probe_source_fps(source):
    """ffprobe's r_frame_rate comes back as an 'N/D' fraction (e.g.
    '30000/1001'), not a plain float. Used by interpolate() to size RIFE's
    -n target frame count so the requested `fps` is hit exactly regardless
    of the source's real frame rate, instead of relying on RIFE's own
    implicit 2x-doubling default."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "v:0", "-show_entries",
           "stream=r_frame_rate,avg_frame_rate", "-of", "json", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    try:
        streams = json.loads(result.stdout).get("streams", [])
    except (json.JSONDecodeError, AttributeError):
        streams = []
    for stream in streams:
        for key in ("r_frame_rate", "avg_frame_rate"):
            value = stream.get(key)
            try:
                fps = float(Fraction(value))
            except (TypeError, ValueError, ZeroDivisionError):
                continue
            if math.isfinite(fps) and fps > 0:
                return fps
    raise ValueError(f"No usable video frame rate found in {source}; the source may contain no video stream.")

def probe_source_resolution(source):
    """Width/height of the source's first video stream. Used to scale
    long_run_frames by expected per-frame RIFE cost (see resolve_rife_policy)
    - a short but high-resolution clip can take as long to run as a longer
    low-resolution one, so a raw frame-count threshold alone underestimates
    it."""
    cmd = [FFPROBE_BIN, "-v", "error", "-select_streams", "v:0", "-show_entries",
           "stream=width,height", "-of", "csv=s=x:p=0", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    width, height = result.stdout.strip().split("x")
    return int(width), int(height)

# --- Source "extras": everything a full-video source can carry that the
# RIFE frame+isolated-audio merge (and the ffmpeg fallback's own -map-less
# default stream selection) has no way to see: extra audio tracks,
# subtitles, chapters, attachments (fonts, etc.), and embedded cover art.
# carry_over_source_extras below reattaches whatever this finds.
COVER_ART_CODECS = {  # codec_name -> (extension, mimetype) for extracting + reattaching embedded cover art
    "mjpeg": (".jpg", "image/jpeg"),
    "png": (".png", "image/png"),
    "bmp": (".bmp", "image/bmp"),
    "gif": (".gif", "image/gif"),
}
MP4_LIKE_CONTAINERS = {".mp4", ".m4v", ".mov", ".m4a"}

def describe_source_extras(source):
    """Probe `source` for everything beyond its primary video+first-audio
    track: extra audio stream indices, subtitle/attachment stream counts, an
    embedded cover-art stream (ffmpeg surfaces this as a video stream with
    the attached_pic disposition, distinct from a real codec_type=attachment
    like an embedded font - confirmed empirically, not documented anywhere
    obvious), and whether the source has any chapters at all."""
    cmd = [FFPROBE_BIN, "-v", "error", "-show_entries",
           "stream=index,codec_type,codec_name:stream_disposition=attached_pic",
           "-of", "json", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    streams = json.loads(result.stdout).get("streams", [])
    audio = [s for s in streams if s.get("codec_type") == "audio"]
    subtitle_streams = [s for s in streams if s.get("codec_type") == "subtitle"]
    subtitle_count = len(subtitle_streams)
    attachment_count = sum(1 for s in streams if s.get("codec_type") == "attachment")
    cover = next((s for s in streams if s.get("codec_type") == "video"
                  and s.get("disposition", {}).get("attached_pic")), None)

    chapters_cmd = [FFPROBE_BIN, "-v", "error", "-show_chapters", "-of", "json", str(source)]
    chapters_result = subprocess.run(chapters_cmd, capture_output=True, text=True, check=True)
    chapter_count = len(json.loads(chapters_result.stdout).get("chapters", []))

    return {
        "extra_audio_indices": [s["index"] for s in audio[1:]],
        "subtitle_indices": [s["index"] for s in subtitle_streams],
        "subtitle_count": subtitle_count,
        "attachment_count": attachment_count,
        "cover": {"index": cover["index"], "codec_name": cover.get("codec_name")} if cover else None,
        "chapter_count": chapter_count,
    }

def has_any_extras(extras):
    return bool(extras["extra_audio_indices"] or extras["subtitle_count"]
                or extras["attachment_count"] or extras["cover"] or extras["chapter_count"])

def _extract_cover_art(source, cover, work_dir):
    """Pull the source's embedded cover-art stream out to its own small
    image file, so it can be reattached with whichever mechanism the target
    container actually needs (see carry_over_source_extras) instead of
    trying to map it directly out of `source` alongside everything else."""
    ext, _mimetype = COVER_ART_CODECS.get(cover["codec_name"], (".jpg", "image/jpeg"))
    cover_path = Path(work_dir) / f"cover{ext}"
    cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y",
           "-i", str(source), "-map", f"0:{cover['index']}", "-frames:v", "1"]
    # An unrecognized still-image codec is re-encoded to plain jpeg rather
    # than copied verbatim, so reattaching it below always has a codec the
    # target container actually supports.
    cmd += ["-c", "copy"] if cover["codec_name"] in COVER_ART_CODECS else ["-c:v", "mjpeg"]
    cmd += [str(cover_path)]
    subprocess.run(cmd, check=True, capture_output=True)
    return cover_path

def source_window_args(start=None, end=None):
    """Input-side ffmpeg arguments for an exact source window.

    ``-to`` after an input ``-ss`` is easy to misread and, with copied
    streams carrying source timestamps/chapters, has produced containers
    whose duration outlived their video. Express the endpoint as a duration
    instead. The caller is still responsible for rebasing copied timestamps
    or decoding audio when sample-exact duration matters.
    """
    args = []
    if start is not None:
        args += ["-ss", str(start)]
    if end is not None:
        duration = end - (start or 0.0)
        if duration <= 0:
            raise ValueError("--end must be greater than --start")
        args += ["-t", str(duration)]
    return args


def _ffmetadata_escape(value):
    return str(value).replace("\\", "\\\\").replace("\n", "\\\n").replace("=", "\\=").replace(";", "\\;").replace("#", "\\#")


def _srt_seconds(value):
    hours, minutes, rest = value.replace(".", ",").split(":")
    seconds, millis = rest.split(",")
    return int(hours) * 3600 + int(minutes) * 60 + int(seconds) + int(millis) / 1000


def _srt_timestamp(seconds):
    millis = max(0, round(seconds * 1000))
    hours, millis = divmod(millis, 3_600_000)
    minutes, millis = divmod(millis, 60_000)
    secs, millis = divmod(millis, 1000)
    return f"{hours:02d}:{minutes:02d}:{secs:02d},{millis:03d}"


def clip_srt_file(source_path, output_path, start, end):
    """Clip SRT cues against a source window and rebase them to zero."""
    text = Path(source_path).read_text(encoding="utf-8-sig", errors="replace")
    window_start = float(start or 0.0)
    window_end = float(end) if end is not None else float("inf")
    timing = re.compile(r"(?m)^(\d{2,}:\d{2}:\d{2}[,.]\d{3})\s+-->\s+(\d{2,}:\d{2}:\d{2}[,.]\d{3})(.*)$")
    output_blocks = []
    for block in re.split(r"\r?\n\s*\r?\n", text.strip()):
        match = timing.search(block)
        if not match:
            continue
        cue_start, cue_end = _srt_seconds(match.group(1)), _srt_seconds(match.group(2))
        clipped_start, clipped_end = max(cue_start, window_start), min(cue_end, window_end)
        if clipped_end <= clipped_start:
            continue
        body = block[match.end():].lstrip("\r\n")
        output_blocks.append(
            f"{len(output_blocks) + 1}\n{_srt_timestamp(clipped_start - window_start)} --> "
            f"{_srt_timestamp(clipped_end - window_start)}{match.group(3)}\n{body}"
        )
    Path(output_path).write_text("\n\n".join(output_blocks) + ("\n" if output_blocks else ""), encoding="utf-8")
    return bool(output_blocks)


def write_clipped_chapters(source, start, end, work_dir):
    """Write source chapters intersecting ``[start, end)`` on a zero-based
    timeline. Chapters crossing either boundary are clipped, and chapters
    wholly outside it are omitted."""
    cmd = [FFPROBE_BIN, "-v", "error", "-show_chapters", "-of", "json", str(source)]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    chapters = json.loads(result.stdout).get("chapters", [])
    window_start = float(start or 0.0)
    window_end = float(end) if end is not None else float("inf")
    lines = [";FFMETADATA1"]
    kept = 0
    for chapter in chapters:
        chapter_start = float(chapter.get("start_time", 0.0))
        chapter_end = float(chapter.get("end_time", chapter_start))
        clipped_start = max(chapter_start, window_start)
        clipped_end = min(chapter_end, window_end)
        if clipped_end <= clipped_start:
            continue
        kept += 1
        lines += [
            "[CHAPTER]", "TIMEBASE=1/1000",
            f"START={round((clipped_start - window_start) * 1000)}",
            f"END={round((clipped_end - window_start) * 1000)}",
        ]
        for key, value in chapter.get("tags", {}).items():
            lines.append(f"{_ffmetadata_escape(key)}={_ffmetadata_escape(value)}")
    if not kept:
        return None
    path = Path(work_dir) / "chapters.ffmetadata"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def prepare_clipped_stream_extras(source, extras, start, end, work_dir, *, want_subtitles, want_extra_audio):
    """Clip/rebase subtitle and secondary-audio streams into a small
    Matroska sidecar. Subtitle streams are normalized to SRT then cues are
    explicitly clipped; audio is decoded through atrim/asetpts. Input-side
    stream copy alone cannot enforce either boundary correctly."""
    if not (want_subtitles or want_extra_audio):
        return None, False
    work_dir = Path(work_dir)
    clipped_subtitles = []
    if want_subtitles:
        for position, index in enumerate(extras.get("subtitle_indices", [])):
            raw = work_dir / f"subtitle-{position}-source.srt"
            clipped = work_dir / f"subtitle-{position}-clipped.srt"
            extract = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y", "-i", str(source),
                       "-map", f"0:{index}", "-c:s", "srt", str(raw)]
            try:
                subprocess.run(extract, check=True, capture_output=True, text=True)
            except subprocess.CalledProcessError:
                # Bitmap or otherwise non-text subtitles may not convert to
                # SRT. Keep processing the other streams; carryover's normal
                # contract is that an unsupported subtitle never sinks the
                # finished interpolation.
                continue
            if clip_srt_file(raw, clipped, start, end):
                clipped_subtitles.append(clipped)
    if not clipped_subtitles and not want_extra_audio:
        return None, False
    path = work_dir / "timed-extras.mkv"
    cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y"] + source_window_args(start, end) + ["-i", str(source)]
    for subtitle in clipped_subtitles:
        cmd += ["-i", str(subtitle)]
    audio_maps = []
    if want_extra_audio:
        filters = []
        duration = (end - (start or 0.0)) if end is not None else None
        for position, index in enumerate(extras["extra_audio_indices"]):
            chain = f"[0:{index}]"
            if duration is not None:
                chain += f"atrim=duration={duration:.12g},"
            chain += f"asetpts=PTS-STARTPTS[extraa{position}]"
            filters.append(chain)
            audio_maps += ["-map", f"[extraa{position}]"]
        cmd += ["-filter_complex", ";".join(filters)] + audio_maps
    for input_index in range(1, len(clipped_subtitles) + 1):
        cmd += ["-map", f"{input_index}:s:0"]
    cmd += ["-map_metadata", "0", "-map_chapters", "-1"]
    if want_extra_audio:
        cmd += ["-c:a", "aac", "-b:a", "192k"]
    if clipped_subtitles:
        cmd += ["-c:s", "srt"]
    cmd += [str(path)]
    subprocess.run(cmd, check=True, capture_output=True, text=True)
    return path, bool(clipped_subtitles)


def _build_remux_cmd(encoded_file, source, output_file, extras, container, cover_path, *,
                      want_subtitles, want_attachments, want_chapters, want_extra_audio, want_metadata,
                      timed_extras=None, chapters_file=None):
    cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y",
           "-i", str(encoded_file), "-i", str(source)]
    timed_input = None
    chapters_input = None
    if timed_extras:
        timed_input = 2
        cmd += ["-i", str(timed_extras)]
    if chapters_file:
        chapters_input = 2 + bool(timed_extras)
        cmd += ["-f", "ffmetadata", "-i", str(chapters_file)]
    maps = ["-map", "0:v:0", "-map", "0:a:0?"]
    # Every stream type gets its own explicit -c:<type>, never a blanket -c
    # copy - ffmpeg applies a later, narrower -c:s/-c:v:N over an earlier
    # blanket one just fine, but warns about it on every single run
    # ("Multiple -codec options specified..."), which reads as something
    # having gone wrong when it hasn't.
    codec_args = ["-c:v", "copy", "-c:a", "copy"]
    if want_extra_audio:
        if timed_input is not None:
            maps += ["-map", f"{timed_input}:a?"]
        else:
            for index in extras["extra_audio_indices"]:
                maps += ["-map", f"1:{index}?"]
    if want_subtitles:
        maps += ["-map", f"{timed_input if timed_input is not None else 1}:s?"]
        codec_args += ["-c:s", "mov_text" if container in MP4_LIKE_CONTAINERS else "copy"]
    if want_attachments:
        maps += ["-map", "1:t?"]
        codec_args += ["-c:t", "copy"]
    meta_args = ["-map_chapters", str(chapters_input if chapters_input is not None else 1) if want_chapters else "-1",
                 "-map_metadata", "1" if want_metadata else "-1"]
    thumbnail_args = []
    if cover_path:
        if container in MP4_LIKE_CONTAINERS:
            cover_input = 2 + bool(timed_extras) + bool(chapters_file)
            cmd += ["-i", str(cover_path)]
            maps += ["-map", f"{cover_input}:v:0"]
            codec_args += ["-disposition:v:1", "attached_pic"]
        else:
            # Matroska has no equivalent of the mp4-style attached_pic video
            # stream (confirmed empirically: -disposition:v:N attached_pic is
            # silently dropped by the matroska muxer) - cover art there is a
            # real Attachment element instead, written with -attach. Its
            # attachment-stream index follows whatever real attachments (see
            # want_attachments above) were already mapped ahead of it.
            attachment_slot = extras["attachment_count"] if want_attachments else 0
            thumbnail_args = ["-attach", str(cover_path), f"-metadata:s:t:{attachment_slot}", "mimetype=image/jpeg"]
    return cmd + maps + codec_args + meta_args + thumbnail_args + [str(output_file)]

def carry_over_source_extras(source, encoded_file, output_file, config, extras, start=None, end=None, speed=None):
    """Second, cheap stream-copy pass that reattaches everything the primary
    encode (RIFE's frame+isolated-audio merge, or the ffmpeg fallback's own
    -map-less default stream selection) had no way to carry over from
    `source`: extra audio tracks, subtitles, attachments, chapters, global
    container tags, and embedded cover art. `encoded_file` is the already
    fps-changed video+first-audio output; `extras` is describe_source_extras's
    result for `source`. Moves `encoded_file` straight to `output_file`
    with no extra pass at all if nothing configured to keep is actually
    present in the source.

    A --start/--end window clips and rebases subtitles, chapters, and extra
    audio tracks before this remux. --speed still drops those time-sensitive
    streams: retiming arbitrary subtitle formats losslessly is not generally
    possible. Global metadata, attachments, and the thumbnail have no time
    dimension, so those remain eligible in either case.

    Falls back to retrying once with subtitles/attachments dropped if the
    full remux fails - a bitmap subtitle codec (e.g. DVD/PGS) can't convert
    to mp4's mov_text, and an unusual attachment codec may not be one the
    target container supports either; neither should sink an otherwise-good
    interpolation over a side channel."""
    container = Path(output_file).suffix.lower()
    retimed = bool(speed and speed != 1)
    trimmed = start is not None or end is not None
    want_subtitles = not retimed and config_bool(config, "keep_subtitles", True) and extras["subtitle_count"] > 0
    want_attachments = (config_bool(config, "keep_attachments", True) and extras["attachment_count"] > 0
                        and container not in MP4_LIKE_CONTAINERS)
    want_chapters = not retimed and config_bool(config, "keep_chapters", True) and extras["chapter_count"] > 0
    want_extra_audio = (not retimed and config_bool(config, "keep_extra_audio_tracks", True)
                        and bool(extras["extra_audio_indices"]))
    want_thumbnail = config_bool(config, "keep_thumbnail", True) and extras["cover"] is not None
    want_metadata = config_bool(config, "keep_source_metadata", True)

    if not (want_subtitles or want_attachments or want_chapters or want_extra_audio or want_thumbnail or want_metadata):
        shutil.move(str(encoded_file), str(output_file))
        return

    def _last_error_line(exc):
        detail = (exc.stderr or "").strip().splitlines()
        return detail[-1] if detail else str(exc)

    work_dir = Path(tempfile.mkdtemp(prefix="ffrife-remux-"))
    try:
        timed_extras = None
        chapters_file = None
        if trimmed:
            timed_extras, subtitles_kept = prepare_clipped_stream_extras(
                source, extras, start, end, work_dir,
                want_subtitles=want_subtitles, want_extra_audio=want_extra_audio,
            )
            if want_subtitles and not subtitles_kept:
                want_subtitles = False
            chapters_file = write_clipped_chapters(source, start, end, work_dir) if want_chapters else None
            if want_chapters and chapters_file is None:
                want_chapters = False
        try:
            cover_path = _extract_cover_art(source, extras["cover"], work_dir) if want_thumbnail else None
        except subprocess.CalledProcessError as exc:
            print(f"Note: couldn't extract the source's embedded cover art ({_last_error_line(exc)}) - skipping it.")
            cover_path = None
            want_thumbnail = False

        cmd = _build_remux_cmd(encoded_file, source, output_file, extras, container, cover_path,
                               want_subtitles=want_subtitles, want_attachments=want_attachments,
                               want_chapters=want_chapters, want_extra_audio=want_extra_audio,
                               want_metadata=want_metadata, timed_extras=timed_extras,
                               chapters_file=chapters_file)
        try:
            subprocess.run(cmd, check=True, capture_output=True, text=True)
        except subprocess.CalledProcessError as exc:
            if not (want_subtitles or want_attachments):
                # Nothing left to drop and retry without - fall through to
                # the outer handler below, which keeps the good encode
                # rather than losing it over a side channel.
                raise
            print(f"Note: metadata remux failed with subtitles/attachments included "
                  f"({_last_error_line(exc)}) - retrying without them.")
            cmd = _build_remux_cmd(encoded_file, source, output_file, extras, container, cover_path,
                                   want_subtitles=False, want_attachments=False,
                                   want_chapters=want_chapters, want_extra_audio=want_extra_audio,
                                   want_metadata=want_metadata, timed_extras=timed_extras,
                                   chapters_file=chapters_file)
            subprocess.run(cmd, check=True, capture_output=True, text=True)
    except subprocess.CalledProcessError as exc:
        # Even the reduced retry (or the only attempt, if there was nothing
        # left to drop) failed - keep the already-good interpolated video
        # rather than losing it: fall back to the pre-carryover behavior of
        # just delivering the plain encode, with no metadata attached.
        print(f"Note: metadata remux failed ({_last_error_line(exc)}) - delivering the plain encode with no source metadata attached.")
        shutil.move(str(encoded_file), str(output_file))
    else:
        Path(encoded_file).unlink(missing_ok=True)
    finally:
        shutil.rmtree(work_dir, ignore_errors=True)

def resolve_target_fps(fps_spec, source_fps):
    """`fps_spec` is either a plain literal target ('60') or a source-relative
    spec: 'Nx' ('2x', '2.5x') or 'N%' ('150%'), resolved against `source_fps`
    - mirrors parse_speed's percent/plain style."""
    s = str(fps_spec).strip()
    if s.lower().endswith("x"):
        return source_fps * float(s[:-1])
    if s.endswith("%"):
        return source_fps * float(s[:-1]) / 100
    return float(s)

# --- Core: single-pass interpolation ---
def _sample_avg_frame_bytes(frame_dir, sample_size=20):
    """Average on-disk size of already-extracted frames, sampled evenly
    across the sequence rather than just the first N - PNG size varies a
    lot with per-frame detail/motion, and the goal is a number the *rest*
    of this specific clip can be projected from, not a generic constant."""
    frames = sorted(Path(frame_dir).glob("*.png"))
    if not frames:
        return None
    step = max(1, len(frames) // sample_size)
    sampled = frames[::step][:sample_size]
    return sum(f.stat().st_size for f in sampled) / len(sampled)

def _check_disk_space(frames_root, in_frames, target_count, config, peak_frames=None, avg_bytes=None):
    """Estimate the temp bytes RIFE's interpolated output is about to add
    and abort before it starts if free space on frames_root's filesystem
    looks short. Source extraction has already completed by the time this
    runs, so its frames are a sunk cost, not part of what's still needed -
    but they're exactly the calibration data used to estimate the
    (typically ~2x larger) output set, since PNG size tracks content detail
    as much as resolution and a fixed constant would be a guess where this
    clip's own frames are real data.

    `peak_frames` is how many interpolated frames can be resident at once,
    defaulting to `target_count` (every frame, kept until one final encode -
    see render_rife_frames' default path). interpolate()'s own streaming-
    encode branch passes a much smaller bound instead: chunks are encoded
    and their PNGs freed in bounded batches (see _render_rife_chunks'
    "Streaming encode" mode), so only about one batch's worth is ever on
    disk at the same time, not the whole clip."""
    if not config_bool(config, "space_check", True):
        return
    avg_bytes = avg_bytes or _sample_avg_frame_bytes(in_frames)
    if not avg_bytes:
        return  # nothing to calibrate from - skip rather than guess
    peak_frames = target_count if peak_frames is None else peak_frames
    needed = peak_frames * avg_bytes
    margin = config_float(config, "space_check_margin", 1.15)
    free = shutil.disk_usage(frames_root).free
    if needed * margin > free:
        raise RuntimeError(
            f"Disk space check failed: RIFE still needs an estimated "
            f"{needed / 1e9:.1f}GB for {peak_frames} interpolated frames "
            f"(~{avg_bytes / 1e3:.0f}KB/frame, sampled from this clip's own extracted "
            f"source frames), which with a {margin:g}x safety margin is "
            f"{needed * margin / 1e9:.1f}GB - but only {free / 1e9:.1f}GB is free on "
            f"{frames_root}'s filesystem. Free up space, or pass --no-space-check to "
            f"skip this check and proceed anyway."
        )
    print(f"Disk space check: ~{needed / 1e9:.1f}GB estimated for RIFE's output frames, "
          f"{free / 1e9:.1f}GB free - OK.")

def _human_bytes(value):
    """Readable size for the planner's own one-line summaries. GB/MB rather
    than GiB/MiB deliberately: it's the same unit `df`-style free-space
    numbers and the existing disk-space check already print."""
    value = float(value or 0)
    for unit, scale in (("GB", 1e9), ("MB", 1e6), ("KB", 1e3)):
        if value >= scale:
            return f"{value / scale:.1f}{unit}"
    return f"{value:.0f}B"


def probe_source_duration(source):
    """Container duration in seconds, or None. Used only to aim
    _probe_frame_bytes at a representative frame (the middle of the clip
    rather than frame 1, which is disproportionately often a black or
    title frame and would skew the whole plan's bytes-per-frame estimate)."""
    try:
        result = subprocess.run(
            [FFPROBE_BIN, "-v", "error", "-show_entries", "format=duration",
             "-of", "default=nokey=1:noprint_wrappers=1", str(source)],
            capture_output=True, text=True, timeout=30)
        return float(result.stdout.strip()) or None
    except (subprocess.SubprocessError, OSError, ValueError):
        return None


PROBE_POSITIONS = (0.08, 0.28, 0.5, 0.72, 0.92)

def _probe_frame_bytes(source, vf=None, start=None, end=None, per_position=2):
    """Average extracted-PNG size for THIS source through THIS filter chain,
    measured from real frames spread across the window instead of guessed
    from resolution.

    PNG size tracks content detail as much as pixel count - a flat title
    card and a grainy handheld shot at the same resolution differ several
    fold - so every byte figure the planner reasons about is calibrated on
    the clip itself. This runs *before* extraction (that's the whole point:
    the plan decides whether extracting everything is even affordable), so
    unlike _sample_avg_frame_bytes it has to decode its own samples.

    Spreading those samples over several positions is not fussiness. A
    single clump of consecutive frames measures one shot, and one shot is
    routinely nothing like the clip's average: on a three-scene test clip
    whose real average was 14.2KB/frame, a midpoint-only probe landed in a
    static colour-bars section and reported 2.1KB - a 7x underestimate,
    which is exactly the direction that makes the planner think an
    unaffordable job fits. A handful of extra seeks costs milliseconds
    against a run measured in minutes. Returns None if nothing decoded,
    leaving the caller to fall back to its own estimate."""
    window_start = float(start or 0.0)
    window_end = float(end) if end is not None else probe_source_duration(source)
    if window_end and window_end > window_start:
        seeks = [window_start + (window_end - window_start) * fraction for fraction in PROBE_POSITIONS]
    else:
        seeks = [window_start]
    sizes = []
    probe_dir = Path(tempfile.mkdtemp(prefix="ffrife-probe-"))
    try:
        for index, seek in enumerate(seeks):
            spot = probe_dir / f"{index:03d}"
            spot.mkdir()
            cmd = [FFMPEG_BIN, "-hide_banner", "-loglevel", "error", "-y", "-ss", f"{seek:.6f}", "-i", str(source)]
            if vf:
                cmd += ["-vf", vf]
            cmd += ["-frames:v", str(per_position), f"{spot}/%08d.png"]
            try:
                subprocess.run(cmd, capture_output=True, timeout=180)
            except (subprocess.SubprocessError, OSError):
                continue
            sizes.extend(f.stat().st_size for f in spot.glob("*.png"))
        return (sum(sizes) / len(sizes)) if sizes else None
    finally:
        shutil.rmtree(probe_dir, ignore_errors=True)


# --- Pipeline planning ---------------------------------------------------
#
# A RIFE run has two independent speed-vs-disk axes, and the right setting
# for a four-second verse clip is not the right setting for a forty-minute
# program:
#
#   extraction - decode every source frame to PNG upfront (one clean
#                sequential pass, fastest) or decode each chunk's own window
#                on demand (an extra seek+decode per chunk, but the whole
#                source frame set never has to be resident at once).
#   encode     - hand every interpolated frame to one whole-clip encode at
#                the end (fastest, and best compression: one encoder
#                process, one uninterrupted lookahead) or encode and free
#                them in bounded segments as they're produced (bounded peak
#                disk, at a fixed per-segment process-startup cost and a
#                lookahead reset per boundary).
#
# The fast end of both axes is strictly better wherever it fits, so the
# planner is not trading time for space on principle - it spends as much of
# the available disk as it safely can in order to buy time back. A clip
# whose whole frame set fits gets the single-encode pipeline verbatim; one
# that doesn't gets the largest segments that do, so the wall-clock penalty
# is the smallest one that still bounds the run; and one whose *source*
# frames alone would crowd out the budget gets windowed extraction, instead
# of the mid-run disk-exhaustion failure that used to be the only other
# outcome (the existing disk check runs only after extraction has already
# completed, treating those frames as a sunk cost).
PipelinePlan = collections.namedtuple(
    "PipelinePlan",
    "extraction stream segment_chunks chunk_frames chunk_count peak_bytes budget_bytes free_bytes avg_bytes reason",
)

# Encoded video is a rounding error beside raw PNG frames (a few percent at
# the CRFs these tools use) but it isn't zero, and it lands on the same
# filesystem - hold a little of the budget back for the segments and the
# final muxed output rather than planning to spend every last byte.
ENCODED_OUTPUT_ALLOWANCE = 0.08
# Above this share of the budget, keeping the whole source frame set
# resident leaves too little room for segments to be worth encoding in - at
# which point windowed extraction buys far more than it costs.
SOURCE_SHARE_LIMIT = 0.75
# pipeline_mode=compact plans against a quarter of the normal budget: the
# point of asking for compact is to leave the disk mostly alone, not merely
# to stay under the same ceiling auto already respects.
COMPACT_BUDGET_SCALE = 0.25


def plan_pipeline(config, *, input_frame_count, target_count, avg_bytes, free_bytes, chunk_frames):
    """Pick the fastest extraction/encode pipeline whose peak temporary disk
    usage still fits the configured share of free space.

    `chunk_frames` is the profile's own resumability-driven choice (0 for
    unchunked) - the planner only ever shrinks it, and only when bounding
    peak disk requires it, since chunking is what makes a bound possible at
    all. `avg_bytes` is this clip's own measured bytes-per-PNG (see
    _probe_frame_bytes). Returns a PipelinePlan; `reason` is the one-line
    human explanation printed with it."""
    mode = str(config.get("pipeline_mode", "auto")).strip().lower()
    if mode not in {"auto", "fast", "compact"}:
        raise ValueError("pipeline_mode must be auto, fast, or compact")
    extraction_mode = str(config.get("extraction_mode", "auto")).strip().lower()
    if extraction_mode not in {"auto", "full", "windowed"}:
        raise ValueError("extraction_mode must be auto, full, or windowed")

    budget = max(0.0, float(free_bytes) * config_float(config, "disk_budget_fraction", 0.70))
    budget *= (1.0 - ENCODED_OUTPUT_ALLOWANCE)
    if mode == "compact":
        budget *= COMPACT_BUDGET_SCALE
    avg_bytes = max(1.0, float(avg_bytes or 1.0))
    input_frame_count = max(1, int(input_frame_count))
    ratio = max(0.01, float(target_count) / input_frame_count)
    source_bytes = input_frame_count * avg_bytes
    interp_bytes = float(target_count) * avg_bytes

    requested_segments = str(config.get("stream_segment_chunks", "auto")).strip().lower()
    pinned_segments = None if requested_segments in {"", "auto"} else config_int(config, "stream_segment_chunks", 8, minimum=1)

    def finish(extraction, stream, planned_chunk_frames, segment_chunks, reason):
        ranges = _chunk_ranges(input_frame_count, planned_chunk_frames)
        count = len(ranges)
        if stream:
            segment_chunks = pinned_segments if pinned_segments is not None else segment_chunks
            segment_chunks = max(1, min(int(segment_chunks), count))
        else:
            segment_chunks = count
        resident_source = source_bytes if extraction == "full" else max(end - start for start, end in ranges) * avg_bytes
        resident_interp = interp_bytes * (min(1.0, segment_chunks / count) if stream else 1.0)
        return PipelinePlan(extraction, stream, segment_chunks, planned_chunk_frames, count,
                            resident_source + resident_interp, budget, float(free_bytes), avg_bytes, reason)

    if mode == "fast":
        return finish("full", False, chunk_frames, 0,
                      "pipeline_mode=fast - one upfront extraction and one whole-clip encode, peak disk unbounded")
    if mode == "auto" and extraction_mode != "windowed" and source_bytes + interp_bytes <= budget:
        return finish("full", False, chunk_frames, 0,
                      f"whole job fits the budget ({_human_bytes(source_bytes + interp_bytes)} of "
                      f"{_human_bytes(budget)}) - nothing to gain from bounding it")

    # Everything below bounds peak disk, which is only possible with
    # chunking - an unchunked profile (chunk_frames=0) has exactly one chunk
    # covering the whole clip, so there is nothing to encode and free early.
    windowed = extraction_mode == "windowed" or (
        extraction_mode == "auto" and source_bytes > budget * SOURCE_SHARE_LIMIT)

    if windowed:
        # Peak is one chunk's own source frames plus the segment they feed,
        # so a chunk costs (1 + ratio) frame-sizes of budget.
        affordable = int(budget / (avg_bytes * (1.0 + ratio)))
        planned = max(2, min(chunk_frames or input_frame_count, max(2, affordable)))
        room = max(avg_bytes, budget - planned * avg_bytes)
        segments = max(1, int(room / (planned * ratio * avg_bytes)))
        reason = (f"source frames alone ({_human_bytes(source_bytes)}) would crowd out a "
                  f"{_human_bytes(budget)} budget - decoding each chunk's window on demand instead")
        if extraction_mode == "windowed":
            reason = "extraction_mode=windowed - decoding each chunk's source window on demand"
        return finish("windowed", True, planned, segments, reason)

    # Full extraction, streamed encode: the source set stays resident, so
    # only what's left over bounds a segment.
    room = max(avg_bytes, budget - source_bytes)
    affordable = int(room / (avg_bytes * ratio))
    planned = max(2, min(chunk_frames or input_frame_count, max(2, affordable)))
    segments = max(1, int(room / (planned * ratio * avg_bytes)))
    reason = (f"{_human_bytes(source_bytes + interp_bytes)} of frames would exceed the "
              f"{_human_bytes(budget)} budget - encoding and freeing them in segments")
    if mode == "compact":
        reason = f"pipeline_mode=compact - bounding peak disk to a {_human_bytes(budget)} working set"
    return finish("full", True, planned, segments, reason)


def describe_plan(plan, input_frame_count, target_count):
    """The planner's decision as two printable lines - what it chose, and
    the numbers it chose from, so a surprising choice can be checked against
    real figures rather than guessed at."""
    pipeline = ("windowed extraction" if plan.extraction == "windowed" else "full extraction")
    pipeline += (f", streamed encode ({plan.segment_chunks} chunk(s)/segment, {plan.chunk_count} chunk(s))"
                 if plan.stream else ", single whole-clip encode")
    return [
        f"Pipeline: {pipeline}",
        f"  {plan.reason}",
        f"  {input_frame_count} source -> {target_count} output frames at ~{_human_bytes(plan.avg_bytes)}/frame; "
        f"peak temp ~{_human_bytes(plan.peak_bytes)} of {_human_bytes(plan.free_bytes)} free",
    ]


def _link_or_copy(source, destination):
    try:
        os.link(source, destination)
    except OSError:
        shutil.copy2(source, destination)

def _write_json_atomic(path, payload):
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(payload, indent=2, sort_keys=True))
    temp.replace(path)

def suppress_scene_cut_interpolation_range(in_frames, out_frames, input_count, target_count, cuts,
                                            range_start=0, range_end=None, index_offset=0, source_offset=0):
    """Replace output samples strictly between each cut's real endpoints,
    restricted to the global output-index window [range_start, range_end).

    `out_frames` is written using LOCAL 1-based filenames, offset from the
    global zero-based output index by `index_offset` (pass range_start for
    a chunk directory that only holds that chunk's own frames). The default
    arguments (range_end=None -> target_count, index_offset=0) cover the
    whole clip in one call, identical to this function's prior whole-clip-
    only behavior - see _render_rife_chunks for the per-chunk caller, which
    narrows the window instead so each chunk can be encoded and freed
    without waiting for the rest of the clip.

    `source_offset` is the same idea for the *input* side: under windowed
    extraction (see WindowedFrameProvider) `in_frames` holds only one
    chunk's own source frames, also numbered from 1, so the global
    zero-based source index of a cut has to be rebased the same way."""
    if range_end is None:
        range_end = target_count
    if input_count < 2 or target_count < 2:
        return 0
    scale = (target_count - 1) / (input_count - 1)
    replaced = 0
    for cut in cuts:
        if not 0 < cut < input_count:
            continue
        first = math.floor((cut - 1) * scale) + 1
        last = math.ceil(cut * scale) - 1
        # `cut` is the zero-based index of the shot's first frame; frame
        # files are one-based, so the post-cut source is at `cut + 1`.
        source = Path(in_frames) / f"{cut + 1 - source_offset:08d}.png"
        if not source.exists():
            continue  # a cut belonging to a neighbouring chunk's own window
        for output_zero_index in range(max(first, range_start), min(last, range_end - 1) + 1):
            destination = Path(out_frames) / f"{output_zero_index - index_offset + 1:08d}.png"
            if destination.exists():
                shutil.copy2(source, destination)
                replaced += 1
    return replaced

def suppress_scene_cut_interpolation(in_frames, out_frames, input_count, target_count, cuts):
    """Whole-clip convenience wrapper - see suppress_scene_cut_interpolation_range."""
    return suppress_scene_cut_interpolation_range(in_frames, out_frames, input_count, target_count, cuts)

def _tiny_frame_stream(input_args, pre_vf, width, height):
    """ffmpeg command streaming `input_args` as raw width x height rgb24
    frames on stdout - the shared front end of detect_transitions and
    count_decoded_frames.

    `input_args` is either an extracted-PNG sequence or the source video
    itself; `pre_vf` is the run's own -vf chain, which has to be applied
    *before* the downscale when reading from the source so the frames
    detection sees are the same frames RIFE will (a filter chain that
    crops, pads, or changes the frame count must not diverge between the
    two).

    The explicit `format=rgb24` before the downscale is what makes those
    two inputs actually comparable, and it is not cosmetic. Left out,
    ffmpeg scales a video source in its native yuv420p - averaging
    already-subsampled chroma - while a PNG sequence is scaled in full RGB,
    and the two produce measurably different 32x18 frames. Detection then
    finds different gradual transitions for the same clip depending only on
    which input it happened to read (observed directly: identical hard cuts,
    but 2 transition intervals from PNGs against 4 from the source, on the
    same file). Converting first makes both paths scale identical RGB data,
    and is a no-op for the PNG input that is already rgb24."""
    scale = f"format=rgb24,scale={width}:{height}"
    return [FFMPEG_BIN, "-hide_banner", "-loglevel", "error", *input_args,
            "-vf", f"{pre_vf},{scale}" if pre_vf else scale,
            "-pix_fmt", "rgb24", "-f", "rawvideo", "-"]


def frames_input_args(in_frames, source_fps):
    """detect_transitions' default input: the already-extracted PNG sequence."""
    return ["-framerate", f"{float(source_fps):.12g}", "-i", str(Path(in_frames) / "%08d.png")]


def count_decoded_frames(input_args, pre_vf=None):
    """Exact post-filter frame count for `input_args`, by decoding it to
    tiny raw frames and counting them.

    Windowed extraction needs the source's real frame count before any
    frame has been extracted (it sizes the chunk ranges), and neither
    ffprobe's `nb_frames` (frequently absent, and wrong for anything
    remuxed) nor duration x fps (wrong for VFR, and off by a frame either
    way at the boundaries) is trustworthy enough to slice chunks on. This
    costs one decode pass at 2x2, which is the cheapest correct answer
    available. detect_transitions already returns the same count for free
    when scene detection is on, so this only runs when it's off."""
    proc = subprocess.Popen(_tiny_frame_stream(input_args, pre_vf, 2, 2),
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    count = 0
    while len(proc.stdout.read(12)) == 12:
        count += 1
    proc.stdout.close()
    if proc.wait() != 0:
        raise RuntimeError("could not count the source's frames")
    return count


def detect_transitions(in_frames, source_fps, cut_sensitivity=3.0, cut_floor=0.05,
                        revert_fraction=0.5, min_duration=0.25,
                        sensitivity=1.35, alignment=0.80, detect_gradual=True,
                        input_args=None, pre_vf=None):
    """Single-pass detection of hard cuts and gradual transitions.

    `input_args` overrides the default "read the extracted PNG sequence in
    `in_frames`" input with any other ffmpeg input (windowed extraction
    passes the source video itself, since there is no complete extracted
    sequence to read); `pre_vf` is then the run's own filter chain, applied
    before the downscale so both paths see the identical frame sequence.

    Tiny RGB frames (32x18, cheap enough to hold in memory for the whole
    clip) make this cheap, and colour - not just luma - matters: a cut
    between two shots that happen to share the same average brightness but
    differ in hue is invisible to a grayscale-only metric.

    Every frame-to-frame step gets a magnitude (how much changed) and an
    alignment (cosine similarity with the previous step's change vector).
    The two transition types share the same signal but differ in shape:

    - A hard cut is an isolated impulse: magnitude clears both ``cut_floor``
      (an absolute pixel-change amount - keeps near-silent clips from
      treating tiny noise as a cut) and ``cut_sensitivity`` times the
      clip's recent baseline, is unaligned with the motion before it (the
      incoming shot's content has no relationship to the outgoing shot's
      direction of change), and both neighbors are below ``revert_fraction``
      of the spike itself - far smaller, not just smaller. That last,
      *relative* part matters - comparing the neighbors only to the
      pre-spike baseline would also flag whip pans (which sustain elevated,
      poorly-aligned magnitude across several frames) and would miss a cut
      into a shot that itself opens with brisk motion (whose first real
      frame reads as "elevated" against the calmer outgoing shot).
      Comparing each neighbor to the spike's own size instead - not the
      baseline - tells "steep both ways" (a cut) apart from "ramps up,
      ramps down" (real camera motion) or "elevated throughout" (a busy new
      shot), even when every individual frame of a whip pan clears the
      baseline-relative bar on its own.
    - A gradual transition is the same signature sustained: elevated
      magnitude that stays aligned with itself frame after frame, which is
      what a monotonic fade/dissolve looks like (linear alpha blending
      produces a near-constant per-pixel change direction for its whole
      duration). ``min_duration`` only sizes the baseline lookback window
      (how far back to search for the clip's normal motion level before
      judging a run elevated) - it is not a minimum run length. Quick
      dissolves (a handful of frames) are common and are protected the
      same as long ones; the magnitude/alignment gates already reject
      one-off motion spikes.

    Returns ``(cuts, transitions, frame_count)``: ``cuts`` is a sorted list
    of zero-based indices of frames that begin a new shot; ``transitions``
    is a list of zero-based ``(start, end)`` frame ranges for sustained
    fades/dissolves; ``frame_count`` is how many frames this pass actually
    saw, which windowed extraction uses as the clip's authoritative source
    frame count (it has no extracted sequence to count instead).
    """
    width, height = 32, 18
    cmd = _tiny_frame_stream(input_args or frames_input_args(in_frames, source_fps), pre_vf, width, height)
    size = width * height * 3
    minimum = max(3, round(float(min_duration) * float(source_fps)))
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    previous_frame = previous_delta = None
    frame_count = 0
    magnitudes = []
    cosines = {}
    while True:
        frame = proc.stdout.read(size)
        if len(frame) != size:
            break
        frame_count += 1
        if previous_frame is not None:
            delta = [b - a for a, b in zip(previous_frame, frame)]
            magnitude = sum(abs(value) for value in delta) / (size * 255)
            magnitudes.append(magnitude)
            if previous_delta is not None:
                index = len(magnitudes) - 1
                left_energy = sum(value * value for value in previous_delta)
                right_energy = sum(value * value for value in delta)
                cosines[index] = (sum(a * b for a, b in zip(previous_delta, delta)) /
                                  math.sqrt(left_energy * right_energy) if left_energy and right_energy else 0.0)
            previous_delta = delta
        previous_frame = frame
    proc.stdout.close()
    if proc.wait() != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd)
    if frame_count < 3:
        return [], [], frame_count

    def baseline_at(index):
        history_end = max(1, index - minimum)
        history = magnitudes[max(0, history_end - max(24, minimum * 3)):history_end]
        return statistics.median(history) if history else magnitudes[index - 1]

    transitions = []
    if detect_gradual:
        candidates = []
        for index in range(1, len(magnitudes)):
            if index not in cosines:
                continue
            cosine = cosines[index]
            magnitude = magnitudes[index]
            baseline = baseline_at(index)
            active = magnitude >= max(0.003, baseline * float(sensitivity))
            candidates.append((index + 1, active and cosine >= float(alignment),
                               magnitude >= 0.003 and cosine >= float(alignment)))
        start = previous = None
        gaps = 0
        for frame_index, begins, continues in candidates + [(frame_count, False, False), (frame_count + 1, False, False)]:
            accepted = begins if start is None else continues
            if accepted:
                start = frame_index if start is None else start
                previous = frame_index
                gaps = 0
                continue
            if start is not None:
                gaps += 1
                if gaps <= 1:
                    continue
                transitions.append((max(0, start - 1), min(frame_count - 1, previous + 1)))
                start = previous = None
                gaps = 0

    protected = set()
    for start_frame, end_frame in transitions:
        protected.update(range(start_frame, end_frame + 1))

    cuts = []
    for index in range(len(magnitudes)):
        frame_index = index + 1  # zero-based index of the frame that just arrived
        if frame_index in protected:
            continue
        magnitude = magnitudes[index]
        baseline = baseline_at(index) if index >= 1 else magnitude
        if magnitude < max(float(cut_floor), baseline * float(cut_sensitivity)):
            continue
        if cosines.get(index, 0.0) >= float(alignment):
            continue  # coherent with recent motion direction - not a discontinuity
        previous_magnitude = magnitudes[index - 1] if index >= 1 else 0.0
        next_magnitude = magnitudes[index + 1] if index + 1 < len(magnitudes) else 0.0
        if (previous_magnitude >= magnitude * float(revert_fraction) or
                next_magnitude >= magnitude * float(revert_fraction)):
            continue  # part of a sustained burst (e.g. a whip pan), not a one-off cut
        cuts.append(frame_index)
    return sorted(set(cuts)), transitions, frame_count

def parse_transition_ranges(value, source_fps, input_count):
    ranges = []
    for item in str(value or "").split(","):
        if not item.strip():
            continue
        try:
            start, end = _jwkit_common.parse_time_range(item)
        except ValueError as exc:
            raise ValueError("transition_ranges must be comma-separated START-END ranges with START < END") from exc
        ranges.append((max(0, round(start * source_fps)), min(input_count - 1, round(end * source_fps))))
    return ranges

def _job_signature(source, output_file, options):
    source_path = Path(str(source)).expanduser()
    source_identity = str(source_path.resolve()) if source_path.exists() else str(source)
    if source_path.exists():
        stat_result = source_path.stat()
        source_identity += f":{stat_result.st_size}:{stat_result.st_mtime_ns}"
    raw = json.dumps([source_identity, str(Path(output_file).resolve()), options], sort_keys=True)
    return hashlib.sha256(raw.encode()).hexdigest()[:16]

def _work_dir_for(output_file, signature, config=None):
    """Return a stable, local-only work path for a resumable job.

    Work used to live beside the output. That made hundreds of gigabytes of
    short-lived PNGs visible to folder-sync tools whenever the output folder
    was synced. The system temp area is machine-local by definition while a
    signature still makes the path stable enough for crash resume.
    """
    configured = str((config or {}).get("work_dir", "auto")).strip()
    if not configured or configured.lower() == "auto":
        root = Path(tempfile.gettempdir()) / "jwkit" / "ffrife"
    else:
        root = Path(configured).expanduser()
    return root / signature

def _chunk_ranges(frame_count, chunk_frames):
    if chunk_frames == 1:
        raise ValueError("chunk_frames must be 0 (disabled) or at least 2")
    if frame_count < 2 or chunk_frames <= 0 or frame_count <= chunk_frames:
        return [(0, frame_count)]
    ranges = []
    start = 0
    while start < frame_count - 1:
        end = min(frame_count, start + chunk_frames)
        ranges.append((start, end))
        if end == frame_count:
            break
        start = end - 1  # overlap one endpoint so RIFE sees the seam
    return ranges

def _resolve_scene_cuts(in_frames, source_fps, input_frame_count, config, input_args=None, pre_vf=None):
    """Returns (cuts, transition_count, frame_count): cuts is a sorted,
    deduped list of global zero-based hard-cut frame indices (explicit
    --transition-ranges plus anything scene_detection found), or None if
    scene_detection is off. Split out of render_rife_frames because the
    streaming-encode branch below needs this resolved *before* RIFE runs (so
    each chunk can suppress its own cut-adjacent frames as it's generated),
    while the plain branch keeps doing it after, exactly as before - see
    _render_rife_chunks' ``encode`` parameter.

    `input_args`/`pre_vf` let windowed extraction run the same detection
    straight off the source video, since it deliberately never has the whole
    extracted PNG sequence on disk to read - see detect_transitions.
    `frame_count` is what that pass actually saw (None when detection is
    off), which windowed extraction needs as the clip's real source frame
    count."""
    if not (config_bool(config, "scene_detection", True) and input_frame_count > 1):
        return None, 0, None
    scene_threshold = config_float(config, "scene_threshold", 3.0)
    if scene_threshold <= 0:
        raise ValueError("scene_threshold must be greater than 0")
    explicit_transitions = parse_transition_ranges(config.get("transition_ranges", ""), source_fps, input_frame_count)
    print(f"Detecting scene cuts and transitions (sensitivity={scene_threshold:g})...")
    cuts, transitions, frame_count = detect_transitions(
        in_frames, source_fps,
        cut_sensitivity=scene_threshold,
        cut_floor=config_float(config, "scene_floor", 0.05),
        revert_fraction=config_float(config, "scene_revert_fraction", 0.5),
        min_duration=config_float(config, "transition_min_duration", 0.25),
        sensitivity=config_float(config, "transition_sensitivity", 1.35),
        alignment=config_float(config, "transition_alignment", 0.80),
        detect_gradual=config_bool(config, "gradual_transition_detection", True),
        input_args=input_args, pre_vf=pre_vf,
    )
    transitions = list(explicit_transitions) + transitions
    for start_frame, end_frame in transitions:
        cuts.extend(range(start_frame + 1, end_frame + 1))
    return sorted(set(cuts)), len(transitions), frame_count

# Floor for the decode-check timeout, plus the deliberately pessimistic
# decode rate the rest of it is scaled from. A timeout here is read as
# "corrupt", so it must never be reachable by a file merely being large:
# 1MB/s is far below what any of these codecs actually decode at, which
# makes the budget generous rather than tight.
VALIDATE_TIMEOUT_FLOOR = 120
VALIDATE_BYTES_PER_SECOND = 1e6

def _validate_media_file(path):
    """Cheap corruption/truncation check: does `path` decode cleanly start
    to finish? Used only to decide whether a segment file left over from an
    interrupted streaming-encode run (see _render_rife_chunks) is safe to
    trust as-is, rather than as the primary crash-safety mechanism - state.json
    is only ever updated (via _write_json_atomic's atomic rename) *after*
    ffmpeg has already returned success for a segment, so this is belt-and-
    suspenders against filesystem-level corruption, not the thing that makes
    resume correct.

    The timeout scales with the file, because a fixed one is actively
    harmful here: a timeout is indistinguishable from corruption to the
    caller, so a large-but-perfectly-good segment (or a whole-clip
    video.mkv from a long run, which is the single most expensive thing
    resume can reuse) would be discarded and its RIFE work redone purely
    for taking a while to decode - and long runs are exactly the ones
    that produce big files and most need resume to work."""
    path = Path(path)
    if not path.exists() or path.stat().st_size == 0:
        return False
    timeout = max(VALIDATE_TIMEOUT_FLOOR, path.stat().st_size / VALIDATE_BYTES_PER_SECOND)
    try:
        subprocess.run([FFMPEG_BIN, "-v", "error", "-i", str(path), "-f", "null", "-"],
                       capture_output=True, check=True, timeout=timeout)
        return True
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError):
        return False

def _concat_video_segments(segment_paths, output_path):
    """Losslessly join already-encoded video segments (see the ``encode``
    streaming mode of _render_rife_chunks) into one file - a stream copy via
    ffmpeg's concat demuxer, not a re-encode. A single segment (the common
    case: nothing ever interrupted this run) just gets moved into place."""
    segment_paths = [Path(p) for p in segment_paths]
    if len(segment_paths) == 1:
        shutil.move(str(segment_paths[0]), str(output_path))
        return
    list_path = Path(tempfile.mktemp(suffix=".txt"))
    try:
        lines = "\n".join(f"file '{p.resolve().as_posix().replace(chr(39), chr(39) + chr(92) + chr(39) + chr(39))}'"
                          for p in segment_paths)
        list_path.write_text(lines + "\n")
        run_ffmpeg(["-f", "concat", "-safe", "0", "-i", str(list_path), "-c", "copy", str(output_path)],
                   label="Joining segments")
    finally:
        list_path.unlink(missing_ok=True)
    for p in segment_paths:
        p.unlink(missing_ok=True)

class WindowedExtractionError(RuntimeError):
    """On-demand chunk extraction produced something that can't be trusted
    to line up with the rest of the clip - see WindowedFrameProvider. Never
    fatal on its own: render_rife_frames catches it and redoes the run with
    ordinary upfront extraction, because a silently misaligned chunk would
    be a quality bug nobody notices, while a slower run is merely slower."""


class FullFrameProvider:
    """Every source frame was extracted upfront; a chunk's input is just
    hardlinks into that one directory. This is what ffrife has always done,
    and it stays the default whenever the whole source frame set comfortably
    fits the disk budget (see plan_pipeline) - one clean sequential decode
    is the fastest way to get frames on disk."""

    windowed = False

    def __init__(self, in_frames, count=None):
        self.in_frames = Path(in_frames)
        self._frames = sorted(self.in_frames.glob("*.png"))
        self.count = len(self._frames) if count is None else count

    def materialize(self, start, end, chunk_in):
        """Populate `chunk_in` with source frames [start, end), and return
        the (directory, global-index offset) that cut suppression should
        read this chunk's own source frames from."""
        for local_index, source_frame in enumerate(self._frames[start:end], 1):
            _link_or_copy(source_frame, Path(chunk_in) / f"{local_index:08d}.png")
        return self.in_frames, 0


class WindowedFrameProvider:
    """Decodes each chunk's own source window on demand instead of
    extracting the whole clip upfront.

    This is the one thing that bounds the *source* side of peak disk. Even
    with streaming encode holding the interpolated side to one segment, a
    long or high-resolution clip's extracted source PNGs are a hard floor
    that has to be paid in full before RIFE starts - tens of GB on a
    feature-length 1080p input - and the existing disk check can't help,
    because it only runs once extraction has already completed and treats
    those frames as a sunk cost. Windowed extraction turns that floor into
    one chunk's worth.

    Correctness rests on ffmpeg's accurate input-side seek (`-ss` before
    `-i`, which decodes from the preceding keyframe and discards up to the
    seek point) landing on exactly the frame asked for. Three things make
    that hold:

    * The seek time is aimed half a frame *before* the wanted frame, so
      ordinary rounding can't tip it to the next one.
    * ``-fps_mode passthrough``. Without it ffmpeg conforms the output to a
      CFR grid starting at the seek time, and since a seek lands between
      two frame timestamps it emits a *duplicate* of the first frame to fill
      the gap - which shifts every later frame in the chunk by one. Measured,
      not theorised: on a plain CFR 30fps h264 clip, every chunk after the
      first was wrong by exactly that one duplicated frame, and every chunk
      became byte-exact with passthrough on.
    * Every chunk is then verified anyway: it must produce exactly the
      frames requested, and - because _chunk_ranges deliberately overlaps
      one source frame between neighbours - its first frame must be
      byte-identical to the previous chunk's last. A VFR source, a bad fps
      probe, or an ffmpeg quirk none of the above anticipated fails that
      check and falls back to upfront extraction, rather than silently
      shifting a chunk by a frame."""

    windowed = True

    def __init__(self, source, count, source_fps, window_start=0.0, vf=None):
        self.source = source
        self.count = int(count)
        self.source_fps = float(source_fps)
        self.window_start = float(window_start or 0.0)
        self.vf = vf
        self._seam_digest = None

    def materialize(self, start, end, chunk_in):
        chunk_in = Path(chunk_in)
        # Half a frame early: accurate seek keeps frames at or after the
        # seek time, so aiming at (start - 0.5)/fps lands on `start` itself
        # for any rounding within half a frame either way.
        seek = self.window_start + max(0.0, start - 0.5) / self.source_fps
        cmd = ["-ss", f"{seek:.6f}", "-i", str(self.source)]
        if self.vf:
            cmd += ["-vf", self.vf]
        cmd += passthrough_fps_args() + ["-frames:v", str(end - start), f"{chunk_in}/%08d.png"]
        run_ffmpeg(cmd, label=f"Extracting source frames {start + 1}-{end}")
        frames = sorted(chunk_in.glob("*.png"))
        if len(frames) != end - start:
            raise WindowedExtractionError(
                f"on-demand extraction of source frames {start + 1}-{end} produced "
                f"{len(frames)} frame(s), not {end - start}")
        if self._seam_digest is not None and _file_digest(frames[0]) != self._seam_digest:
            raise WindowedExtractionError(
                f"on-demand extraction of source frames {start + 1}-{end} did not resume "
                f"from the previous chunk's last frame - the source's timing can't be seeked reliably")
        self._seam_digest = _file_digest(frames[-1])
        return chunk_in, start


def _file_digest(path):
    return hashlib.md5(Path(path).read_bytes()).hexdigest()


def _render_rife_chunks(rife_path, in_frames, out_frames, target_count, model_path, config, state_path,
                         cuts=None, input_count=None, encode=None):
    """Run RIFE over `in_frames` in resumable chunks (see docs/ffrife.md).

    With ``encode=None`` (the default, used by every caller except
    interpolate()'s own RIFE branch below): unchanged prior behavior -
    every chunk's interpolated PNGs are kept under `state_path`'s "chunks"
    directory until every chunk is done, then hardlinked into a single flat
    `out_frames` sequence for the caller's own single final encode. This is
    what render_rife_frames' public frames-directory contract (used
    directly by slverse's encode_rife_frame_sections, which concatenates
    multiple sections before one shared encode) depends on, so it can't
    change here.

    With ``encode`` given - a dict of {"segment_chunks", "fps", "output_vf",
    "encode_args"} - "Streaming encode" mode instead: `cuts` (from
    _resolve_scene_cuts) and `input_count` let each chunk suppress its own
    cut-adjacent frames as soon as RIFE produces it (suppress_scene_cut_
    interpolation_range, scoped to that chunk's own output window - the
    whole-clip pass can no longer wait for every chunk to exist at once).
    Every `encode["segment_chunks"]` completed chunks are hardlinked into a
    flat temp directory and encoded directly to their own small AV1 segment
    via a plain ffmpeg call (same shape as the non-streaming path's own
    final encode, just scoped to a batch of chunks) - only THEN are those
    chunks marked complete in `state_path` and their PNGs freed, bounding
    peak disk to about one segment's worth of interpolated frames instead
    of the whole clip. A segment is trusted only once ffmpeg has actually
    returned success for it (`state_path` is written afterward, via the
    same atomic-rename `_write_json_atomic` already uses elsewhere), so an
    interruption can only cost the batch that was still in progress, not
    the whole run - see docs/ffrife.md's "Streaming encode" section.
    `out_frames`/`target_count`'s frame-file contract is unused in this
    mode; the return value is the finalized segment video paths instead.

    `in_frames` is either a directory of already-extracted source frames
    (wrapped in a FullFrameProvider, the historical shape) or a provider
    that materializes one chunk's frames at a time - see
    WindowedFrameProvider, which never needs the whole source set on disk."""
    provider = in_frames if hasattr(in_frames, "materialize") else FullFrameProvider(in_frames)
    ranges = _chunk_ranges(provider.count, config_int(config, "chunk_frames", 0))
    state = {}
    if state_path.exists():
        try:
            state = json.loads(state_path.read_text())
        except (OSError, ValueError):
            state = {}
    completed = set(state.get("completed_chunks", []))
    total_intervals = max(1, provider.count - 1)
    target_intervals = max(0, target_count - 1)

    if encode is None:
        chunks_root = state_path.parent / "chunks"
        chunks_root.mkdir(parents=True, exist_ok=True)
        for index, (start, end) in enumerate(ranges):
            chunk_key = str(index)
            chunk_out = chunks_root / f"{index:06d}" / "out"
            marker = chunk_out.parent / "complete.json"
            if chunk_key in completed and marker.exists():
                try:
                    expected = int(json.loads(marker.read_text())["target_count"])
                except (OSError, ValueError, KeyError, TypeError):
                    expected = -1
                if len(list(chunk_out.glob("*.png"))) == expected:
                    print(f"Resuming: chunk {index + 1}/{len(ranges)} already complete.")
                    continue
                print(f"Resume data for chunk {index + 1} is incomplete; rebuilding it.")
            chunk_in = chunks_root / f"{index:06d}" / "in"
            shutil.rmtree(chunk_in, ignore_errors=True)
            shutil.rmtree(chunk_out, ignore_errors=True)
            chunk_in.mkdir(parents=True); chunk_out.mkdir(parents=True)
            provider.materialize(start, end, chunk_in)
            first_interval = round(start * target_intervals / total_intervals)
            last_interval = round((end - 1) * target_intervals / total_intervals)
            chunk_target = max(2, last_interval - first_interval + 1)
            print(f"RIFE chunk {index + 1}/{len(ranges)} ({end - start} source frames)...")
            run_rife_chunk(rife_path, chunk_in, chunk_out, chunk_target, model_path,
                           config.get("rife_threads"), config.get("rife_gpu"),
                           label=f"RIFE chunk {index + 1}/{len(ranges)}")
            _write_json_atomic(marker, {"target_count": chunk_target})
            completed.add(chunk_key)
            _write_json_atomic(state_path, {"completed_chunks": sorted(completed, key=int)})
            shutil.rmtree(chunk_in, ignore_errors=True)
            cooldown = config_float(config, "cooldown_seconds", 0)
            if cooldown and index + 1 < len(ranges):
                print(f"Cooling down for {cooldown}s before the next chunk (Ctrl-C is safe; resume later)...")
                time.sleep(cooldown)
        shutil.rmtree(out_frames, ignore_errors=True)
        Path(out_frames).mkdir(parents=True)
        output_index = 1
        for index in range(len(ranges)):
            frames = sorted((chunks_root / f"{index:06d}" / "out").glob("*.png"))
            if index:
                frames = frames[1:]  # overlapped endpoint was emitted by prior chunk
            for frame in frames:
                _link_or_copy(frame, Path(out_frames) / f"{output_index:08d}.png")
                output_index += 1
        if output_index - 1 != target_count:
            raise RuntimeError(f"chunk assembly produced {output_index - 1} frames; expected {target_count}")
        return None

    # --- Streaming encode mode ---
    chunks_root = state_path.parent / "chunks"
    chunks_root.mkdir(parents=True, exist_ok=True)
    segments_dir = state_path.parent / "segments"
    segments_dir.mkdir(parents=True, exist_ok=True)
    segments = state.get("segments", [])
    # Never trust a trailing segment state.json doesn't already have a
    # successful ffmpeg return code for (see the docstring above) - discard
    # it and let its chunks rebuild below like any other incomplete chunk.
    while segments:
        last = segments[-1]
        if _validate_media_file(segments_dir / last["file"]):
            break
        print(f"Resume data for segment {last['file']} is incomplete; discarding it.")
        (segments_dir / last["file"]).unlink(missing_ok=True)
        completed -= set(last["chunks"])
        segments = segments[:-1]
    _write_json_atomic(state_path, {"completed_chunks": sorted(completed, key=int), "segments": segments})

    segment_chunks = max(1, int(encode["segment_chunks"]))
    replaced_total = 0
    pending_batch = []

    def _finalize_segment():
        if not pending_batch:
            return
        segment_index = len(segments)
        segment_file = f"segment-{segment_index:04d}.mkv"
        flat = segments_dir / f"flat-{segment_index:04d}"
        shutil.rmtree(flat, ignore_errors=True)
        flat.mkdir(parents=True)
        output_index = 1
        for chunk_index in pending_batch:
            frames = sorted((chunks_root / f"{chunk_index:06d}" / "out").glob("*.png"))
            if chunk_index:
                frames = frames[1:]  # overlapped endpoint was emitted by the prior chunk
            for frame in frames:
                _link_or_copy(frame, flat / f"{output_index:08d}.png")
                output_index += 1
        cmd = ["-r", str(encode["fps"]), "-i", f"{flat}/%08d.png"]
        if encode.get("output_vf"):
            cmd += ["-vf", encode["output_vf"]]
        cmd += encode["encode_args"] + [str(segments_dir / segment_file)]
        run_ffmpeg(cmd, label=f"Encoding segment {segment_index + 1}")
        # Stored as strings, matching completed_chunks - a JSON round trip
        # through state_path turns a plain list of ints back into ints, and
        # the discard loop above (completed -= set(last["chunks"])) would
        # silently match nothing against completed's own string keys.
        segments.append({"file": segment_file, "chunks": [str(c) for c in pending_batch]})
        completed.update(str(c) for c in pending_batch)
        _write_json_atomic(state_path, {"completed_chunks": sorted(completed, key=int), "segments": segments})
        for chunk_index in pending_batch:
            shutil.rmtree(chunks_root / f"{chunk_index:06d}", ignore_errors=True)
        shutil.rmtree(flat, ignore_errors=True)
        pending_batch.clear()

    for index, (start, end) in enumerate(ranges):
        chunk_key = str(index)
        if chunk_key in completed:
            continue  # only ever set once that chunk's segment was finalized - see above
        chunk_out = chunks_root / f"{index:06d}" / "out"
        chunk_in = chunks_root / f"{index:06d}" / "in"
        shutil.rmtree(chunk_in, ignore_errors=True)
        shutil.rmtree(chunk_out, ignore_errors=True)
        chunk_in.mkdir(parents=True); chunk_out.mkdir(parents=True)
        cut_source, cut_source_offset = provider.materialize(start, end, chunk_in)
        first_interval = round(start * target_intervals / total_intervals)
        last_interval = round((end - 1) * target_intervals / total_intervals)
        chunk_target = max(2, last_interval - first_interval + 1)
        print(f"RIFE chunk {index + 1}/{len(ranges)} ({end - start} source frames)...")
        run_rife_chunk(rife_path, chunk_in, chunk_out, chunk_target, model_path,
                       config.get("rife_threads"), config.get("rife_gpu"),
                       label=f"RIFE chunk {index + 1}/{len(ranges)}")
        if cuts:
            # Before chunk_in goes away, not after: under windowed
            # extraction those frames ARE the only copy of this chunk's
            # source, and cut suppression reads them to replace RIFE's
            # hybrids with real held frames.
            replaced_total += suppress_scene_cut_interpolation_range(
                cut_source, chunk_out, input_count, target_count, cuts,
                range_start=first_interval, range_end=last_interval + 1, index_offset=first_interval,
                source_offset=cut_source_offset,
            )
        shutil.rmtree(chunk_in, ignore_errors=True)
        pending_batch.append(index)
        if len(pending_batch) >= segment_chunks or index + 1 == len(ranges):
            _finalize_segment()
        cooldown = config_float(config, "cooldown_seconds", 0)
        if cooldown and index + 1 < len(ranges):
            print(f"Cooling down for {cooldown}s before the next chunk (Ctrl-C is safe; resume later)...")
            time.sleep(cooldown)

    if len(completed) != len(ranges):
        raise RuntimeError(f"chunk assembly produced {len(completed)} completed chunks; expected {len(ranges)}")
    if replaced_total or cuts:
        print(f"Transitions: {replaced_total} interpolated frame(s) replaced across cut/transition boundaries.")
    return [segments_dir / seg["file"] for seg in segments]

def _extract_all_source_frames(source, in_frames, extract_marker, trim_args, vf, duration):
    """Decode the whole source window to PNGs in one sequential pass, reusing
    a complete extraction left behind by an interrupted run. Returns the
    frame count actually on disk."""
    extracted_count = len(list(in_frames.glob("*.png")))
    expected_extracted_count = None
    if extract_marker.exists():
        try:
            expected_extracted_count = int(json.loads(extract_marker.read_text())["frame_count"])
        except (OSError, ValueError, KeyError, TypeError):
            expected_extracted_count = None
    if expected_extracted_count and extracted_count == expected_extracted_count:
        print(f"Resuming: {extracted_count} extracted source frames already complete.")
        return extracted_count
    if extract_marker.exists() or extracted_count:
        print("Extracted-frame resume data is incomplete; rebuilding it.")
    shutil.rmtree(in_frames, ignore_errors=True)
    in_frames.mkdir(parents=True)
    extract_cmd = trim_args + ["-i", str(source)]
    if vf:
        extract_cmd += ["-vf", vf]
    extract_cmd += [f"{in_frames}/%08d.png"]
    run_ffmpeg(extract_cmd, duration=duration, label="Extracting")
    count = len(list(in_frames.glob("*.png")))
    _write_json_atomic(extract_marker, {"frame_count": count})
    return count


def _estimate_source_frame_count(source, source_fps, start, end):
    """Roughly how many frames the requested window holds, for planning only.

    The planner needs a frame count *before* anything is extracted - that's
    the whole point, since one of the things it decides is whether
    extracting everything is affordable at all. Duration x fps is good to a
    frame or two, which is far below the resolution of a disk-budget
    decision; the exact count always comes from the extraction (or the
    detection pass, under windowed extraction) afterwards, and every real
    chunk boundary is computed from that."""
    window = (end - start) if (start is not None and end is not None) else None
    if window is None:
        duration = probe_source_duration(source)
        window = max(0.0, duration - float(start or 0.0)) if duration else None
    if not window or not source_fps:
        return None
    return max(1, round(window * float(source_fps)))


def render_rife_frames(source, frames_root, config, start=None, end=None, vf=None, fps=60, speed=None, source_fps=None,
                        output_vf=None, stream_encode=False):
    """Decode a source window, synthesize its final retimed RIFE frame
    sequence, and return ``(out_frames, resolved_fps, duration)``.

    The caller owns ``frames_root`` and the final encode. This lets sectioned
    editors concatenate multiple lossless RIFE sequences and encode only once.
    Returns ``None`` when RIFE is unavailable; callers can then apply their
    configured ffmpeg fallback without creating an intermediate video.

    ``stream_encode=True`` (used only by interpolate()'s own RIFE branch,
    never by the sectioned/library callers above) does not force the
    streaming pipeline - it says this caller can *accept* one, i.e. that a
    finished video-only .mkv is an acceptable return value in place of a
    directory of PNGs. Which pipeline actually runs is plan_pipeline's
    decision, made from this clip's own measured frame size against the free
    space on ``frames_root``'s filesystem: a clip whose whole frame set fits
    still gets the single whole-clip encode, because that is both faster and
    better-compressing than segmenting it for no reason. Callers that can
    only take PNGs leave this False and always get them. ``output_vf`` is
    only meaningful when a streaming pipeline is actually chosen, applied
    per-segment since there's no later separate merge step for video then.
    """
    if str(fps).strip().lower().endswith(("x", "%")):
        fps = resolve_target_fps(fps, probe_source_fps(source))
    else:
        fps = float(fps)
    rife_path = config.get("rife_binary_path")
    if not rife_path or not command_exists(rife_path):
        return None

    print()
    print(COLOR.header("Interpolating using rife-ncnn-vulkan..."))
    frames_root = Path(frames_root)
    in_frames = frames_root / "in"
    out_frames = frames_root / "out"
    # A durable resume directory already contains both of these.  Creating
    # them without exist_ok made the default resume path fail before it could
    # inspect either checkpoint.
    in_frames.mkdir(parents=True, exist_ok=True)
    out_frames.mkdir(parents=True, exist_ok=True)
    trim_args = source_window_args(start, end)
    duration = (end - start) if (start is not None and end is not None) else None
    extract_marker = frames_root / "extract-complete.json"
    source_input_args = trim_args + ["-i", str(source)]
    speed_factor = speed if speed and speed != 1 else 1.0

    # Library callers historically pass only the settings they own - keep
    # that API compatible. No chunk_frames means no chunking, which means
    # neither streaming nor windowed extraction is available anyway (both
    # need chunk boundaries to encode and free at): one run_rife() call and
    # one flat out_frames directory, as always.
    if "chunk_frames" not in config:
        input_frame_count = _extract_all_source_frames(source, in_frames, extract_marker, trim_args, vf, duration)
        if input_frame_count == 0:
            print("No frames extracted - nothing to interpolate.")
            return None
        source_fps = float(source_fps) if source_fps is not None else probe_source_fps(source)
        target_count = round(input_frame_count * fps / source_fps / speed_factor)
        model_path = Path(rife_path).parent / config.get("rife_model", DEFAULT_CONFIG["rife_model"])
        _check_disk_space(frames_root, in_frames, target_count, config)
        run_rife(rife_path, in_frames, out_frames, target_count=target_count, model_path=model_path)
        cuts, transition_count, _ = _resolve_scene_cuts(in_frames, source_fps, input_frame_count, config)
        if cuts is not None:
            replaced = suppress_scene_cut_interpolation(in_frames, out_frames, input_frame_count, target_count, cuts)
            print(f"Transitions: {transition_count} gradual interval(s), {len(cuts)} protected boundary/boundaries; "
                  f"{replaced} interpolated frame(s) replaced.")
        return out_frames, fps, retimed_duration(duration, speed)

    source_fps = float(source_fps) if source_fps is not None else probe_source_fps(source)
    model_path = Path(rife_path).parent / config.get("rife_model", DEFAULT_CONFIG["rife_model"])
    joined_video = frames_root / "video.mkv"
    if stream_encode and joined_video.exists() and _validate_media_file(joined_video):
        # A previous run got as far as losslessly joining every segment and
        # was interrupted during the cheap mux/remux that follows. Without
        # this check, resume would find the segment files already consumed
        # by that join, discard the whole segment list as unverifiable, and
        # redo every RIFE chunk - by far the most expensive thing in the
        # pipeline - to rebuild a file that is already sitting right here.
        print("Resuming: interpolated video already complete.")
        return joined_video, fps, retimed_duration(duration, speed)

    # --- Plan the pipeline before committing to an extraction strategy ---
    width, height = probe_source_resolution(source)
    extracted_count = len(list(in_frames.glob("*.png")))
    resuming_extraction = extract_marker.exists() and extracted_count > 0
    if resuming_extraction:
        # Already paid for upfront extraction on an earlier attempt; the
        # frames are real data, so measure them instead of probing.
        estimated_count, avg_bytes = extracted_count, _sample_avg_frame_bytes(in_frames)
    else:
        estimated_count = _estimate_source_frame_count(source, source_fps, start, end)
        avg_bytes = _probe_frame_bytes(source, vf=vf, start=start, end=end)
    if not estimated_count or not avg_bytes:
        # Nothing reliable to plan from (an unseekable stream, a failed
        # probe): fall back to what ffrife has always done rather than guess.
        estimated_count = estimated_count or 1
        avg_bytes = avg_bytes or 0
        config = dict(config, extraction_mode="full")

    estimated_target = round(estimated_count * fps / source_fps / speed_factor)
    pixel_scale = (width * height) / REFERENCE_PIXELS if width and height else 1.0
    fps_scale = (estimated_target / estimated_count) / REFERENCE_FPS_RATIO
    effective = resolve_rife_policy(config, estimated_count, workload_scale=pixel_scale * fps_scale)
    print(f"RIFE profile: {effective['resolved_rife_profile']} "
          f"(threads={effective['rife_threads']}, chunks={effective['chunk_frames']}, "
          f"cooldown={effective['cooldown_seconds']}s)")

    plan_config = dict(config)
    if not stream_encode or resuming_extraction:
        # Streaming is what makes windowed extraction viable (something has
        # to free each chunk's frames as it goes), and a caller that can
        # only take a PNG directory can't have either. A resumed run has
        # already extracted everything, so windowing it now would throw that
        # work away for nothing.
        plan_config["pipeline_mode"] = "fast" if not stream_encode else plan_config.get("pipeline_mode", "auto")
        plan_config["extraction_mode"] = "full"
    plan = plan_pipeline(plan_config, input_frame_count=estimated_count, target_count=estimated_target,
                         avg_bytes=avg_bytes or 1, free_bytes=shutil.disk_usage(frames_root).free,
                         chunk_frames=config_int(effective, "chunk_frames", 0))

    def _prepare(plan):
        """Get this run's source frames into whatever shape `plan` chose,
        and resolve the cuts each chunk will need, returning
        (provider, cuts, transition_count, input_frame_count)."""
        if plan.extraction == "windowed":
            cuts, transition_count, counted = _resolve_scene_cuts(
                in_frames, source_fps, estimated_count, config,
                input_args=source_input_args, pre_vf=vf)
            # Detection already decoded the whole clip, so it knows the real
            # frame count for free; only a run with detection turned off has
            # to pay for a separate counting pass.
            count = counted or count_decoded_frames(source_input_args, vf)
            provider = WindowedFrameProvider(source, count, source_fps, window_start=start or 0.0, vf=vf)
            return provider, cuts, transition_count, count
        count = _extract_all_source_frames(source, in_frames, extract_marker, trim_args, vf, duration)
        if count == 0:
            return None, None, 0, 0
        cuts, transition_count = None, 0
        if plan.stream:
            # Cuts must be known before any chunk runs, not after every
            # chunk exists, so each one can suppress its own cut-adjacent
            # frames as soon as it's generated - see _render_rife_chunks'
            # "Streaming encode" mode.
            cuts, transition_count, _ = _resolve_scene_cuts(in_frames, source_fps, count, config)
        return FullFrameProvider(in_frames, count), cuts, transition_count, count

    def _execute(plan):
        provider, cuts, transition_count, input_frame_count = _prepare(plan)
        if provider is None:
            print("No frames extracted - nothing to interpolate.")
            return None
        target_count = round(input_frame_count * fps / source_fps / speed_factor)
        # Re-plan against the real numbers now they're known, pinned to the
        # extraction strategy already committed to above. Under full
        # extraction the frames themselves are now on disk, so segment
        # sizing can use their real average size rather than the pre-
        # extraction probe's estimate of it.
        measured_bytes = (_sample_avg_frame_bytes(in_frames) if plan.extraction == "full" else None) or avg_bytes or 1
        final = plan_pipeline(dict(plan_config, extraction_mode=plan.extraction),
                              input_frame_count=input_frame_count, target_count=target_count,
                              avg_bytes=measured_bytes, free_bytes=shutil.disk_usage(frames_root).free,
                              chunk_frames=config_int(effective, "chunk_frames", 0))
        for line in describe_plan(final, input_frame_count, target_count):
            print(line)
        run_config = dict(effective, chunk_frames=str(final.chunk_frames))
        ranges = _chunk_ranges(input_frame_count, final.chunk_frames)
        # Source frames already extracted are a sunk cost against free
        # space; only what's still to be written needs checking for.
        pending_source = max(end - start for start, end in ranges) if final.extraction == "windowed" else 0
        resident_interp = round(target_count * (final.segment_chunks / len(ranges) if final.stream else 1.0))
        _check_disk_space(frames_root, in_frames, target_count, config,
                          peak_frames=pending_source + resident_interp, avg_bytes=measured_bytes)

        if not final.stream:
            _render_rife_chunks(rife_path, provider, out_frames, target_count, model_path, run_config,
                                frames_root / "rife-state.json")
            cuts, transition_count, _ = _resolve_scene_cuts(in_frames, source_fps, input_frame_count, config)
            if cuts is not None:
                replaced = suppress_scene_cut_interpolation(in_frames, out_frames, input_frame_count, target_count, cuts)
                print(f"Transitions: {transition_count} gradual interval(s), {len(cuts)} protected boundary/boundaries; "
                      f"{replaced} interpolated frame(s) replaced.")
            return out_frames, fps, retimed_duration(duration, speed)

        encode = {"segment_chunks": final.segment_chunks, "fps": fps,
                  "output_vf": output_vf, "encode_args": build_encode_args(config)}
        segments = _render_rife_chunks(rife_path, provider, out_frames, target_count, model_path, run_config,
                                       frames_root / "rife-state.json",
                                       cuts=cuts, input_count=input_frame_count, encode=encode)
        _concat_video_segments(segments, joined_video)
        return joined_video, fps, retimed_duration(duration, speed)

    try:
        return _execute(plan)
    except WindowedExtractionError as exc:
        # Correctness first: a chunk that can't be proved to line up with
        # its neighbours is not something to ship. Redo the run with
        # ordinary upfront extraction, which needs no seeking at all - it
        # costs the disk this plan was trying to save, and it costs the RIFE
        # work already done, but it cannot silently drop or duplicate a
        # frame at a chunk boundary.
        print(f"On-demand source extraction isn't reliable for this source ({exc}).")
        print("Falling back to extracting every source frame upfront.")
        shutil.rmtree(frames_root / "chunks", ignore_errors=True)
        shutil.rmtree(frames_root / "segments", ignore_errors=True)
        (frames_root / "rife-state.json").unlink(missing_ok=True)
        return _execute(plan._replace(extraction="full"))


def _finalize_primary_target(primary_target, output_file):
    """Deliver `primary_target` (always .mkv coming out of interpolate()'s
    RIFE branch - see its own comment) as `output_file`, in whatever
    container that actually is. A lossless -c copy remux for a different
    one (e.g. mp4, for players that don't support mkv - see docs/ffrife.md's
    "Streaming encode" section), a plain rename when they already match.
    carry_over_source_extras already does the equivalent conversion itself
    when there IS extra metadata to carry over; this covers the plainer
    case where interpolate() skips that pass entirely."""
    primary_target = Path(primary_target)
    output_file = Path(output_file)
    if primary_target.suffix.lower() == output_file.suffix.lower():
        shutil.move(str(primary_target), str(output_file))
        return
    subprocess.run([FFMPEG_BIN, "-hide_banner", "-loglevel", "warning", "-y",
                    "-i", str(primary_target), "-map", "0", "-c", "copy", str(output_file)],
                   check=True)
    primary_target.unlink(missing_ok=True)

def interpolate(source, output_file, config, start=None, end=None, vf=None, fps=60, speed=None, metadata_args=None, output_vf=None):
    """Interpolate `source` (local path or remote URL) to `fps`, optionally
    trimmed to [start, end] and with an extra ffmpeg -vf filter chain
    applied before RIFE. ``output_vf`` is instead applied after RIFE in the
    final encode, which is preferable for static text/overlays that the model
    should not reinterpret. Frame extraction is directly from the source
    (trim + filter baked in), so there's no intermediate lossy re-encode
    generation before RIFE ever sees the footage. The only lossy encode is
    the final merge. Falls back to a plain ffmpeg filter (or no
    interpolation at all) per config's rife_fallback_engine if RIFE isn't
    installed/configured.

    `speed` (e.g. 0.5 for half-speed slow-motion, 3 for 3x fast-forward)
    changes RIFE's requested output-frame count directly; audio uses atempo.
    The ffmpeg fallback uses setpts/atempo in its one encode. Neither path
    needs a separate retiming pass. Returns True on success.

    `fps` accepts a plain literal target (60) or a source-relative spec
    ('2x', '2.5x', '150%') - resolved once here against the source's real
    fps so both the RIFE branch and the ffmpeg-fallback branch below see an
    already-resolved plain number."""
    if str(fps).strip().lower().endswith(("x", "%")):
        fps = resolve_target_fps(fps, probe_source_fps(source))
    else:
        fps = float(fps)
    duration = (end - start) if (start is not None and end is not None) else None
    trim_args = source_window_args(start, end)
    speed_vf = f"setpts=PTS/{speed:.6g}" if speed and speed != 1 else None
    speed_af = atempo_chain(speed)

    # Carrying source extras (subtitles, chapters, attachments, extra audio
    # tracks, embedded cover art, global tags) onto the output is only for a
    # bare `ffrife run`/`batch` invocation, never for a caller that already
    # built its own metadata_args (slverse's own per-verse title/comment
    # tags, notably) - -map_metadata from the source would otherwise
    # overwrite exactly the tags that caller went to the trouble of setting,
    # and none of subtitles/chapters/fonts/cover-art make sense carried onto
    # a short slice cut from a much longer source anyway.
    carryover_eligible = metadata_args is None
    extras = None
    if carryover_eligible and any(config_bool(config, key, True) for key in EXTRAS_OVERRIDE_KEYS):
        try:
            extras = describe_source_extras(source)
        except Exception:
            # Probing is a pure nice-to-have layered on top of a working
            # pipeline - any failure to read it back (unusual ffprobe
            # output, an unreachable remote source, ...) just skips
            # carryover and proceeds exactly as ffrife has always behaved,
            # rather than risking the interpolation itself over a side
            # channel.
            extras = None
        if extras is not None and not has_any_extras(extras):
            extras = None

    rife_path = config.get("rife_binary_path")
    if not rife_path or not command_exists(rife_path):
        fallback = config.get("rife_fallback_engine", DEFAULT_CONFIG["rife_fallback_engine"])
        print()
        print("RIFE binary not found. (Run 'ffrife setup' to download and configure it.)")
        vf_chain = list(filter(None, [vf]))
        if fallback in ("framerate", "minterpolate"):
            print(f"Falling back to ffmpeg's {fallback} filter for {fps}fps - note this can make motion look")
            print("artificially smooth/slow-motion-ish (frame blending, not real interpolation).")
            print("Set rife_fallback_engine=none to just keep native fps with no artifact instead.")
            interp_filter = (f"minterpolate=fps={fps}:mi_mode=mci:mc_mode=aobmc:me_mode=bidir:vsbmc=1"
                              if fallback == "minterpolate" else f"framerate=fps={fps}")
            vf_chain.append(interp_filter)
        else:
            print("rife_fallback_engine=none: keeping native frame rate, no interpolation applied.")
        if speed_vf:
            vf_chain.append(speed_vf)
        if output_vf:
            vf_chain.append(output_vf)
        carryover_dir = Path(tempfile.mkdtemp(prefix="ffrife-extras-")) if extras else None
        try:
            primary_target = (carryover_dir / f"encoded{Path(output_file).suffix}") if carryover_dir else output_file
            cmd = trim_args + ["-i", str(source)]
            if vf_chain:
                cmd += ["-vf", ",".join(vf_chain)]
            if speed_af:
                cmd += ["-af", f"asetpts=PTS-STARTPTS,{speed_af}"]
            elif trim_args:
                cmd += ["-af", "asetpts=PTS-STARTPTS"]
            else:
                cmd += ["-c:a", "copy"]
            cmd += build_encode_args(config) + (metadata_args or []) + [str(primary_target)]
            run_ffmpeg(cmd, duration=retimed_duration(duration, speed))
            if carryover_dir:
                carry_over_source_extras(source, primary_target, output_file, config, extras, start=start, end=end, speed=speed)
        finally:
            if carryover_dir:
                shutil.rmtree(carryover_dir, ignore_errors=True)
        return True

    options = {"start": start, "end": end, "vf": vf, "fps": fps, "speed": speed,
               "model": config.get("rife_model"), "threads": config.get("rife_threads"),
               "gpu": config.get("rife_gpu"), "profile": config.get("rife_profile"),
               "chunk_frames": config.get("chunk_frames"), "long_run_frames": config.get("long_run_frames"),
               "batch": bool(config.get("_batch_mode")),
               "scene_detection": config.get("scene_detection"),
               "scene_threshold": config.get("scene_threshold"),
               "scene_floor": config.get("scene_floor"),
               "scene_revert_fraction": config.get("scene_revert_fraction"),
               "gradual_transition_detection": config.get("gradual_transition_detection"),
               "transition_min_duration": config.get("transition_min_duration"),
               "transition_sensitivity": config.get("transition_sensitivity"),
               "transition_alignment": config.get("transition_alignment"),
               "transition_ranges": config.get("transition_ranges")}
    signature = _job_signature(source, output_file, options)
    durable = config_bool(config, "resume", False)
    work_path = _work_dir_for(output_file, signature, config) if durable else Path(tempfile.mkdtemp(prefix="ffrife-"))
    work_path.mkdir(parents=True, exist_ok=True)
    try:
        temp_dir_path = work_path
        rendered = render_rife_frames(source, temp_dir_path, config, start=start, end=end, vf=vf, fps=fps, speed=speed,
                                      output_vf=output_vf, stream_encode=True)
        if not rendered:
            if not durable:
                shutil.rmtree(work_path, ignore_errors=True)
            return False
        video_path, fps, _ = rendered
        # render_rife_frames only actually streams when chunking is active
        # (see its own "chunk_frames not in config" early-return) - a
        # minimal library-style config falls back to the original flat
        # frames-directory contract even though stream_encode=True was
        # requested here, so this still has to be able to take that shape.
        frames_dir = video_path if Path(video_path).is_dir() else None

        # .mka (Matroska), not a bare .aac elementary stream - a plain .aac
        # file has no room for per-stream tags at all, silently dropping the
        # source audio track's own language/title (confirmed empirically:
        # copying into .mka keeps them, copying into .aac loses them), and
        # those ride back onto the final merge below for free since ffmpeg
        # copies a mapped stream's own tags along with it by default.
        exact_audio = bool(trim_args) or bool(speed_af)
        audio_path = temp_dir_path / ("audio.m4a" if exact_audio else "audio.mka")
        # Explicit -map (the first audio stream by index) rather than
        # ffmpeg's own default "best" stream auto-selection (highest
        # channel count) - deterministic, and what makes extra_audio_indices
        # above an accurate list of everything ELSE the source has, for
        # carry_over_source_extras to pick up separately.
        audio_cmd = [FFMPEG_BIN, "-y"] + trim_args + ["-i", str(source), "-map", "0:a:0?", "-map_chapters", "-1"]
        if exact_audio:
            audio_filters = ["asetpts=PTS-STARTPTS"]
            if duration is not None:
                audio_filters.insert(0, f"atrim=duration={duration:.12g}")
            if speed_af:
                audio_filters.append(speed_af)
            audio_cmd += ["-af", ",".join(audio_filters), "-c:a", "aac", "-b:a", "192k"]
        else:
            audio_cmd += ["-c:a", "copy"]
        audio_cmd += [str(audio_path)]
        subprocess.run(audio_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        # primary_target lives inside work_path (not a separate temp dir) so
        # a failure between here and the carryover pass below is cleaned up
        # (or kept for resume) by the existing work_path handling at the
        # bottom of this function, same as everything else RIFE produces.
        has_audio = audio_path.exists() and audio_path.stat().st_size > 0
        if frames_dir is not None:
            # Legacy non-chunked path: exactly the original single combined
            # encode (video from raw frames + audio + build_encode_args in
            # one pass) - there's no streaming-encode machinery to mux
            # against here, see the frames_dir comment above.
            primary_target = (temp_dir_path / f"encoded{Path(output_file).suffix}") if extras else output_file
            merge_cmd = ["-r", str(fps), "-i", f"{frames_dir}/%08d.png"]
            if has_audio:
                merge_cmd += ["-i", str(audio_path)]
            if output_vf:
                merge_cmd += ["-vf", output_vf]
            if has_audio:
                merge_cmd += ["-c:a", "copy"]
            merge_cmd += build_encode_args(config) + (metadata_args or []) + [str(primary_target)]
            run_ffmpeg(merge_cmd, duration=retimed_duration(duration, speed))
        else:
            # Always .mkv regardless of output_file's own container -
            # video_path is already a finished, fully-encoded .mkv (see
            # render_rife_frames' stream_encode mode, needed for truncation-
            # safe crash recovery mid-run), so this mux step is a plain
            # stream copy, not a re-encode. Delivering a non-mkv target (the
            # common case) is a second, equally lossless -c copy remux
            # below - see _finalize_primary_target and
            # carry_over_source_extras, both container-agnostic already.
            primary_target = temp_dir_path / "encoded.mkv"
            mux_cmd = ["-i", str(video_path)]
            if has_audio:
                mux_cmd += ["-i", str(audio_path), "-map", "0:v", "-map", "1:a"]
            mux_cmd += ["-c", "copy"] + (metadata_args or []) + [str(primary_target)]
            run_ffmpeg(mux_cmd, label="Muxing audio")
        if extras:
            carry_over_source_extras(source, primary_target, output_file, config, extras, start=start, end=end, speed=speed)
        elif frames_dir is None:
            _finalize_primary_target(primary_target, output_file)
    except BaseException:
        if durable:
            print(f"Work saved for resume: {work_path}")
        else:
            shutil.rmtree(work_path, ignore_errors=True)
        raise
    if not config_bool(config, "keep_work", False):
        shutil.rmtree(work_path, ignore_errors=True)
    return True

# --- CLI ---
def rife_supports_custom_frame_count(rife_path, model_path):
    """interpolate() always passes an explicit -n/-m now (see run_rife) -
    older bundled models (rife-v2.x/v3.x/HD/UHD/anime) reject that outright
    ("only rife-v4 model support custom numframe and timestep"), so an
    install/model predating that change would fail on every real run. Smoke
    -tests the actual configured binary+model with 2 throwaway synthetic
    frames, not any real footage."""
    try:
        with tempfile.TemporaryDirectory() as tmp_dir:
            in_frames, out_frames = Path(tmp_dir) / "in", Path(tmp_dir) / "out"
            in_frames.mkdir()
            out_frames.mkdir()
            for i, color in enumerate(("red", "blue"), start=1):
                subprocess.run(
                    [FFMPEG_BIN, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
                     "-i", f"color=c={color}:s=32x32", "-frames:v", "1", str(in_frames / f"{i:08d}.png")],
                    check=True, timeout=15,
                )
            result = subprocess.run(
                [rife_path, "-i", str(in_frames), "-o", str(out_frames), "-n", "3", "-m", str(model_path)],
                capture_output=True, text=True, timeout=30,
            )
            return result.returncode == 0 and len(list(out_frames.glob("*.png"))) == 3
    except Exception:
        return False

def cmd_setup(config):
    hw = config.get("hardware_encoder", "cpu")
    print(f"Video encoder: {hw}")
    ffmpeg_bin = resolve_ffmpeg_binary(config)
    if not ffmpeg_has_filter(ffmpeg_bin, "delogo") and not ffmpeg_has_filter(ffmpeg_bin, "drawtext"):
        print(f"Note: {ffmpeg_bin} may be missing some filters callers pass via --vf.")

    if config.get("rife_binary_path") and command_exists(config["rife_binary_path"]):
        model_path = Path(config["rife_binary_path"]).parent / config.get("rife_model", DEFAULT_CONFIG["rife_model"])
        if rife_supports_custom_frame_count(config["rife_binary_path"], model_path):
            print(f"RIFE already configured: {config['rife_binary_path']}")
            return
        print(f"RIFE is configured ({config['rife_binary_path']}), but this install can't hit an exact")
        print("target frame count (older releases only support a plain 2x doubling with the default")
        print("model) - ffrife now always requests an exact target, so every real run against this")
        print("install would fail.")
        ans = input("Download and install a fresh release now? [Y/n]: ").strip().lower()
        if ans in ("", "y", "yes"):
            old_dir = Path(config["rife_binary_path"]).resolve().parent
            if install_rife(config):
                new_dir = Path(config["rife_binary_path"]).resolve().parent
                if old_dir != new_dir and old_dir.parent == BIN_DIR and old_dir.exists():
                    shutil.rmtree(old_dir)
                    print(f"Removed old install directory: {old_dir}")
            else:
                print("Automatic install failed. Download it yourself from")
                print("https://github.com/nihui/rife-ncnn-vulkan/releases, unzip it, then run:")
                print("  ffrife config set rife_binary_path /path/to/rife-ncnn-vulkan")
        else:
            print("Skipping - ffrife run will keep failing against this install until you fix it.")
        return

    print(f"\nRIFE isn't installed yet ({rife_release_hint()}).")
    ans = input("Download and install it now? [Y/n]: ").strip().lower()
    if ans in ("", "y", "yes"):
        if not install_rife(config):
            print("Automatic install failed. Download it yourself from")
            print("https://github.com/nihui/rife-ncnn-vulkan/releases, unzip it, then run:")
            print("  ffrife config set rife_binary_path /path/to/rife-ncnn-vulkan")
    else:
        print("Skipping - run 'ffrife setup' again anytime.")

BENCHMARK_CRF_SWEEP = {"h264": ["18", "20", "23"], "hevc": ["20", "23", "26"], "av1": ["24", "27", "30"]}
BENCHMARK_CRF_QUICK = {"h264": "20", "hevc": "23", "av1": "30"}

def cmd_benchmark(args, config):
    """Times every video encoder this machine's ffmpeg build actually has
    against a sample clip, at a few crf values per codec (BENCHMARK_CRF_SWEEP
    - a real size/quality tradeoff view, not one guessed point), measuring
    size and SSIM - see _jwkit_common.run_encoder_benchmark. Same engine
    slverse's own 'benchmark' command uses; this one takes --sample
    directly since ffrife (unlike slverse) has no cache of its own content
    to pull a representative clip from automatically. --quick skips the
    sweep (one crf per codec) for a faster, coarser answer."""
    ffmpeg_bin = resolve_ffmpeg_binary(config)
    ffprobe_bin = resolve_ffprobe_binary(config)
    sample = getattr(args, "sample", None)
    crf_map = BENCHMARK_CRF_QUICK if getattr(args, "quick", False) else BENCHMARK_CRF_SWEEP
    with tempfile.TemporaryDirectory(prefix="ffrife-bench-") as tmp_dir:
        if not sample:
            sample = str(Path(tmp_dir) / "bench_sample.mp4")
            print("No --sample given - benchmarking against a synthetic test clip (pass --sample <file> to test against real content instead).")
            subprocess.run(
                [ffmpeg_bin, "-hide_banner", "-loglevel", "error", "-y", "-f", "lavfi",
                 "-i", "testsrc2=size=1280x720:rate=30:duration=8",
                 "-c:v", "libx264", "-crf", "12", "-preset", "fast", sample],
                check=True, timeout=60,
            )
        else:
            # A whole downloaded chapter (minutes long) as --sample would
            # multiply every one of the crf sweep's ~15 encodes by its own
            # full length instead of a few seconds - trim to a short
            # representative slice first, the same way slverse's own
            # find_or_generate_bench_sample does for its cached content.
            try:
                duration = float(subprocess.run(
                    [ffprobe_bin, "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", sample],
                    capture_output=True, text=True, timeout=15, check=True,
                ).stdout.strip())
            except Exception:
                duration = 0.0
            if duration > 12:
                trimmed = str(Path(tmp_dir) / "bench_sample.mp4")
                offset = max(0.0, (duration - 8) / 2)
                subprocess.run(
                    [ffmpeg_bin, "-hide_banner", "-loglevel", "error", "-y", "-ss", str(offset), "-t", "8", "-i", sample,
                     "-c:v", "libx264", "-crf", "12", "-preset", "fast", "-an", trimmed],
                    check=True, timeout=60,
                )
                print(f"--sample is {duration:.0f}s long - using an 8s slice from its middle instead of the whole thing.")
                sample = trimmed
        print(COLOR.header("Trying every encoder this machine's ffmpeg supports - this can take a minute or two:\n"))
        results = _jwkit_common.run_encoder_benchmark(ffmpeg_bin, sample, crf_map=crf_map, log=lambda m: print(f"  {m}"))

    print()
    print(_jwkit_common.format_benchmark_table(results))
    best = _jwkit_common.recommend_from_benchmark(results)
    if not best:
        print("\nNo encoder on this machine actually worked - keeping current settings.")
        return None
    print(f"\n{COLOR.bold(COLOR.green('Recommended:'))} hardware_encoder={best['hw']}, video_codec={best['codec']}, video_crf={best['crf']} (smallest file at SSIM >= 0.98, or highest SSIM available if none cleared that)")
    if getattr(args, "apply", False):
        config["hardware_encoder"], config["video_codec"] = best["hw"], best["codec"]
        # See slverse's own cmd_benchmark comment: "auto" instead of the
        # literal crf when it's just that codec's normal default, so
        # video_crf stays correctly adaptive if the codec ever changes.
        config["video_crf"] = "auto" if best["crf"] == _jwkit_common.AUTO_CRF_BY_CODEC.get(best["codec"]) else best["crf"]
        save_config(config)
        print("Applied and saved.")
    return best

def cmd_config(args, config):
    def parse_value(key, raw):
        if key == "cooldown_seconds":
            return _jwkit_common.parse_auto_time_seconds(raw)
        if key == "transition_min_duration":
            return f"{_jwkit_common.parse_time_seconds(raw):g}"
        if key == "transition_ranges":
            for item in str(raw).split(","):
                if item.strip():
                    _jwkit_common.parse_time_range(item)
            return str(raw)
        return _jwkit_common.parse_config_value(DEFAULT_CONFIG[key], raw)

    def check_extra(current):
        issues = []
        for key in ("rife_binary_path", "ffmpeg_binary", "ffprobe_binary"):
            value = str(current.get(key, "")).strip()
            if value and not (Path(value).is_file() or shutil.which(value)):
                issues.append(f"{key}: executable not found: {value}")
        return issues
    return _jwkit_common.run_config_command(
        tool="ffrife", args=args, config=config, defaults=DEFAULT_CONFIG,
        config_file=CONFIG_FILE, save_config=save_config,
        descriptions=CONFIG_HELP, parse_value=parse_value, check_extra=check_extra,
    )

