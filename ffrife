def config_bool(config, key, default=False):
    return str(config.get(key, str(default))).strip().lower() in {"1", "true", "yes", "on"}

def config_int(config, key, default=0, minimum=0):
    try:
        return max(minimum, int(float(config.get(key, default))))
    except (TypeError, ValueError):
        return max(minimum, default)

def config_float(config, key, default=0.0, minimum=0.0):
    try:
        return max(minimum, _jwkit_common.parse_time_seconds(config.get(key, default)))
    except (TypeError, ValueError):
        return max(minimum, default)

REFERENCE_PIXELS = 640 * 360  # resolution long_run_frames's default (3600) is calibrated against - see
                               # resolve_rife_policy's workload_scale and the benchmark table in docs/ffrife.md
REFERENCE_FPS_RATIO = 2.0     # target/source fps ratio implicit in that same calibration (--fps's own
                               # default of 60 over a typical ~30fps source) - see workload_scale below

def resolve_rife_policy(config, input_frame_count, workload_scale=1.0):
    """`workload_scale` rescales `input_frame_count` to REFERENCE_PIXELS-
    and REFERENCE_FPS_RATIO-equivalent frames before comparing against
    long_run_frames, so the auto threshold approximates expected wall-clock
    RIFE time rather than a raw source frame count. Two things drive actual
    RIFE cost independently of input_frame_count: source resolution (a
    short but high-resolution clip can take as long to process as a longer
    low-resolution one - see the benchmark table in docs/ffrife.md, whose
    two data points already sit at roughly the same pixels/second) and the
    ratio between requested output frames and input frames, i.e.
    target_count/input_frame_count (RIFE synthesizes target_count frames,
    not input_frame_count ones - a higher --fps target or a --speed
    slow-motion request that doubles the target count for the same input
    doubles the actual synthesis work without changing input_frame_count at
    all). Callers that can't cheaply determine either (or don't care, e.g.
    batch mode's already-forced-balanced placeholder call) can omit it and
    get the prior frame-count-only behavior.

    A non-default workload_scale also rescales a profile-selected (not
    explicitly overridden) chunk_frames by the same factor, floored at 2, so
    each chunk keeps doing roughly the amount of actual RIFE synthesis work
    the profile intended - otherwise a high-workload run would turn every
    chunk into a proportionally longer, harder-to-interrupt stretch than
    "balanced"/"cool" promise, without the chunk_frames number itself
    reflecting that."""
    requested = str(config.get("rife_profile", "auto")).lower()
    if requested not in {"auto", *RIFE_PROFILES}:
        raise ValueError("rife_profile must be auto, performance, balanced, or cool")
    profile = requested
    if profile == "auto":
        threshold = config_int(config, "long_run_frames", 3600, minimum=2)
        effective_frames = input_frame_count * workload_scale
        profile = "balanced" if config.get("_batch_mode") or effective_frames >= threshold else "performance"
    effective = dict(config)
    for key, profile_value in RIFE_PROFILES[profile].items():
        configured = str(config.get(key, "auto")).lower()
        if configured != "auto":
            effective[key] = config.get(key)  # explicit override always wins, unscaled
            continue
        if key == "chunk_frames" and profile_value != "0" and workload_scale > 0 and workload_scale != 1.0:
            # A profile's chunk_frames is a source-frame count tuned at
            # workload_scale==1 (reference resolution/fps-ratio); rescale it
            # by the same factor so each chunk keeps doing roughly the same
            # amount of actual RIFE synthesis work the profile intended,
            # regardless of this run's resolution/--fps/--speed - otherwise a
            # high-workload run turns every chunk into a much longer,
            # harder-to-interrupt stretch than "balanced"/"cool" promise.
            # workload_scale==0 (a near-zero target frame count, e.g. a tiny
            # clip at a very low --fps) is left unscaled rather than dividing
            # by zero - there's essentially no RIFE work to size chunks for.
            profile_value = str(max(2, round(int(profile_value) / workload_scale)))
        effective[key] = profile_value
    effective["resolved_rife_profile"] = profile
    return effective

# --- Config ---
def load_config():
    config = DEFAULT_CONFIG.copy()
    if not CONFIG_FILE.exists():
        return config
    try:
        with open(CONFIG_FILE, "r") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                config[k.strip()] = v.strip().strip("'").strip('"')
    except Exception as e:
        print(f"Warning: could not parse config: {e}")
    return config

def save_config(config):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        for k, v in config.items():
            f.write(f'{k} = "{v}"\n')

# --- System / binaries ---
def command_exists(cmd):
    return shutil.which(cmd) is not None

_PASSTHROUGH_FPS_ARGS = None

def passthrough_fps_args():
    """Args telling ffmpeg to emit exactly the frames it decoded, with no
    CFR conforming - `-fps_mode passthrough` on ffmpeg 5.1+, and the older
    `-vsync 0` spelling on anything that doesn't recognize it.

    Windowed extraction is wrong without this (see WindowedFrameProvider),
    so it's worth one cached probe rather than assuming either spelling."""
    global _PASSTHROUGH_FPS_ARGS
    if _PASSTHROUGH_FPS_ARGS is None:
        modern = ["-fps_mode", "passthrough"]
        try:
            probe = subprocess.run([FFMPEG_BIN, "-hide_banner", "-loglevel", "error",
                                    "-f", "lavfi", "-i", "nullsrc=s=16x16:d=0.1", *modern,
                                    "-frames:v", "1", "-f", "null", "-"],
                                   capture_output=True, timeout=30)
            _PASSTHROUGH_FPS_ARGS = modern if probe.returncode == 0 else ["-vsync", "0"]
        except (subprocess.SubprocessError, OSError):
            _PASSTHROUGH_FPS_ARGS = ["-vsync", "0"]
    return list(_PASSTHROUGH_FPS_ARGS)

def ffmpeg_has_filter(ffmpeg_bin, filter_name):
    try:
        result = subprocess.run([ffmpeg_bin, "-hide_banner", "-filters"], capture_output=True, text=True, timeout=10)
        return filter_name in result.stdout
    except Exception:
        return False

def resolve_ffmpeg_binary(config):
    override = config.get("ffmpeg_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffmpeg-full"),
        *[p for p in FFMPEG_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffmpeg"),
    ] if c]
    for c in candidates:
        if ffmpeg_has_filter(c, "drawtext"):
            return c
    return candidates[0] if candidates else "ffmpeg"

def resolve_ffprobe_binary(config):
    override = config.get("ffprobe_binary")
    if override and command_exists(override):
        return override
    candidates = [c for c in [
        shutil.which("ffprobe-full"),
        *[p for p in FFPROBE_FULL_KEG_PATHS if os.path.exists(p)],
        shutil.which("ffprobe"),
    ] if c]
    return candidates[0] if candidates else "ffprobe"

# --- Progress (mirrors jwsl's print_progress/print_time_progress/print_count_progress) ---
def _progress_bar(frac, width=30):
    filled = int(width * max(0.0, min(1.0, frac)))
    return COLOR.green("#" * filled) + "-" * (width - filled)

def print_progress(downloaded, total, width=30):
    if total:
        frac = downloaded / total
        sys.stdout.write(f"\r[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({downloaded/1e6:.1f}/{total/1e6:.1f} MB)")
    else:
        sys.stdout.write(f"\r{downloaded/1e6:.1f} MB downloaded")
    sys.stdout.flush()

def print_time_progress(current_s, total_s, label="", width=30, eta_seconds=None, done=False):
    frac = (current_s / total_s) if total_s else 0.0
    prefix = f"{label} " if label else ""
    suffix = COLOR.green(" ✓ Done") if done else (COLOR.dim(f", ETA {_jwkit_common.format_eta(eta_seconds)}") if eta_seconds is not None else "")
    sys.stdout.write(f"\r{prefix}[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({current_s:.1f}/{total_s:.1f}s{suffix})\033[K")
    sys.stdout.flush()

def print_count_progress(current, total, label="", width=30, eta_seconds=None, done=False):
    frac = (current / total) if total else 0.0
    prefix = f"{label} " if label else ""
    suffix = COLOR.green(" ✓ Done") if done else (COLOR.dim(f", ETA {_jwkit_common.format_eta(eta_seconds)}") if eta_seconds is not None else "")
    sys.stdout.write(f"\r{prefix}[{_progress_bar(frac, width)}] {frac*100:5.1f}% ({current}/{total} frames{suffix})\033[K")
    sys.stdout.flush()

def parse_hms(ts):
    parts = ts.split(":")
    h, m, s = (["0", "0"] + parts)[-3:]
    return int(h) * 3600 + int(m) * 60 + float(s)

def download_file(url, output_path, expected_checksum=None):
    tmp_path = Path(str(output_path) + ".part")
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            print(COLOR.header(f"Downloading {url}..."))
            req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=60) as resp, open(tmp_path, "wb") as f:
                total = int(resp.headers.get("Content-Length") or 0)
                downloaded = 0
                while True:
                    chunk = resp.read(262144)
                    if not chunk:
                        break
                    f.write(chunk)
                    downloaded += len(chunk)
                    print_progress(downloaded, total)
                print()
            os.replace(tmp_path, output_path)
            print("Download complete.")
            return True
        except Exception as e:
            tmp_path.unlink(missing_ok=True)
            print(f"Download attempt {attempt} failed: {e}")
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF ** attempt)
    return False

def fetch_json(url):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.loads(response.read().decode('utf-8'))
    except Exception as e:
        print(f"Error fetching {url}: {e}")
        return None

